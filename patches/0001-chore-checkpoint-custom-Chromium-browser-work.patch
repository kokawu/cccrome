+bool BrowserMouseGestureController::OnMouseEvent(ui::MouseEvent* event) {
+  if (!event || !browser_view_ || !browser_view_->browser() ||
+      !browser_view_->GetIsNormalType() || !IsEnabled()) {
+    return false;
+  }
+  if (IsCurrentDomainExcluded()) {
+    CancelGesture();
+    return false;
+  }
+
+  const gfx::Point event_location =
+      GetMouseEventLocationInRootView(*event, root_view_);
+  const auto event_type = event->type();
+  if (suppress_next_right_release_ &&
+      event_type == ui::EventType::kMouseReleased &&
+      (event->changed_button_flags() & ui::EF_RIGHT_MOUSE_BUTTON) != 0) {
+    suppress_next_right_release_ = false;
+    return true;
+  }
+
+  if (event_type == ui::EventType::kMousePressed) {
+    if ((event->changed_button_flags() & ui::EF_RIGHT_MOUSE_BUTTON) != 0 &&
+        (event->flags() & ui::EF_RIGHT_MOUSE_BUTTON) != 0) {
+      StartGesture(event_location);
+      return false;
+    }
+
+    if (gesture_in_progress_ &&
+        (event->flags() & ui::EF_RIGHT_MOUSE_BUTTON) != 0) {
+      if ((event->changed_button_flags() & ui::EF_LEFT_MOUSE_BUTTON) != 0) {
+        return HandleAuxiliaryTrigger("right_left_click");
+      }
+      if ((event->changed_button_flags() & ui::EF_MIDDLE_MOUSE_BUTTON) != 0) {
+        return HandleAuxiliaryTrigger("right_middle_click");
+      }
+    }
+  }
+
+  if (!gesture_in_progress_) {
+    return false;
+  }
+
+  switch (event_type) {
+    case ui::EventType::kMouseDragged:
+      UpdateGesture(event_location);
+      return gesture_crossed_threshold_;
+    case ui::EventType::kMousewheel:
+      return HandleWheelGesture(*event->AsMouseWheelEvent());
+    case ui::EventType::kMouseReleased:
+      if ((event->changed_button_flags() & ui::EF_RIGHT_MOUSE_BUTTON) != 0) {
+        return FinishGesture();
+      }
+      break;
+    default:
+      break;
+  }
+
+  return false;
+}
+
+void BrowserMouseGestureController::OnMouseCaptureLost() {
+  CancelGesture();
+  suppress_next_right_release_ = false;
+}
+
+void BrowserMouseGestureController::Paint(
+    gfx::Canvas* canvas,
+    const views::View* coordinate_space_view) const {
+  if (!canvas || !root_view_) {
+    return;
+  }
+
+  gfx::ScopedCanvas scoped_canvas(canvas);
+  const views::View* const paint_view =
+      coordinate_space_view ? coordinate_space_view : root_view_.get();
+  if (coordinate_space_view && coordinate_space_view != root_view_) {
+    gfx::Point origin;
+    views::View::ConvertPointToTarget(coordinate_space_view, root_view_,
+                                      &origin);
+    canvas->Translate(gfx::Vector2d(-origin.x(), -origin.y()));
+  }
+
+  const bool draw_trail =
+      gesture_in_progress_ && ShouldShowTrail() && trail_points_.size() > 1;
+  const bool draw_hint =
+      ShouldShowHint() &&
+      ((gesture_in_progress_ && gesture_crossed_threshold_) ||
+       !action_feedback_text_.empty());
+  if (!draw_trail && !draw_hint) {
+    return;
+  }
+
+  if (draw_trail) {
+    SkPathBuilder path;
+    path.moveTo(trail_points_.front().x(), trail_points_.front().y());
+    for (size_t i = 1; i < trail_points_.size(); ++i) {
+      path.lineTo(trail_points_[i].x(), trail_points_[i].y());
+    }
+
+    cc::PaintFlags trail_flags;
+    trail_flags.setAntiAlias(true);
+    trail_flags.setStyle(cc::PaintFlags::kStroke_Style);
+    trail_flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+    trail_flags.setStrokeJoin(cc::PaintFlags::kRound_Join);
+    trail_flags.setStrokeWidth(GetTrailWidth());
+    trail_flags.setColor(GetTrailColor());
+    canvas->DrawPath(path.detach(), trail_flags);
+  }
+
+  if (!draw_hint) {
+    return;
+  }
+
+  const std::u16string hint_text = GetHintText();
+  if (hint_text.empty()) {
+    return;
+  }
+
+  constexpr int kHintPadding = 12;
+  constexpr int kHintMargin = 20;
+  constexpr int kHintHeight = 36;
+  constexpr int kHintOffsetX = 16;
+  constexpr int kHintOffsetY = 24;
+  const gfx::FontList font_list;
+  const int text_width = gfx::GetStringWidth(hint_text, font_list);
+  const int hint_width = std::min(paint_view->width() - 24,
+                                  std::max(160, text_width + kHintPadding * 2));
+  if (hint_width <= 0) {
+    return;
+  }
+
+  gfx::Point hint_origin((paint_view->width() - hint_width) / 2, kHintMargin);
+  if (gesture_in_progress_ && !trail_points_.empty()) {
+    const gfx::Point anchor = trail_points_.back();
+    const int max_x = std::max(kHintMargin, paint_view->width() - hint_width -
+                                                kHintMargin);
+    const int max_y =
+        std::max(kHintMargin, paint_view->height() - kHintHeight - kHintMargin);
+    hint_origin.set_x(
+        std::clamp(anchor.x() + kHintOffsetX, kHintMargin, max_x));
+    hint_origin.set_y(
+        std::clamp(anchor.y() - kHintOffsetY - kHintHeight, kHintMargin, max_y));
+  }
+
+  const gfx::Rect hint_bounds(hint_origin, gfx::Size(hint_width, kHintHeight));
+  cc::PaintFlags background_flags;
+  background_flags.setAntiAlias(true);
+  background_flags.setColor(SkColorSetA(SK_ColorBLACK, 0xCC));
+  canvas->DrawRoundRect(gfx::RectF(hint_bounds), 10.f, background_flags);
+
+  constexpr int kTextFlags =
+      gfx::Canvas::TEXT_ALIGN_CENTER | gfx::Canvas::NO_SUBPIXEL_RENDERING;
+  canvas->DrawStringRectWithFlags(hint_text, font_list, SK_ColorWHITE,
+                                  hint_bounds, kTextFlags);
+}
