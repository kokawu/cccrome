+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview
+ * 'settings-super-drag-page' is the settings page for super drag
+ * related preferences.
+ */
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_shared_style.css.js';
+import '../controls/settings_dropdown_menu.js';
+import '../controls/settings_slider.js';
+import '../controls/settings_toggle_button.js';
+import '../settings_page/settings_section.js';
+import '../settings_shared.css.js';
+
+import type {PrefsMixinInterface} from '/shared/settings/prefs/prefs_mixin.js';
+import {PrefsMixin} from '/shared/settings/prefs/prefs_mixin.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import type {DropdownMenuOptionList} from '../controls/settings_dropdown_menu.js';
+import {getSearchManager} from '../search_settings.js';
+import type {SettingsPlugin} from '../settings_main/settings_plugin.js';
+
+import {getTemplate} from './super_drag_page.html.js';
+
+type Constructor<T> = new (...args: any[]) => T;
+
+interface SuperDragRow {
+  key: string;
+  label: string;
+  token: string;
+}
+
+const DEFAULT_LINK_ACTIONS: Record<string, string> = {
+  'U': 'open_current_tab',
+  'D': 'open_new_foreground_tab',
+  'L': 'open_current_tab',
+  'R': 'open_new_foreground_tab',
+};
+
+const DEFAULT_TEXT_ACTIONS: Record<string, string> = {
+  'U': 'search_current_tab',
+  'D': 'search_new_foreground_tab',
+  'L': 'search_current_tab',
+  'R': 'search_new_foreground_tab',
+};
+
+const DEFAULT_IMAGE_ACTIONS: Record<string, string> = {
+  'U': 'open_current_tab',
+  'D': 'open_new_foreground_tab',
+  'L': 'open_current_tab',
+  'R': 'open_new_foreground_tab',
+};
+
+const DIRECTION_ROWS: SuperDragRow[] = [
+  {key: 'U', label: '向上', token: 'U'},
+  {key: 'D', label: '向下', token: 'D'},
+  {key: 'L', label: '向左', token: 'L'},
+  {key: 'R', label: '向右', token: 'R'},
+];
+
+const THRESHOLD_TICKS = [4, 6, 8, 10, 12, 16, 24];
+
+const LINK_ACTION_OPTIONS: DropdownMenuOptionList = [
+  {value: 'none', name: '无动作'},
+  {value: 'open_current_tab', name: '当前标签打开链接'},
+  {value: 'open_new_foreground_tab', name: '新前台标签打开链接'},
+  {value: 'open_new_background_tab', name: '新后台标签打开链接'},
+  {value: 'copy_value', name: '复制链接地址'},
+];
+
+const TEXT_ACTION_OPTIONS: DropdownMenuOptionList = [
+  {value: 'none', name: '无动作'},
+  {value: 'search_current_tab', name: '当前标签搜索文本'},
+  {value: 'search_new_foreground_tab', name: '新前台标签搜索文本'},
+  {value: 'search_new_background_tab', name: '新后台标签搜索文本'},
+  {value: 'copy_value', name: '复制文本'},
+];
+
+const IMAGE_ACTION_OPTIONS: DropdownMenuOptionList = [
+  {value: 'none', name: '无动作'},
+  {value: 'open_current_tab', name: '当前标签打开图片'},
+  {value: 'open_new_foreground_tab', name: '新前台标签打开图片'},
+  {value: 'open_new_background_tab', name: '新后台标签打开图片'},
+  {value: 'copy_value', name: '复制图片地址'},
+];
+
+const SettingsSuperDragPageElementBase = PrefsMixin(PolymerElement) as
+    Constructor<PrefsMixinInterface&PolymerElement>;
+
+export class SettingsSuperDragPageElement extends
+    SettingsSuperDragPageElementBase implements SettingsPlugin {
+  static get is() {
+    return 'settings-super-drag-page';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      prefs: {
+        type: Object,
+        notify: true,
+      },
+
+      thresholdTicks_: {
+        type: Array,
+        value: (): number[] => THRESHOLD_TICKS,
+      },
+
+      directionRows_: {
+        type: Array,
+        value: (): SuperDragRow[] => DIRECTION_ROWS,
+      },
+
+      linkActionOptions_: {
+        type: Array,
+        value: (): DropdownMenuOptionList => LINK_ACTION_OPTIONS,
+      },
+
+      textActionOptions_: {
+        type: Array,
+        value: (): DropdownMenuOptionList => TEXT_ACTION_OPTIONS,
+      },
+
+      imageActionOptions_: {
+        type: Array,
+        value: (): DropdownMenuOptionList => IMAGE_ACTION_OPTIONS,
+      },
+    };
+  }
+
+  declare prefs: {[key: string]: any};
+  declare private thresholdTicks_: number[];
+  declare private directionRows_: SuperDragRow[];
+  declare private linkActionOptions_: DropdownMenuOptionList;
+  declare private textActionOptions_: DropdownMenuOptionList;
+  declare private imageActionOptions_: DropdownMenuOptionList;
+
+  async searchContents(query: string) {
+    const searchRequest = await getSearchManager().search(query, this);
+    return searchRequest.getSearchResult();
+  }
+
+  private onResetActionDefinitionsClick_() {
+    for (const [key, value] of Object.entries(DEFAULT_LINK_ACTIONS)) {
+      this.setPrefDictEntry('cc.super_drag.link_actions', key, value);
+    }
+
+    for (const [key, value] of Object.entries(DEFAULT_TEXT_ACTIONS)) {
+      this.setPrefDictEntry('cc.super_drag.text_actions', key, value);
+    }
+
+    for (const [key, value] of Object.entries(DEFAULT_IMAGE_ACTIONS)) {
+      this.setPrefDictEntry('cc.super_drag.image_actions', key, value);
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-super-drag-page': SettingsSuperDragPageElement;
+  }
+}
+
+customElements.define(
+    SettingsSuperDragPageElement.is, SettingsSuperDragPageElement);
