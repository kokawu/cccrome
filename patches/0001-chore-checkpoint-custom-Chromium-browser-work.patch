+std::optional<std::string> BrowserMouseGestureController::GetConfiguredGestureActionId(
+    std::string_view gesture) const {
+  PrefService* const prefs = GetPrefs();
+  if (prefs) {
+    if (const std::string* configured =
+            prefs->GetDict(mouse_gesture::prefs::kActions).FindString(gesture)) {
+      return *configured;
+    }
+  }
+
+  const std::string_view default_action =
+      mouse_gesture::GetDefaultActionIdForGesture(gesture);
+  if (!default_action.empty()) {
+    return std::string(default_action);
+  }
+  return std::nullopt;
+}
