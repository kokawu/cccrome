+BrowserMouseGestureController::GetMappedAction(std::string_view gesture) const {
+  const std::optional<std::string> action_id =
+      GetConfiguredGestureActionId(gesture);
+  return action_id ? ParseActionId(*action_id) : Action::kUnknown;
+}
