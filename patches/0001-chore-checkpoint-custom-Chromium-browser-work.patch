+            header.append(0x80 | payload_length)
+        elif payload_length < (1 << 16):
+            header.append(0x80 | 126)
+            header.extend(payload_length.to_bytes(2, 'big'))
+        else:
+            header.append(0x80 | 127)
+            header.extend(payload_length.to_bytes(8, 'big'))
