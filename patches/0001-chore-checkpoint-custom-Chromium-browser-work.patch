+
+#include "chrome/browser/ui/views/frame/super_drag_pref_names.h"
+
+namespace super_drag {
+
+namespace {
+
+constexpr std::string_view kCurrentTabAction = "open_current_tab";
+constexpr std::string_view kNewForegroundTabAction =
+    "open_new_foreground_tab";
+constexpr std::string_view kCurrentTabSearchAction = "search_current_tab";
+constexpr std::string_view kNewForegroundTabSearchAction =
+    "search_new_foreground_tab";
+
+}  // namespace
+
+base::DictValue CreateDefaultLinkActionMap() {
+  base::DictValue action_map;
+  action_map.Set("U", kCurrentTabAction);
+  action_map.Set("D", kNewForegroundTabAction);
+  action_map.Set("L", kCurrentTabAction);
+  action_map.Set("R", kNewForegroundTabAction);
+  return action_map;
+}
+
+base::DictValue CreateDefaultTextActionMap() {
+  base::DictValue action_map;
+  action_map.Set("U", kCurrentTabSearchAction);
+  action_map.Set("D", kNewForegroundTabSearchAction);
+  action_map.Set("L", kCurrentTabSearchAction);
+  action_map.Set("R", kNewForegroundTabSearchAction);
+  return action_map;
+}
+
+base::DictValue CreateDefaultImageActionMap() {
+  base::DictValue action_map;
+  action_map.Set("U", kCurrentTabAction);
+  action_map.Set("D", kNewForegroundTabAction);
+  action_map.Set("L", kCurrentTabAction);
+  action_map.Set("R", kNewForegroundTabAction);
+  return action_map;
+}
+
+std::string_view GetDefaultLinkActionIdForDirection(std::string_view direction) {
+  if (direction == "U" || direction == "L") {
+    return kCurrentTabAction;
+  }
+  if (direction == "D" || direction == "R") {
+    return kNewForegroundTabAction;
+  }
+  return std::string_view();
+}
+
+std::string_view GetDefaultTextActionIdForDirection(std::string_view direction) {
+  if (direction == "U" || direction == "L") {
+    return kCurrentTabSearchAction;
+  }
+  if (direction == "D" || direction == "R") {
+    return kNewForegroundTabSearchAction;
+  }
+  return std::string_view();
+}
+
+std::string_view GetDefaultImageActionIdForDirection(
+    std::string_view direction) {
+  if (direction == "U" || direction == "L") {
+    return kCurrentTabAction;
+  }
+  if (direction == "D" || direction == "R") {
+    return kNewForegroundTabAction;
+  }
+  return std::string_view();
+}
+
+}  // namespace super_drag
