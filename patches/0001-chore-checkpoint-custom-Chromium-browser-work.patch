+bool BookmarksSidePanelCoordinator::Show(
+    Browser* browser,
+    std::optional<std::string_view> initial_folder_id) {
+  if (!browser) {
+    return false;
+  }
+
+  SidePanelUI* const side_panel_ui = browser->GetFeatures().side_panel_ui();
+  if (!side_panel_ui) {
+    return false;
+  }
+
+  const std::optional<uint64_t> request_id =
+      initial_folder_id.has_value()
+          ? std::make_optional(++folder_navigation_request_id_)
+          : std::nullopt;
+  const GURL target_url =
+      GetBookmarksSidePanelUrl(initial_folder_id, request_id);
+  pending_show_url_ = target_url;
+  has_pending_show_folder_request_ = true;
+  pending_show_folder_id_ = initial_folder_id.has_value()
+                                ? std::make_optional(
+                                      std::string(*initial_folder_id))
+                                : std::nullopt;
+
+  content::WebContents* const web_contents =
+      GetBookmarksSidePanelWebContents(browser, /*create_if_needed=*/true);
+  side_panel_ui->Show(SidePanelEntry::Id::kBookmarks);
+
+  const bool needs_navigation =
+      web_contents && web_contents->GetVisibleURL() != target_url;
+  if (needs_navigation) {
+    web_contents->GetController().LoadURL(
+        target_url, content::Referrer(), ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+        /*extra_headers=*/std::string());
+  } else if (BookmarksSidePanelUI* const bookmarks_ui =
+                 GetBookmarksSidePanelUIForBrowser(browser)) {
+    bookmarks_ui->ShowFolder(pending_show_folder_id_);
+  }
+
+  pending_show_url_.reset();
+  has_pending_show_folder_request_ = false;
+  return true;
+}
