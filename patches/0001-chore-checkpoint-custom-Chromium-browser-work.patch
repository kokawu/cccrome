+BrowserRootViewMouseGestureEventFilter::BrowserRootViewMouseGestureEventFilter(
+    BrowserRootView* root_view,
+    BrowserMouseGestureController* controller)
+    : root_view_(root_view), controller_(controller) {
+  views::Widget* const widget = root_view_ ? root_view_->GetWidget() : nullptr;
+  if (widget) {
+    widget_observation_.Observe(widget);
+  }
+
+#if defined(USE_AURA)
+  native_window_ = widget ? widget->GetNativeWindow() : nullptr;
+  if (native_window_) {
+    native_window_->AddPreTargetHandler(this);
+    return;
+  }
+#endif
+
+  if (root_view_) {
+    root_view_->AddPreTargetHandler(this);
+    registered_on_root_view_ = true;
+  }
+}
+
+BrowserRootViewMouseGestureEventFilter::
+    ~BrowserRootViewMouseGestureEventFilter() {
+  ReleasePreTargetHandler();
+}
+
+void BrowserRootViewMouseGestureEventFilter::OnMouseEvent(
+    ui::MouseEvent* event) {
+  if (controller_ && controller_->OnMouseEvent(event)) {
+    event->SetHandled();
+  }
+}
+
+void BrowserRootViewMouseGestureEventFilter::OnWidgetDestroying(
+    views::Widget* widget) {
+  CHECK(!widget || widget_observation_.IsObservingSource(widget));
+  ReleasePreTargetHandler();
+  widget_observation_.Reset();
+}
+
+void BrowserRootViewMouseGestureEventFilter::ReleasePreTargetHandler() {
+#if defined(USE_AURA)
+  if (native_window_) {
+    native_window_->RemovePreTargetHandler(this);
+    native_window_ = nullptr;
+  }
+#endif
+
+  if (registered_on_root_view_ && root_view_) {
+    root_view_->RemovePreTargetHandler(this);
+    registered_on_root_view_ = false;
+  }
+}
