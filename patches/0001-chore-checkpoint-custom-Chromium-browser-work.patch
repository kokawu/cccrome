+    if (const std::string* configured =
+            prefs->GetDict(mouse_gesture::prefs::kAuxiliaryActions)
+                .FindString(trigger)) {
+      return *configured;
+    }
+  }
+
+  const std::string_view default_action =
+      mouse_gesture::GetDefaultActionIdForAuxiliaryTrigger(trigger);
+  if (!default_action.empty()) {
