+    expected_accept = base64.b64encode(
+        hashlib.sha1((key + _WEBSOCKET_GUID).encode('ascii')).digest()).decode(
+            'ascii')
+    if headers.get('sec-websocket-accept', '') != expected_accept:
+        sock.close()
+        raise common.BrowserctlError(
+            'WebSocket handshake failed: invalid Sec-WebSocket-Accept.')
+    return _FallbackWebSocket(sock, initial_buffer=remainder)
+
+
+class _CdpConnection:
+    def __init__(self,
+                 websocket_url: str,
+                 timeout: float = 10.0,
+                 origin: str = ''):
+        self.websocket_url = websocket_url
+        self.timeout = timeout
+        self.origin = origin
+        self._next_id = 0
+        self._ws: Any = None
+
+    def __enter__(self) -> '_CdpConnection':
+        self._ws = _create_ws_connection(self.websocket_url,
+                                         timeout=self.timeout,
+                                         origin=self.origin)
+        return self
+
+    def __exit__(self, exc_type: Any, exc: Any, exc_tb: Any) -> None:
+        if self._ws is not None:
+            self._ws.close()
+            self._ws = None
+
+    def call(self,
+             method: str,
+             params: dict[str, Any] | None = None,
+             timeout: float | None = None) -> dict[str, Any]:
+        if self._ws is None:
+            raise common.BrowserctlError('CDP socket is not connected.')
+        self._next_id += 1
+        request_id = self._next_id
+        self._ws.settimeout(timeout or self.timeout)
+        self._ws.send(
+            json.dumps({
+                'id': request_id,
+                'method': method,
+                'params': params or {},
+            },
+                       ensure_ascii=False))
+        while True:
+            raw_message = self._ws.recv()
+            if isinstance(raw_message, bytes):
+                raw_message = raw_message.decode('utf-8')
+            message = json.loads(raw_message)
+            if message.get('id') != request_id:
+                continue
+            if 'error' in message:
+                error = message['error']
+                raise common.BrowserctlError(
+                    f'CDP {method} failed: {error.get("message", error)}')
+            return message.get('result', {})
+
+
+class DevToolsClient:
+    def __init__(self, remote_debugging_port: int):
+        self.remote_debugging_port = int(remote_debugging_port)
+        self.origin = f'http://127.0.0.1:{self.remote_debugging_port}'
+
+    def _devtools_url(self, path: str) -> str:
+        if not path.startswith('/'):
+            path = f'/{path}'
+        return f'http://127.0.0.1:{self.remote_debugging_port}{path}'
+
+    def _request_json(self, path: str, method: str = 'GET') -> Any:
+        return common.json_request(self._devtools_url(path),
+                                   method=method,
+                                   timeout=5.0)
+
+    def version_info(self) -> dict[str, Any]:
+        return self._request_json('/json/version')
+
+    def list_tabs(self) -> list[dict[str, Any]]:
+        tabs = self._request_json('/json/list')
+        if isinstance(tabs, list):
+            return tabs
+        return []
+
+    def _page_tabs(self) -> list[dict[str, Any]]:
+        return [
+            tab for tab in self.list_tabs()
+            if tab.get('type') == 'page' and tab.get('webSocketDebuggerUrl')
+        ]
+
+    def _evaluate_visibility(self, tab: dict[str, Any]) -> dict[str, Any]:
+        return self._evaluate_expression(
+            tab,
+            """(() => ({
+                visible: document.visibilityState === 'visible',
+                focused: document.hasFocus(),
+                readyState: document.readyState,
+                title: document.title,
+                url: location.href,
+            }))()""",
+            await_promise=False,
+            return_by_value=True,
+            user_gesture=False)
+
+    def get_tab(self, tab_id: str = '') -> dict[str, Any]:
+        tabs = self._page_tabs()
+        if not tabs:
+            raise common.BrowserctlError(
+                'No page tabs are available in the managed browser.')
+        if tab_id:
+            for tab in tabs:
+                if tab.get('id') == tab_id:
+                    return tab
+            raise common.BrowserctlError(f'No tab matched id {tab_id}.')
+
+        preferred_tab: dict[str, Any] | None = None
+        for tab in tabs:
+            try:
+                state = self._evaluate_visibility(tab)
+            except common.BrowserctlError:
+                continue
+            if state.get('visible') or state.get('focused'):
+                preferred_tab = tab
+                break
+        return preferred_tab or tabs[0]
+
+    def activate_tab(self, tab_id: str) -> dict[str, Any]:
+        encoded_tab_id = urllib.parse.quote(tab_id, safe='')
+        attempts = [
+            (f'/json/activate/{encoded_tab_id}', 'GET'),
+            (f'/json/activate/{encoded_tab_id}', 'PUT'),
+        ]
+        for path, method in attempts:
+            try:
+                self._request_json(path, method=method)
+                return self.get_tab(tab_id)
+            except common.BrowserctlError:
+                continue
+        raise common.BrowserctlError(f'Could not activate tab {tab_id}.')
+
+    def _evaluate_expression(self,
+                             tab: dict[str, Any],
+                             expression: str,
+                             *,
+                             await_promise: bool,
+                             return_by_value: bool,
+                             user_gesture: bool) -> Any:
+        websocket_url = tab.get('webSocketDebuggerUrl')
+        if not websocket_url:
+            raise common.BrowserctlError(
+                f'Tab {tab.get("id")} does not expose a websocket debugger URL.')
+        with _CdpConnection(str(websocket_url),
+                            timeout=10.0,
+                            origin=self.origin) as connection:
+            result = connection.call(
+                'Runtime.evaluate',
+                {
+                    'expression': expression,
+                    'awaitPromise': await_promise,
+                    'returnByValue': return_by_value,
+                    'userGesture': user_gesture,
+                },
+            )
+        if 'exceptionDetails' in result:
+            details = result['exceptionDetails']
+            description = details.get('text') or 'Runtime.evaluate threw.'
+            exception = details.get('exception') or {}
+            if exception.get('description'):
+                description = exception['description']
+            raise common.BrowserctlError(description)
+        details = result.get('result', {})
+        if details.get('subtype') == 'error':
+            raise common.BrowserctlError(
+                f'Runtime.evaluate failed: {details.get("description", details)}')
+        if return_by_value:
+            return details.get('value')
+        return details
+
+    def evaluate(self, expression: str, tab_id: str = '') -> dict[str, Any]:
+        tab = self.get_tab(tab_id)
+        return {
+            'tab': _tab_summary(tab),
+            'result': self._evaluate_expression(tab,
+                                                expression,
+                                                await_promise=True,
+                                                return_by_value=True,
+                                                user_gesture=True),
+        }
+
+    def inspect_page(self, limit: int = 80, tab_id: str = '') -> dict[str, Any]:
+        tab = self.get_tab(tab_id)
+        limit = max(1, min(int(limit), 200))
+        expression = f"""(() => {{
+{_DOM_HELPERS}
+  const nodes = browserctl.interactiveCandidates().slice(0, {limit});
+  const focused = document.activeElement && document.activeElement !== document.body
+      ? browserctl.summary(document.activeElement, -1)
+      : null;
+  return {{
+    title: document.title,
+    url: location.href,
+    readyState: document.readyState,
+    visibilityState: document.visibilityState,
+    viewport: {{
+      width: window.innerWidth,
+      height: window.innerHeight,
+      devicePixelRatio: window.devicePixelRatio,
+      scrollX: Math.round(window.scrollX),
+      scrollY: Math.round(window.scrollY),
+    }},
+    focused,
+    elementCount: nodes.length,
+    elements: nodes.map((element, index) => browserctl.summary(element, index)),
+  }};
+}})()"""
+        return {
+            'tab': _tab_summary(tab),
+            'page': self._evaluate_expression(tab,
+                                              expression,
+                                              await_promise=False,
+                                              return_by_value=True,
+                                              user_gesture=False),
+        }
+
+    def capture_page_screenshot(self,
+                                tab_id: str = '',
+                                full_page: bool = False) -> dict[str, Any]:
+        tab = self.get_tab(tab_id)
+        websocket_url = tab.get('webSocketDebuggerUrl')
+        if not websocket_url:
+            raise common.BrowserctlError(
+                f'Tab {tab.get("id")} does not expose a websocket debugger URL.')
+        _PAGE_SCREENSHOT_DIR.mkdir(parents=True, exist_ok=True)
+        output_path = (_PAGE_SCREENSHOT_DIR /
+                       f'page_{tab.get("id")}_{int(time.time() * 1000)}.png')
+        with _CdpConnection(str(websocket_url),
+                            timeout=15.0,
+                            origin=self.origin) as connection:
+            connection.call('Page.enable')
+            result = connection.call(
+                'Page.captureScreenshot',
+                {
+                    'format': 'png',
+                    'fromSurface': True,
+                    'captureBeyondViewport': bool(full_page),
+                },
+                timeout=30.0,
+            )
+        output_path.write_bytes(base64.b64decode(result['data']))
+        return {
+            'tab': _tab_summary(tab),
+            'screenshot_path': str(output_path),
+            'full_page': bool(full_page),
+        }
+
+    def click_element(self,
+                      selector: str = '',
+                      match_text: str = '',
+                      index: int = -1,
+                      contains: bool = True,
+                      tab_id: str = '') -> dict[str, Any]:
+        tab = self.get_tab(tab_id)
+        options = {
+            'selector': selector,
+            'matchText': match_text,
+            'index': index,
+            'contains': contains,
+            'editableOnly': False,
+        }
+        expression = f"""(async () => {{
+{_DOM_HELPERS}
+  const match = browserctl.resolveElement({json.dumps(options, ensure_ascii=False)});
+  if (!match.element) {{
+    throw new Error('No element matched the requested selector/text/index.');
+  }}
+  const element = match.element;
+  element.scrollIntoView({{block: 'center', inline: 'center'}});
+  await new Promise((resolve) => window.setTimeout(resolve, 60));
+  if (typeof element.focus === 'function') {{
+    element.focus({{preventScroll: true}});
+  }}
+  await new Promise((resolve) => window.setTimeout(resolve, 20));
+  if (typeof element.click === 'function') {{
+    element.click();
+  }} else {{
+    element.dispatchEvent(new MouseEvent('click', {{
+      bubbles: true,
+      cancelable: true,
+      composed: true,
+      view: window,
+    }}));
+  }}
+  return {{
+    ok: true,
+    strategy: match.strategy,
+    index: match.index,
+    matchCount: match.matchCount,
+    element: browserctl.summary(element, match.index),
+  }};
+}})()"""
+        return {
+            'tab': _tab_summary(tab),
+            'action': self._evaluate_expression(tab,
+                                                expression,
+                                                await_promise=True,
+                                                return_by_value=True,
+                                                user_gesture=True),
+        }
+
+    def _dispatch_enter(self, websocket_url: str) -> None:
+        with _CdpConnection(websocket_url,
+                            timeout=10.0,
+                            origin=self.origin) as connection:
+            connection.call(
+                'Input.dispatchKeyEvent',
+                {
+                    'type': 'keyDown',
+                    'windowsVirtualKeyCode': 13,
+                    'nativeVirtualKeyCode': 13,
+                    'key': 'Enter',
+                    'code': 'Enter',
+                })
+            connection.call(
+                'Input.dispatchKeyEvent',
+                {
+                    'type': 'keyUp',
+                    'windowsVirtualKeyCode': 13,
+                    'nativeVirtualKeyCode': 13,
+                    'key': 'Enter',
+                    'code': 'Enter',
+                })
+
+    def type_element(self,
+                     text: str,
+                     selector: str = '',
+                     match_text: str = '',
+                     index: int = -1,
+                     contains: bool = True,
+                     clear: bool = False,
+                     press_enter: bool = False,
+                     tab_id: str = '') -> dict[str, Any]:
+        tab = self.get_tab(tab_id)
+        websocket_url = tab.get('webSocketDebuggerUrl')
+        if not websocket_url:
+            raise common.BrowserctlError(
+                f'Tab {tab.get("id")} does not expose a websocket debugger URL.')
+        options = {
+            'selector': selector,
+            'matchText': match_text,
+            'index': index,
+            'contains': contains,
+            'clear': clear,
+            'editableOnly': True,
+        }
+        prepare_expression = f"""(async () => {{
+{_DOM_HELPERS}
+  const options = {json.dumps(options, ensure_ascii=False)};
+  const match = browserctl.resolveElement(options);
+  if (!match.element) {{
+    throw new Error('No element matched the requested selector/text/index.');
+  }}
+  const element = match.element;
+  if (!browserctl.editable(element)) {{
+    throw new Error('Matched element is not editable.');
+  }}
+  element.scrollIntoView({{block: 'center', inline: 'center'}});
+  await new Promise((resolve) => window.setTimeout(resolve, 60));
+  if (typeof element.focus === 'function') {{
+    element.focus({{preventScroll: true}});
+  }}
+  if (options.clear) {{
+    browserctl.clearEditableValue(element);
+  }}
+  return {{
+    ok: true,
+    strategy: match.strategy,
+    index: match.index,
+    matchCount: match.matchCount,
+    element: browserctl.summary(element, match.index),
+    beforeValue: browserctl.clip(browserctl.textValue(element), 400),
+  }};
+}})()"""
+        prepared = self._evaluate_expression(tab,
+                                             prepare_expression,
+                                             await_promise=True,
+                                             return_by_value=True,
+                                             user_gesture=True)
+        if not prepared or not prepared.get('ok'):
+            raise common.BrowserctlError(
+                f'Could not prepare editable element for typing: {prepared}')
+        with _CdpConnection(str(websocket_url),
+                            timeout=10.0,
+                            origin=self.origin) as connection:
+            if text:
+                connection.call('Input.insertText', {'text': text})
+            if press_enter:
+                connection.call(
+                    'Input.dispatchKeyEvent',
+                    {
+                        'type': 'keyDown',
+                        'windowsVirtualKeyCode': 13,
+                        'nativeVirtualKeyCode': 13,
+                        'key': 'Enter',
+                        'code': 'Enter',
+                    })
+                connection.call(
+                    'Input.dispatchKeyEvent',
+                    {
+                        'type': 'keyUp',
+                        'windowsVirtualKeyCode': 13,
+                        'nativeVirtualKeyCode': 13,
+                        'key': 'Enter',
+                        'code': 'Enter',
+                    })
+        finalize_expression = f"""(() => {{
+{_DOM_HELPERS}
+  const element = document.activeElement;
+  return {{
+    focused: browserctl.summary(element, -1),
+    value: browserctl.clip(browserctl.textValue(element), 400),
+  }};
+}})()"""
+        finalized = self._evaluate_expression(tab,
+                                              finalize_expression,
+                                              await_promise=False,
+                                              return_by_value=True,
+                                              user_gesture=False)
+        return {
+            'tab': _tab_summary(tab),
+            'action': {
+                **prepared,
+                'typedTextLength': len(text),
+                'pressEnter': bool(press_enter),
+                'after': finalized,
+            },
+        }
+
+    def wait_for_selector(self,
+                          selector: str,
+                          timeout_ms: int = 5000,
+                          visible: bool = True,
+                          tab_id: str = '') -> dict[str, Any]:
+        tab = self.get_tab(tab_id)
+        timeout_ms = max(100, int(timeout_ms))
+        started_at = time.time()
+        deadline = time.time() + timeout_ms / 1000.0
+        last_state: dict[str, Any] | None = None
+        expression = f"""(() => {{
+{_DOM_HELPERS}
+  const selectorText = {json.dumps(selector, ensure_ascii=False)};
+  const element = document.querySelector(selectorText);
+  return {{
+    found: Boolean(element),
+    visible: Boolean(element && browserctl.visible(element)),
+    element: element ? browserctl.summary(element, 0) : null,
+  }};
+}})()"""
+        while time.time() < deadline:
+            last_state = self._evaluate_expression(tab,
+                                                   expression,
+                                                   await_promise=False,
+                                                   return_by_value=True,
+                                                   user_gesture=False)
+            if last_state.get('found') and (not visible or
+                                            last_state.get('visible')):
+                return {
+                    'tab': _tab_summary(tab),
+                    'waited_ms': int((time.time() - started_at) * 1000),
+                    'state': last_state,
+                }
+            time.sleep(0.2)
+        raise common.BrowserctlError(
+            f'Selector {selector!r} was not ready within {timeout_ms}ms. '
+            f'Last state: {last_state}')
