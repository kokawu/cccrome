+
+void MultiContentsViewDelegateImpl::HandleSuperDragDrop(
+    MultiContentsDropTargetView::DropSide side,
+    MultiContentsDropTargetView::DragType drag_type,
+    const content::DropData& data,
+    const ui::DropTargetEvent& event) {
+  Browser& browser = browser_.get();
+  GURL target_url;
+  ui::PageTransition transition = ui::PAGE_TRANSITION_LINK;
+
+  switch (drag_type) {
+    case MultiContentsDropTargetView::DragType::kSuperDragText: {
+      auto search_terms = GetSuperDragSearchTerms(data);
+      if (!search_terms.has_value()) {
+        return;
+      }
+      auto* template_url_service =
+          TemplateURLServiceFactory::GetForProfile(browser.profile());
+      if (!template_url_service) {
+        return;
+      }
+      target_url =
+          GetDefaultSearchURLForSearchTerms(template_url_service, *search_terms);
+      transition = ui::PAGE_TRANSITION_GENERATED;
+      break;
+    }
+    case MultiContentsDropTargetView::DragType::kSuperDragImage:
+      target_url = GetSuperDragImageUrl(data);
+      break;
+    case MultiContentsDropTargetView::DragType::kSuperDragLink:
+      if (!data.url_infos.empty()) {
+        target_url = data.url_infos.front().url;
+      }
+      break;
+    case MultiContentsDropTargetView::DragType::kTab:
+    case MultiContentsDropTargetView::DragType::kLink:
+      return;
+  }
+
+  if (!target_url.is_valid() || target_url.SchemeIs(url::kJavaScriptScheme)) {
+    return;
+  }
+
+  NavigateParams params(&browser, target_url, transition);
+  params.disposition = GetSuperDragDisposition(side);
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  params.initiator_origin = event.data().GetRendererTaintedOrigin();
+  Navigate(&params);
+}
