+constexpr char kInitialFolderQueryParam[] = "folder";
+constexpr char kInitialFolderRequestIdQueryParam[] = "folder_request_id";
+
+GURL GetBookmarksSidePanelUrl(
+    std::optional<std::string_view> initial_folder_id,
+    std::optional<uint64_t> request_id = std::nullopt) {
+  GURL url(chrome::kChromeUIBookmarksSidePanelURL);
+  if (!initial_folder_id.has_value() || initial_folder_id->empty()) {
+    return url;
+  }
+
+  url = net::AppendOrReplaceQueryParameter(
+      url, kInitialFolderQueryParam, std::string(*initial_folder_id));
+  if (request_id.has_value()) {
+    url = net::AppendOrReplaceQueryParameter(
+        url, kInitialFolderRequestIdQueryParam,
+        std::to_string(request_id.value()));
+  }
+  return url;
+}
+
+content::WebContents* GetBookmarksSidePanelWebContents(
+    Browser* browser,
+    bool create_if_needed = false) {
+  if (browser) {
+    SidePanelUI* const side_panel_ui = browser->GetFeatures().side_panel_ui();
+    BrowserView* const browser_view =
+        BrowserView::GetBrowserViewForBrowser(browser);
+    SidePanel* const side_panel =
+        browser_view ? browser_view->contents_height_side_panel() : nullptr;
+    if (side_panel_ui && side_panel &&
+        side_panel_ui->GetCurrentEntryId(SidePanelEntry::PanelType::kContent) ==
+            SidePanelEntry::Id::kBookmarks) {
+      views::View* const content_parent = side_panel->GetContentParentView();
+      if (content_parent && !content_parent->children().empty()) {
+        views::View* const web_view = content_parent->children().front()->GetViewByID(
+            SidePanelWebUIView::kSidePanelWebViewId);
+        if (web_view) {
+          return static_cast<views::WebView*>(web_view)->web_contents();
+        }
+      }
+    }
+  }
+
+  SidePanelRegistry* const registry = SidePanelRegistry::From(browser);
+  if (!registry) {
+    return nullptr;
+  }
+
+  SidePanelEntry* const entry =
+      registry->GetEntryForKey(SidePanelEntry::Key(SidePanelEntry::Id::kBookmarks));
+  if (!entry) {
+    return nullptr;
+  }
+
+  if (!entry->CachedView() && create_if_needed) {
+    entry->CacheView(entry->GetContent());
+  }
+
+  if (!entry->CachedView()) {
+    return nullptr;
+  }
+
+  views::View* const web_view = entry->CachedView()->GetViewByID(
+      SidePanelWebUIView::kSidePanelWebViewId);
+  return web_view ? static_cast<views::WebView*>(web_view)->web_contents()
+                  : nullptr;
+}
+
+BookmarksSidePanelUI* GetBookmarksSidePanelUIForBrowser(Browser* browser) {
+  content::WebContents* const web_contents =
+      GetBookmarksSidePanelWebContents(browser);
+  if (!web_contents || !web_contents->GetWebUI() ||
+      !web_contents->GetWebUI()->GetController()) {
+    return nullptr;
+  }
+
+  return web_contents->GetWebUI()->GetController()->GetAs<BookmarksSidePanelUI>();
+}
