+SkColor ParseMouseGestureTrailColor(std::string_view value) {
+  std::string hex(value);
+  if (!hex.empty() && hex.front() == '#') {
+    hex.erase(hex.begin());
+  }
+  uint32_t parsed = 0;
+  if (!base::HexStringToUInt(hex, &parsed)) {
+    return SkColorSetRGB(0x33, 0x99, 0xFF);
+  }
+
+  if (hex.size() == 8) {
+    return SkColorSetARGB((parsed >> 24) & 0xFF, (parsed >> 16) & 0xFF,
+                          (parsed >> 8) & 0xFF, parsed & 0xFF);
+  }
+  if (hex.size() == 6) {
+    return SkColorSetRGB((parsed >> 16) & 0xFF, (parsed >> 8) & 0xFF,
+                         parsed & 0xFF);
+  }
+  return SkColorSetRGB(0x33, 0x99, 0xFF);
+}
