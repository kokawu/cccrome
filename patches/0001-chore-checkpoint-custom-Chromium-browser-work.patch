+        result = self.window_control_module.open_url_in_browser(
+            url=url,
+            process_name='chrome.exe',
+            target_pid=self._target_pid(),
+        )
+        result['tabs'] = self.list_tabs()
+        result['browser_pid'] = self.browser_pid
+        result['remote_debugging_port'] = self.remote_debugging_port
+        return result
+
+    def wait(self, milliseconds: int) -> dict[str, Any]:
+        self.ensure_browser()
+        result = self.window_control_module.wait_for_browser(
+            milliseconds=milliseconds)
+        result['browser_pid'] = self.browser_pid
+        result['remote_debugging_port'] = self.remote_debugging_port
