+
+bool MultiContentsViewDropTargetController::IsSuperDragType(
+    MultiContentsDropTargetView::DragType drag_type) const {
+  switch (drag_type) {
+    case MultiContentsDropTargetView::DragType::kSuperDragLink:
+    case MultiContentsDropTargetView::DragType::kSuperDragText:
+    case MultiContentsDropTargetView::DragType::kSuperDragImage:
+      return true;
+    case MultiContentsDropTargetView::DragType::kTab:
+    case MultiContentsDropTargetView::DragType::kLink:
+      return false;
+  }
+}
+
+std::optional<MultiContentsDropTargetView::DragType>
+MultiContentsViewDropTargetController::GetSuperDragType(
+    const content::DropData& data) const {
+  if (!IsSuperDragEnabled() || !data.did_originate_from_renderer) {
+    return std::nullopt;
+  }
+
+  if ((data.file_contents_image_accessible ||
+       data.file_contents_source_url.is_valid()) &&
+      (data.file_contents_source_url.is_valid() || !data.url_infos.empty())) {
+    return MultiContentsDropTargetView::DragType::kSuperDragImage;
+  }
+
+  if (!data.url_infos.empty() && data.url_infos.front().url.is_valid()) {
+    return MultiContentsDropTargetView::DragType::kSuperDragLink;
+  }
+
+  if (data.text.has_value()) {
+    std::u16string text = *data.text;
+    base::TrimWhitespace(text, base::TRIM_ALL, &text);
+    if (!text.empty()) {
+      return MultiContentsDropTargetView::DragType::kSuperDragText;
+    }
+  }
+
+  return std::nullopt;
+}
+
+void MultiContentsViewDropTargetController::ClearCurrentWebContentsDrag() {
+  current_web_contents_drag_type_.reset();
+  current_web_contents_drag_data_.reset();
 }
 
