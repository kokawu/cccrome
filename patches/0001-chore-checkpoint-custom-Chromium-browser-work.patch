+
+void BrowserMouseGestureController::RequestRepaint() {
+  EnsureOverlayView();
+  if (HasOverlayView()) {
+    RefreshOverlayView();
+    return;
+  }
+  if (root_view_) {
+    root_view_->SchedulePaint();
+  }
+}
+
+bool BrowserMouseGestureController::HasOverlayView() const {
+  return !!overlay_view_tracker_;
+}
+
+void BrowserMouseGestureController::EnsureOverlayView() {
+  if (HasOverlayView() || !browser_view_) {
+    return;
+  }
+
+  views::View* const overlay_parent = browser_view_->contents_container();
+  if (!overlay_parent) {
+    return;
+  }
+
+  auto overlay_view = std::make_unique<MouseGestureOverlayView>(this);
+  overlay_view->SetVisible(false);
+  overlay_view_tracker_.SetView(overlay_parent->AddChildView(std::move(overlay_view)));
+}
+
+void BrowserMouseGestureController::RefreshOverlayView() {
+  EnsureOverlayView();
+  auto* overlay_view =
+      static_cast<MouseGestureOverlayView*>(overlay_view_tracker_.view());
+  if (!overlay_view) {
+    return;
+  }
+
+  overlay_view->SyncToParentBounds();
+  const bool should_show =
+      (gesture_in_progress_ && (ShouldShowTrail() || ShouldShowHint())) ||
+      (ShouldShowHint() && !action_feedback_text_.empty());
+  overlay_view->SetVisible(should_show);
+  if (should_show) {
+    overlay_view->SchedulePaint();
+  }
+}
