@@ -0,0 +1,76 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/base/dragdrop/drag_source_win.h"
+
+#include "base/test/bind.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/base/dragdrop/os_exchange_data.h"
+
+namespace ui {
+
+TEST(DragSourceWinTest, QueryContinueDragNotifiesUpdates) {
+  auto drag_source = DragSourceWin::Create();
+
+  int update_count = 0;
+  DWORD last_key_state = 0;
+  drag_source->set_drag_updated_callback(
+      base::BindLambdaForTesting([&](DWORD key_state) {
+        ++update_count;
+        last_key_state = key_state;
+      }));
+
+  EXPECT_EQ(S_OK, drag_source->QueryContinueDrag(
+                      /*escape_pressed=*/FALSE,
+                      MK_LBUTTON | MK_SHIFT));
+  EXPECT_EQ(1, update_count);
