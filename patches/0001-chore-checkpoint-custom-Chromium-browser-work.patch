+#!/usr/bin/env python3
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+"""Reusable client helpers for browserctl and agent integrations."""
+
+from __future__ import annotations
+
+import subprocess
+import sys
+import time
+from pathlib import Path
+from typing import Any
+
+import common
+
+SCRIPT_DIR = Path(__file__).resolve().parent
+_BROWSERD_PATH = SCRIPT_DIR / 'browserd.py'
+
+
+def _daemon_headers(state: dict[str, Any]) -> dict[str, str]:
+    return {'X-Browserctl-Token': state['token']}
+
+
+def daemon_is_healthy(state: dict[str, Any] | None) -> bool:
+    if not state:
+        return False
+    if not common.is_pid_running(state.get('pid')):
+        return False
+    try:
+        common.json_request(
+            common.daemon_url(state, '/ping'),
+            headers=_daemon_headers(state),
+            timeout=1.5,
+        )
+        return True
+    except Exception:
+        return False
+
+
+def wait_for_daemon_ready(timeout_seconds: float = 30.0) -> dict[str, Any]:
+    deadline = time.time() + timeout_seconds
+    last_error: Exception | None = None
+    while time.time() < deadline:
+        state = common.load_state()
+        if state and common.is_pid_running(state.get('pid')):
+            try:
+                common.json_request(
+                    common.daemon_url(state, '/ping'),
+                    headers=_daemon_headers(state),
+                    timeout=2.0,
+                )
+                return state
+            except Exception as exc:
+                last_error = exc
+        time.sleep(0.25)
+    raise common.BrowserctlError(
+        f'Daemon did not become ready within {timeout_seconds} seconds: '
+        f'{last_error}')
+
+
+def _normalized_path_text(value: str | None) -> str:
+    if not value:
+        return ''
+    return str(Path(value).expanduser().resolve())
+
+
+def _state_matches_requested(state: dict[str, Any] | None,
+                             browser_binary: str | None,
+                             user_data_dir: str | None,
+                             remote_debugging_port: int) -> bool:
+    if not state:
+        return False
+    if browser_binary:
+        if (_normalized_path_text(state.get('browser_binary')) !=
+                _normalized_path_text(browser_binary)):
+            return False
+    if user_data_dir:
+        if (_normalized_path_text(state.get('user_data_dir')) !=
+                _normalized_path_text(user_data_dir)):
+            return False
+    if remote_debugging_port:
+        if int(state.get('remote_debugging_port') or 0) != int(
+                remote_debugging_port):
+            return False
+    return True
+
+
+def daemon_request(path: str,
+                   method: str = 'GET',
+                   body: dict[str, Any] | None = None,
+                   autostart: bool = True,
+                   timeout: float = 60.0) -> Any:
+    state = common.load_state()
+    if autostart and not daemon_is_healthy(state):
+        state = start_daemon()
+    if not state or not daemon_is_healthy(state):
+        raise common.BrowserctlError('browserd is not running.')
+    return common.json_request(
+        common.daemon_url(state, path),
+        method=method,
+        body=body,
+        headers=_daemon_headers(state),
+        timeout=timeout,
+    )
+
+
+def stop_daemon(wait_seconds: float = 10.0) -> dict[str, Any]:
+    state = common.load_state()
+    if not state:
+        return {'ok': True, 'message': 'browserd is not running.'}
+    shutdown_error: str | None = None
+    try:
+        daemon_request('/shutdown',
+                       method='POST',
+                       body={},
+                       autostart=False,
+                       timeout=10.0)
+    except common.BrowserctlError as exc:
+        shutdown_error = str(exc)
+    finally:
+        deadline = time.time() + wait_seconds
+        while time.time() < deadline:
+            if not common.STATE_FILE.exists():
+                break
+            time.sleep(0.2)
+        common.clear_state()
+    if shutdown_error:
+        return {
+            'ok': True,
+            'message': 'Cleared stale browserd state.',
+            'detail': shutdown_error,
+        }
+    return {'ok': True}
+
+
+def start_daemon(browser_binary: str | None = None,
+                 user_data_dir: str | None = None,
+                 remote_debugging_port: int = 0) -> dict[str, Any]:
+    state = common.load_state()
+    if daemon_is_healthy(state):
+        if _state_matches_requested(state, browser_binary, user_data_dir,
+                                    remote_debugging_port):
+            return state
+        stop_daemon()
+
+    common.clear_state()
+    common.ensure_runtime_dir()
+    command = [sys.executable, str(_BROWSERD_PATH), 'serve']
+    if browser_binary:
+        command.extend(['--browser-binary', browser_binary])
+    if user_data_dir:
+        command.extend(['--user-data-dir', user_data_dir])
+    if remote_debugging_port:
+        command.extend(['--remote-debugging-port', str(remote_debugging_port)])
+
+    creationflags = 0
+    if sys.platform == 'win32':
+        creationflags |= getattr(subprocess, 'DETACHED_PROCESS', 0)
+        creationflags |= getattr(subprocess, 'CREATE_NEW_PROCESS_GROUP', 0)
+
+    with open(common.LOG_FILE, 'ab') as log_file:
+        subprocess.Popen(
+            command,
+            cwd=str(common.REPO_ROOT),
+            stdout=log_file,
+            stderr=log_file,
+            creationflags=creationflags,
+        )
+    return wait_for_daemon_ready()
+
+
+class BrowserctlClient:
+    """Thin Python client for browserd."""
+
+    def __init__(self,
+                 browser_binary: str | None = None,
+                 user_data_dir: str | None = None,
+                 remote_debugging_port: int = 0):
+        self.browser_binary = browser_binary or str(common.DEFAULT_BROWSER_BINARY)
+        self.user_data_dir = user_data_dir or str(common.DEFAULT_PROFILE_DIR)
+        self.remote_debugging_port = int(remote_debugging_port or 0)
+
+    def _ensure_state(self) -> dict[str, Any]:
+        state = common.load_state()
+        if (daemon_is_healthy(state) and
+                _state_matches_requested(state, self.browser_binary,
+                                         self.user_data_dir,
+                                         self.remote_debugging_port)):
+            return state
+        return start_daemon(self.browser_binary, self.user_data_dir,
+                            self.remote_debugging_port)
+
+    def _request(self,
+                 path: str,
+                 method: str = 'GET',
+                 body: dict[str, Any] | None = None,
+                 timeout: float = 60.0) -> Any:
+        state = self._ensure_state()
+        return common.json_request(
+            common.daemon_url(state, path),
+            method=method,
+            body=body,
+            headers=_daemon_headers(state),
+            timeout=timeout,
+        )
+
