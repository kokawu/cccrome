+
+from __future__ import annotations
+
+import argparse
+import base64
+import ctypes
+import json
+import subprocess
+import sys
+import tempfile
+import time
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+try:
+    from mcp.server import fastmcp
+except ModuleNotFoundError:
+    class _FallbackMCP:
+        def __init__(self, _name: str):
+            self._name = _name
+
+        def tool(self, name: str):
+            def decorator(func):
+                return func
+
+            return decorator
+
+        def run(self) -> None:
+            raise RuntimeError(
+                'Run this server with vpython3, or install the mcp package.')
+
+    class _FallbackFastMCP:
+        @staticmethod
+        def FastMCP(name: str) -> _FallbackMCP:
+            return _FallbackMCP(name)
+
+    fastmcp = _FallbackFastMCP()
+
+if sys.platform != 'win32':
+    raise RuntimeError('browser-control only supports Windows right now.')
+
+try:
+    ctypes.windll.shcore.SetProcessDpiAwareness(2)
+except Exception:
+    try:
+        ctypes.windll.user32.SetProcessDPIAware()
+    except Exception:
+        pass
+
+mcp = fastmcp.FastMCP('browser_control')
+
+_REPO_ROOT = Path(__file__).resolve().parents[3]
+_SCREENSHOT_DIR = _REPO_ROOT / 'out' / 'agent_browser'
+_SCREENSHOT_DIR.mkdir(parents=True, exist_ok=True)
+
+_ULONG_PTR = ctypes.c_ulonglong if ctypes.sizeof(ctypes.c_void_p) == 8 else ctypes.c_ulong
+_WHEEL_DELTA = 120
+_PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
+
+_INPUT_MOUSE = 0
+_INPUT_KEYBOARD = 1
+
+_KEYEVENTF_KEYUP = 0x0002
+_KEYEVENTF_UNICODE = 0x0004
+
+_MOUSEEVENTF_LEFTDOWN = 0x0002
+_MOUSEEVENTF_LEFTUP = 0x0004
+_MOUSEEVENTF_RIGHTDOWN = 0x0008
+_MOUSEEVENTF_RIGHTUP = 0x0010
+_MOUSEEVENTF_MIDDLEDOWN = 0x0020
+_MOUSEEVENTF_MIDDLEUP = 0x0040
+_MOUSEEVENTF_WHEEL = 0x0800
+_MOUSEEVENTF_HWHEEL = 0x1000
+
+_GWL_EXSTYLE = -20
+_SW_RESTORE = 9
+_SWP_NOMOVE = 0x0002
+_SWP_NOSIZE = 0x0001
+_SWP_SHOWWINDOW = 0x0040
+_WS_EX_TOOLWINDOW = 0x00000080
+_HWND_TOPMOST = -1
+_HWND_NOTOPMOST = -2
+
+_VK_CODES = {
+    'alt': 0x12,
+    'backspace': 0x08,
+    'ctrl': 0x11,
+    'delete': 0x2E,
+    'down': 0x28,
+    'end': 0x23,
+    'enter': 0x0D,
+    'esc': 0x1B,
+    'escape': 0x1B,
+    'home': 0x24,
+    'left': 0x25,
+    'pagedown': 0x22,
+    'pageup': 0x21,
+    'right': 0x27,
+    'shift': 0x10,
+    'space': 0x20,
+    'tab': 0x09,
+    'up': 0x26,
+    'win': 0x5B,
+}
+
+for _number in range(10):
+    _VK_CODES[str(_number)] = 0x30 + _number
+for _offset, _letter in enumerate('abcdefghijklmnopqrstuvwxyz'):
+    _VK_CODES[_letter] = 0x41 + _offset
+for _fn in range(1, 13):
+    _VK_CODES[f'f{_fn}'] = 0x6F + _fn
+
+
+class _RECT(ctypes.Structure):
+    _fields_ = [('left', ctypes.c_long), ('top', ctypes.c_long),
+                ('right', ctypes.c_long), ('bottom', ctypes.c_long)]
+
+
+class _MOUSEINPUT(ctypes.Structure):
+    _fields_ = [('dx', ctypes.c_long), ('dy', ctypes.c_long),
+                ('mouseData', ctypes.c_ulong), ('dwFlags', ctypes.c_ulong),
+                ('time', ctypes.c_ulong), ('dwExtraInfo', _ULONG_PTR)]
+
+
+class _KEYBDINPUT(ctypes.Structure):
+    _fields_ = [('wVk', ctypes.c_ushort), ('wScan', ctypes.c_ushort),
+                ('dwFlags', ctypes.c_ulong), ('time', ctypes.c_ulong),
+                ('dwExtraInfo', _ULONG_PTR)]
+
+
+class _HARDWAREINPUT(ctypes.Structure):
+    _fields_ = [('uMsg', ctypes.c_ulong), ('wParamL', ctypes.c_short),
+                ('wParamH', ctypes.c_ushort)]
+
+
+class _INPUT_UNION(ctypes.Union):
+    _fields_ = [('mi', _MOUSEINPUT), ('ki', _KEYBDINPUT), ('hi',
+                                                            _HARDWAREINPUT)]
+
+
+class _INPUT(ctypes.Structure):
+    _anonymous_ = ('union',)
+    _fields_ = [('type', ctypes.c_ulong), ('union', _INPUT_UNION)]
+
+
+_user32 = ctypes.windll.user32
+_kernel32 = ctypes.windll.kernel32
+
+
+class BrowserControlError(RuntimeError):
+    """Raised when a browser control operation fails."""
+
+
+@dataclass
+class WindowInfo:
+    hwnd: int
+    pid: int
+    process_name: str
+    title: str
+    left: int
+    top: int
+    width: int
+    height: int
+    foreground: bool
+
+    def to_json(self) -> dict[str, Any]:
+        return {
+            'hwnd': hex(self.hwnd),
+            'pid': self.pid,
+            'process_name': self.process_name,
+            'title': self.title,
+            'foreground': self.foreground,
+            'bounds': {
+                'left': self.left,
+                'top': self.top,
+                'width': self.width,
+                'height': self.height,
+            },
+        }
+
+
+@dataclass
+class SessionState:
+    last_hwnd: int | None = None
+    last_process_name: str = 'chrome.exe'
+    last_screenshot_path: str | None = None
+    screenshot_dir: Path = field(default_factory=lambda: _SCREENSHOT_DIR)
+
+
+_STATE = SessionState()
+
+
+def _check_zero(result: int, func_name: str) -> None:
+    if result == 0:
+        raise BrowserControlError(f'{func_name} failed.')
+
+
+def _sleep(milliseconds: int) -> None:
+    time.sleep(max(0, milliseconds) / 1000.0)
+
+
+def _normalize_process_name(process_name: str) -> str:
+    normalized = process_name.strip().lower()
+    if not normalized:
+        return 'chrome.exe'
+    return normalized
+
+
+def _powershell_quote(value: str) -> str:
+    return "'" + value.replace("'", "''") + "'"
+
+
+def _run_powershell(script: str) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        ['powershell', '-NoProfile', '-Command', script],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+
+
+def _query_process_name(pid: int) -> str | None:
+    process = _kernel32.OpenProcess(_PROCESS_QUERY_LIMITED_INFORMATION, False,
+                                    pid)
+    if not process:
+        return None
+    try:
+        size = ctypes.c_ulong(32768)
+        buffer = ctypes.create_unicode_buffer(size.value)
+        ok = _kernel32.QueryFullProcessImageNameW(process, 0, buffer,
+                                                  ctypes.byref(size))
+        if not ok:
+            return None
+        return Path(buffer.value).name.lower()
+    finally:
+        _kernel32.CloseHandle(process)
+
+
+def _window_info_from_hwnd(hwnd: int) -> WindowInfo:
+    pid = ctypes.c_ulong()
+    _user32.GetWindowThreadProcessId(hwnd, ctypes.byref(pid))
+    process_name = _query_process_name(pid.value)
+    if not process_name:
+        raise BrowserControlError(
+            f'Could not resolve process name for window {hex(int(hwnd))}.')
+    rect = _get_window_rect(hwnd)
+    return WindowInfo(
+        hwnd=int(hwnd),
+        pid=int(pid.value),
+        process_name=process_name,
+        title=_get_window_text(hwnd),
+        left=int(rect.left),
+        top=int(rect.top),
+        width=int(rect.right - rect.left),
+        height=int(rect.bottom - rect.top),
+        foreground=int(hwnd) == int(_user32.GetForegroundWindow()),
+    )
+
+
+def _get_window_rect(hwnd: int) -> _RECT:
+    rect = _RECT()
+    _check_zero(_user32.GetWindowRect(hwnd, ctypes.byref(rect)),
+                'GetWindowRect')
+    return rect
+
+
+def _is_window_candidate(hwnd: int) -> bool:
+    if not _user32.IsWindowVisible(hwnd):
+        return False
+    if _user32.IsIconic(hwnd):
+        return False
+    if _user32.GetWindowLongW(hwnd, _GWL_EXSTYLE) & _WS_EX_TOOLWINDOW:
+        return False
+    rect = _get_window_rect(hwnd)
+    if rect.right <= rect.left or rect.bottom <= rect.top:
+        return False
+    if _user32.GetWindowTextLengthW(hwnd) <= 0:
+        return False
+    return True
+
+
+def _get_window_text(hwnd: int) -> str:
+    length = _user32.GetWindowTextLengthW(hwnd)
+    buffer = ctypes.create_unicode_buffer(length + 1)
+    _user32.GetWindowTextW(hwnd, buffer, len(buffer))
+    return buffer.value
+
+
+def _enumerate_windows(process_name: str,
+                       target_pid: int | None = None) -> list[WindowInfo]:
+    target_process = _normalize_process_name(process_name)
+    windows: list[WindowInfo] = []
+    foreground_hwnd = _user32.GetForegroundWindow()
+    enum_proc = ctypes.WINFUNCTYPE(ctypes.c_bool, ctypes.c_void_p,
+                                   ctypes.c_void_p)
+
+    @enum_proc
+    def callback(hwnd: int, _lparam: int) -> bool:
+        try:
+            if not _is_window_candidate(hwnd):
+                return True
+            window = _window_info_from_hwnd(hwnd)
+            if target_pid is not None and int(window.pid) != int(target_pid):
+                return True
+            if window.process_name != target_process:
+                return True
+            window.foreground = window.hwnd == int(foreground_hwnd)
+            windows.append(window)
+            return True
+        except BrowserControlError:
+            return True
+
+    _check_zero(_user32.EnumWindows(callback, 0), 'EnumWindows')
+    windows.sort(key=lambda item: (not item.foreground, item.title.lower()))
+    return windows
+
+
+def _resolve_window(window_title_substring: str,
+                    process_name: str,
+                    target_pid: int | None = None) -> WindowInfo:
+    normalized_process_name = _normalize_process_name(process_name)
+
+    if _STATE.last_hwnd and not window_title_substring:
+        if _user32.IsWindow(_STATE.last_hwnd):
+            window = _window_info_from_hwnd(_STATE.last_hwnd)
+            if (window.process_name == normalized_process_name and
+                    (target_pid is None or int(window.pid) == int(target_pid))):
+                return window
+
+    candidates = _enumerate_windows(normalized_process_name, target_pid)
+    if window_title_substring:
+        needle = window_title_substring.lower()
+        candidates = [
+            window for window in candidates if needle in window.title.lower()
+        ]
+    if not candidates:
+        if target_pid is not None:
+            raise BrowserControlError(
+                f'No visible window found for pid {target_pid}.')
+        raise BrowserControlError(
+            f'No visible window found for {normalized_process_name}.')
+
+    selected = candidates[0]
+    _STATE.last_hwnd = selected.hwnd
+    _STATE.last_process_name = normalized_process_name
+    return selected
+
+
+def _bring_window_to_front(hwnd: int) -> None:
+    pid = ctypes.c_ulong()
+    _user32.GetWindowThreadProcessId(hwnd, ctypes.byref(pid))
+    _user32.ShowWindow(hwnd, _SW_RESTORE)
+    _user32.SetWindowPos(hwnd, _HWND_TOPMOST, 0, 0, 0, 0,
+                         _SWP_NOMOVE | _SWP_NOSIZE | _SWP_SHOWWINDOW)
+    _user32.SetWindowPos(hwnd, _HWND_NOTOPMOST, 0, 0, 0, 0,
+                         _SWP_NOMOVE | _SWP_NOSIZE | _SWP_SHOWWINDOW)
+    _user32.BringWindowToTop(hwnd)
+    _user32.keybd_event(_VK_CODES['alt'], 0, 0, 0)
+    _user32.keybd_event(_VK_CODES['alt'], 0, _KEYEVENTF_KEYUP, 0)
+    _user32.SetForegroundWindow(hwnd)
+    _sleep(120)
+    if _user32.GetForegroundWindow() == hwnd:
+        return
+
+    script = (
+        '$ws = New-Object -ComObject WScript.Shell;'
+        f' [void]$ws.AppActivate({int(pid.value)})')
+    subprocess.run(
+        ['powershell', '-NoProfile', '-Command', script],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    _sleep(200)
+
+
+def _move_window(hwnd: int, left: int, top: int, width: int,
+                 height: int) -> None:
+    _check_zero(_user32.MoveWindow(int(hwnd), int(left), int(top), int(width),
+                                   int(height), True), 'MoveWindow')
+    _sleep(120)
+
+
+def _screen_point(window: WindowInfo, x: int, y: int) -> tuple[int, int]:
+    return (window.left + int(x), window.top + int(y))
+
+
+def _set_cursor_position(x: int, y: int) -> None:
+    _check_zero(_user32.SetCursorPos(int(x), int(y)), 'SetCursorPos')
+
+
+def _mouse_click(button: str, clicks: int) -> None:
+    button_name = button.strip().lower()
+    if button_name == 'left':
+        down_flag, up_flag = _MOUSEEVENTF_LEFTDOWN, _MOUSEEVENTF_LEFTUP
+    elif button_name == 'right':
+        down_flag, up_flag = _MOUSEEVENTF_RIGHTDOWN, _MOUSEEVENTF_RIGHTUP
+    elif button_name == 'middle':
+        down_flag, up_flag = _MOUSEEVENTF_MIDDLEDOWN, _MOUSEEVENTF_MIDDLEUP
+    else:
+        raise BrowserControlError(
+            'button must be one of left, right, middle.')
+
+    for _ in range(max(1, clicks)):
+        _user32.mouse_event(down_flag, 0, 0, 0, 0)
+        _sleep(20)
+        _user32.mouse_event(up_flag, 0, 0, 0, 0)
+        _sleep(60)
+
+
+def _send_input(inputs: list[_INPUT]) -> None:
+    if not inputs:
+        return
+    array_type = _INPUT * len(inputs)
+    array = array_type(*inputs)
+    sent = _user32.SendInput(len(inputs), ctypes.byref(array),
+                             ctypes.sizeof(_INPUT))
+    if sent != len(inputs):
+        raise BrowserControlError('SendInput failed.')
+
+
+def _key_input(vk: int, flags: int = 0) -> _INPUT:
+    return _INPUT(type=_INPUT_KEYBOARD,
+                  ki=_KEYBDINPUT(wVk=vk,
+                                 wScan=0,
+                                 dwFlags=flags,
+                                 time=0,
+                                 dwExtraInfo=0))
+
+
+def _unicode_key_input(scan_code: int, flags: int = 0) -> _INPUT:
+    return _INPUT(type=_INPUT_KEYBOARD,
+                  ki=_KEYBDINPUT(wVk=0,
+                                 wScan=scan_code,
+                                 dwFlags=flags | _KEYEVENTF_UNICODE,
+                                 time=0,
+                                 dwExtraInfo=0))
+
+
+def _tap_virtual_key(vk: int) -> None:
+    _send_input([_key_input(vk), _key_input(vk, _KEYEVENTF_KEYUP)])
+
+
+def _type_unicode_text(text: str) -> None:
+    utf16 = text.encode('utf-16-le')
+    inputs: list[_INPUT] = []
+    for index in range(0, len(utf16), 2):
+        scan_code = int.from_bytes(utf16[index:index + 2], 'little')
+        inputs.append(_unicode_key_input(scan_code))
+        inputs.append(_unicode_key_input(scan_code, _KEYEVENTF_KEYUP))
+    _send_input(inputs)
+
+
+def _parse_key_combo(keys: str) -> list[int]:
+    parts = [part.strip().lower() for part in keys.split('+') if part.strip()]
+    if not parts:
+        raise BrowserControlError('keys cannot be empty.')
+
+    resolved: list[int] = []
+    for part in parts:
+        if part not in _VK_CODES:
+            raise BrowserControlError(f'Unsupported key name: {part}')
+        resolved.append(_VK_CODES[part])
+    return resolved
+
+
+def _press_key_combo(keys: str) -> None:
+    resolved = _parse_key_combo(keys)
+    modifiers = resolved[:-1]
+    main_key = resolved[-1]
+    inputs = [_key_input(vk) for vk in modifiers]
+    inputs.append(_key_input(main_key))
+    inputs.append(_key_input(main_key, _KEYEVENTF_KEYUP))
+    for vk in reversed(modifiers):
+        inputs.append(_key_input(vk, _KEYEVENTF_KEYUP))
+    _send_input(inputs)
+
+
+def _capture_window(window: WindowInfo) -> str:
+    file_path = _STATE.screenshot_dir / (
+        f'window_{window.pid}_{int(time.time() * 1000)}.png')
+    script = f"""
+$ErrorActionPreference = 'Stop'
+Add-Type -AssemblyName System.Drawing
+Add-Type -AssemblyName System.Windows.Forms
+$bitmap = New-Object System.Drawing.Bitmap({window.width}, {window.height})
+$graphics = [System.Drawing.Graphics]::FromImage($bitmap)
+$graphics.CopyFromScreen({window.left}, {window.top}, 0, 0, $bitmap.Size)
+$bitmap.Save({_powershell_quote(str(file_path))},
+  [System.Drawing.Imaging.ImageFormat]::Png)
+$graphics.Dispose()
+$bitmap.Dispose()
+"""
+    _run_powershell(script)
+    _STATE.last_screenshot_path = str(file_path)
+    return str(file_path)
+
+
+def _get_clipboard_text_base64() -> str | None:
+    result = _run_powershell(r"""
+try {
+  $value = Get-Clipboard -Raw
+  if ($null -ne $value) {
+    [Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes([string]$value))
+  }
+} catch {
+}
+""")
+    data = result.stdout.strip()
+    return data or None
+
+
+def _set_clipboard_text_base64(base64_text: str) -> None:
+    script = (
+        '$value = [System.Text.Encoding]::UTF8.GetString('
+        f'[System.Convert]::FromBase64String({_powershell_quote(base64_text)}));'
+        ' Set-Clipboard -Value $value')
+    _run_powershell(script)
+
+
+def _paste_text_via_clipboard(text: str) -> None:
+    previous_text_base64 = None
+    try:
+        previous_text_base64 = _get_clipboard_text_base64()
+    except subprocess.CalledProcessError:
+        previous_text_base64 = None
+
+    new_text_base64 = base64.b64encode(text.encode('utf-8')).decode('ascii')
+    _set_clipboard_text_base64(new_text_base64)
+    _sleep(50)
+    _press_key_combo('ctrl+v')
+    _sleep(80)
+    if previous_text_base64 is not None:
+        _set_clipboard_text_base64(previous_text_base64)
+
+
+def _action_result(action: str, window: WindowInfo,
+                   extra: dict[str, Any] | None = None) -> dict[str, Any]:
+    result = {
+        'action': action,
+        'window': window.to_json(),
+        'observed_screenshot_path': _STATE.last_screenshot_path,
+        'timestamp': time.time(),
+    }
+    if extra:
+        result.update(extra)
+    return result
+
+
+@mcp.tool(name='list_browser_windows')
+def list_browser_windows(process_name: str = 'chrome.exe',
+                         target_pid: int = 0) -> list[dict[str, Any]]:
+    """Lists visible top-level browser windows. Use this when you need to pick
+    a specific Chrome window before calling observe_browser."""
+    return [
+        window.to_json()
+        for window in _enumerate_windows(process_name,
+                                         target_pid or None)
+    ]
+
+
+@mcp.tool(name='observe_browser')
+def observe_browser(window_title_substring: str = '',
+                    process_name: str = 'chrome.exe',
+                    activate: bool = True,
+                    target_pid: int = 0) -> dict[str, Any]:
+    """Captures a screenshot of a visible Chrome window and selects it as the
+    active target for later actions.
+
+    Coordinates used by click_browser, drag_browser, and scroll_browser are
+    always relative to the top-left corner of this returned screenshot.
+    Call this before any point-and-click action.
+    """
+    window = _resolve_window(window_title_substring, process_name,
+                             target_pid or None)
+    if activate:
+        _bring_window_to_front(window.hwnd)
+        window = _resolve_window(window_title_substring, process_name,
+                                 target_pid or None)
+    screenshot_path = _capture_window(window)
+    return {
+        'window': window.to_json(),
+        'screenshot_path': screenshot_path,
+        'coordinate_space':
+        'window-relative pixels from the top-left of screenshot_path',
+        'note': 'If another app covers the browser, the screenshot will reflect'
+        ' the real screen, just like a human would see.',
+    }
+
+
+@mcp.tool(name='focus_browser_window')
+def focus_browser_window(window_title_substring: str = '',
+                         process_name: str = 'chrome.exe',
+                         target_pid: int = 0) -> dict[str, Any]:
+    """Brings a visible Chrome window to the foreground and returns the final
+    resolved window metadata."""
+    window = _resolve_window(window_title_substring, process_name,
+                             target_pid or None)
+    _bring_window_to_front(window.hwnd)
+    window = _resolve_window(window_title_substring, process_name,
+                             target_pid or None)
+    return _action_result('focus_browser_window', window)
+
+
+@mcp.tool(name='set_browser_window_bounds')
+def set_browser_window_bounds(left: int = -1,
+                              top: int = -1,
+                              width: int = -1,
+                              height: int = -1,
+                              activate: bool = True,
+                              window_title_substring: str = '',
+                              process_name: str = 'chrome.exe',
+                              target_pid: int = 0) -> dict[str, Any]:
+    """Moves or resizes a visible Chrome window. Any negative value keeps the
+    current value for that field."""
+    window = _resolve_window(window_title_substring, process_name,
+                             target_pid or None)
+    next_left = window.left if left < 0 else int(left)
+    next_top = window.top if top < 0 else int(top)
+    next_width = window.width if width < 0 else int(width)
+    next_height = window.height if height < 0 else int(height)
+    if next_width <= 0 or next_height <= 0:
+        raise BrowserControlError('width and height must be greater than zero.')
+    _move_window(window.hwnd, next_left, next_top, next_width, next_height)
+    if activate:
+        _bring_window_to_front(window.hwnd)
+    window = _resolve_window(window_title_substring, process_name,
+                             target_pid or None)
+    return _action_result(
+        'set_browser_window_bounds',
+        window,
+        {
+            'requested_bounds': {
+                'left': next_left,
+                'top': next_top,
+                'width': next_width,
+                'height': next_height,
+            },
+        },
+    )
+
+
+@mcp.tool(name='click_browser')
+def click_browser(x: int,
+                  y: int,
+                  button: str = 'left',
+                  clicks: int = 1,
+                  window_title_substring: str = '',
+                  process_name: str = 'chrome.exe',
+                  target_pid: int = 0) -> dict[str, Any]:
+    """Clicks inside a visible Chrome window using window-relative
+    coordinates from observe_browser."""
+    window = _resolve_window(window_title_substring, process_name,
+                             target_pid or None)
+    _bring_window_to_front(window.hwnd)
+    screen_x, screen_y = _screen_point(window, x, y)
+    _set_cursor_position(screen_x, screen_y)
+    _sleep(30)
+    _mouse_click(button, clicks)
+    return _action_result(
+        'click_browser',
+        window,
+        {
+            'button': button,
+            'clicks': clicks,
+            'window_point': {
+                'x': x,
+                'y': y,
+            },
+            'screen_point': {
+                'x': screen_x,
+                'y': screen_y,
+            },
+        },
+    )
+
+
+@mcp.tool(name='drag_browser')
+def drag_browser(start_x: int,
+                 start_y: int,
+                 end_x: int,
+                 end_y: int,
+                 duration_ms: int = 400,
+                 window_title_substring: str = '',
+                 process_name: str = 'chrome.exe',
+                 target_pid: int = 0) -> dict[str, Any]:
+    """Performs a left-button drag inside a visible Chrome window using
+    window-relative coordinates from observe_browser."""
+    window = _resolve_window(window_title_substring, process_name,
+                             target_pid or None)
+    _bring_window_to_front(window.hwnd)
+    start_screen_x, start_screen_y = _screen_point(window, start_x, start_y)
+    end_screen_x, end_screen_y = _screen_point(window, end_x, end_y)
+    _set_cursor_position(start_screen_x, start_screen_y)
+    _sleep(30)
+    _user32.mouse_event(_MOUSEEVENTF_LEFTDOWN, 0, 0, 0, 0)
+    steps = max(8, duration_ms // 16)
+    for step in range(1, steps + 1):
+        progress = step / steps
+        current_x = round(start_screen_x +
+                          (end_screen_x - start_screen_x) * progress)
+        current_y = round(start_screen_y +
+                          (end_screen_y - start_screen_y) * progress)
+        _set_cursor_position(current_x, current_y)
+        _sleep(duration_ms // steps)
+    _user32.mouse_event(_MOUSEEVENTF_LEFTUP, 0, 0, 0, 0)
+    return _action_result(
+        'drag_browser',
+        window,
+        {
+            'start_window_point': {
+                'x': start_x,
+                'y': start_y,
+            },
+            'end_window_point': {
+                'x': end_x,
+                'y': end_y,
+            },
+        },
+    )
+
+
+@mcp.tool(name='scroll_browser')
+def scroll_browser(x: int,
+                   y: int,
+                   notches_y: int,
+                   notches_x: int = 0,
+                   window_title_substring: str = '',
+                   process_name: str = 'chrome.exe',
+                   target_pid: int = 0) -> dict[str, Any]:
+    """Scrolls at a point inside a visible Chrome window. One notch equals one
+    mouse wheel step, matching real wheel behavior."""
+    window = _resolve_window(window_title_substring, process_name,
+                             target_pid or None)
+    _bring_window_to_front(window.hwnd)
+    screen_x, screen_y = _screen_point(window, x, y)
+    _set_cursor_position(screen_x, screen_y)
+    if notches_y:
+        _user32.mouse_event(_MOUSEEVENTF_WHEEL, 0, 0,
+                            notches_y * _WHEEL_DELTA, 0)
+    if notches_x:
+        _user32.mouse_event(_MOUSEEVENTF_HWHEEL, 0, 0,
+                            notches_x * _WHEEL_DELTA, 0)
+    return _action_result(
+        'scroll_browser',
+        window,
+        {
+            'window_point': {
+                'x': x,
+                'y': y,
+            },
+            'notches_y': notches_y,
+            'notches_x': notches_x,
+        },
+    )
+
+
+@mcp.tool(name='type_browser_text')
+def type_browser_text(text: str,
+                      press_enter: bool = False,
+                      window_title_substring: str = '',
+                      process_name: str = 'chrome.exe',
+                      target_pid: int = 0) -> dict[str, Any]:
+    """Types Unicode text into the currently focused browser control, just like
+    a user typing on the keyboard."""
+    window = _resolve_window(window_title_substring, process_name,
+                             target_pid or None)
+    _bring_window_to_front(window.hwnd)
+    if text:
+        try:
+            _paste_text_via_clipboard(text)
+        except subprocess.CalledProcessError:
+            _type_unicode_text(text)
+    if press_enter:
+        _tap_virtual_key(_VK_CODES['enter'])
+    return _action_result(
+        'type_browser_text',
+        window,
+        {
+            'text_length': len(text),
+            'press_enter': press_enter,
+        },
+    )
+
+
+@mcp.tool(name='press_browser_keys')
+def press_browser_keys(keys: str,
+                       window_title_substring: str = '',
+                       process_name: str = 'chrome.exe',
+                       target_pid: int = 0) -> dict[str, Any]:
+    """Presses a key or key combination such as CTRL+L, CTRL+TAB, ALT+LEFT,
+    ENTER, or ESC inside the selected browser window."""
+    window = _resolve_window(window_title_substring, process_name,
+                             target_pid or None)
+    _bring_window_to_front(window.hwnd)
+    _press_key_combo(keys)
+    return _action_result('press_browser_keys', window, {'keys': keys})
+
+
+@mcp.tool(name='open_url_in_browser')
+def open_url_in_browser(url: str,
+                        window_title_substring: str = '',
+                        process_name: str = 'chrome.exe',
+                        target_pid: int = 0) -> dict[str, Any]:
+    """Navigates the selected Chrome window to a URL by focusing the omnibox
+    with CTRL+L, typing the URL, and pressing ENTER."""
+    window = _resolve_window(window_title_substring, process_name,
+                             target_pid or None)
+    _bring_window_to_front(window.hwnd)
+    _press_key_combo('ctrl+l')
+    _sleep(80)
+    _type_unicode_text(url)
+    _tap_virtual_key(_VK_CODES['enter'])
+    return _action_result('open_url_in_browser', window, {'url': url})
+
+
+@mcp.tool(name='wait_for_browser')
+def wait_for_browser(milliseconds: int = 500) -> dict[str, Any]:
+    """Sleeps briefly between browser actions. Use this if a page needs a short
+    moment to react before the next observe_browser call."""
+    _sleep(milliseconds)
+    return {'waited_ms': milliseconds, 'timestamp': time.time()}
+
+
+def _run_self_test() -> int:
+    try:
+        windows = list_browser_windows()
+        result: dict[str, Any] = {'windows': windows[:5]}
+        if windows:
+            result['observe'] = observe_browser()
+        print(json.dumps(result, ensure_ascii=False, indent=2))
+        return 0
+    except Exception as exc:  # pragma: no cover - debugging aid
+        print(json.dumps({'error': str(exc)}, ensure_ascii=False), file=sys.stderr)
+        return 1
+
+
+def _run_list_windows() -> int:
+    try:
+        print(json.dumps(list_browser_windows(), ensure_ascii=False, indent=2))
+        return 0
+    except Exception as exc:  # pragma: no cover - debugging aid
+        print(json.dumps({'error': str(exc)}, ensure_ascii=False), file=sys.stderr)
+        return 1
+
+
+def _main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--self-test',
+                        action='store_true',
+                        help='List browser windows and try one observe step.')
+    parser.add_argument('--list-windows',
+                        action='store_true',
+                        help='Print visible browser windows as JSON and exit.')
+    args = parser.parse_args()
+
+    if args.self_test:
+        return _run_self_test()
+    if args.list_windows:
+        return _run_list_windows()
+
+    mcp.run()
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(_main())
