+
+  int update_count = 0;
+  int completion_count = 0;
+  DWORD completion_key_state = 0;
+  drag_source->set_drag_updated_callback(
+      base::BindLambdaForTesting([&](DWORD /*key_state*/) { ++update_count; }));
+  drag_source->set_drag_completed_callback(
+      base::BindLambdaForTesting([&](DWORD key_state) {
+        ++completion_count;
+        completion_key_state = key_state;
+      }));
+
+  EXPECT_EQ(DRAGDROP_S_DROP,
+            drag_source->QueryContinueDrag(/*escape_pressed=*/FALSE,
+                                           /*key_state=*/0));
+  EXPECT_EQ(1, update_count);
+  EXPECT_EQ(1, completion_count);
+  EXPECT_EQ(0u, completion_key_state);
+}
+
+TEST(DragSourceWinTest, QueryContinueDragDoesNotNotifyCompletionOnCancel) {
+  auto drag_source = DragSourceWin::Create();
+  OSExchangeData data;
