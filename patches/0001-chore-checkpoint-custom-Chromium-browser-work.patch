+std::string NormalizeExcludedDomainPattern(std::string entry) {
+  base::TrimWhitespaceASCII(entry, base::TRIM_ALL, &entry);
+  entry = base::ToLowerASCII(entry);
+  if (base::StartsWith(entry, "*.")) {
+    entry.erase(0, 2);
+  }
+  while (!entry.empty() && entry.front() == '.') {
+    entry.erase(entry.begin());
+  }
+  if (entry.find("://") != std::string::npos) {
+    GURL url(entry);
+    if (url.is_valid() && !url.host().empty()) {
+      entry = base::ToLowerASCII(url.host());
+    }
+  }
+  return entry;
+}
+
+bool HostMatchesExcludedPattern(std::string_view host, std::string_view pattern) {
+  if (host.empty() || pattern.empty()) {
+    return false;
+  }
+  if (host == pattern) {
+    return true;
+  }
+  const std::string suffix = "." + std::string(pattern);
+  return base::EndsWith(host, suffix, base::CompareCase::SENSITIVE);
+}
