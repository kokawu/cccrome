+
+bool BrowserMouseGestureController::ExecuteAction(Action action) {
+  Browser* const browser = browser_view_->browser();
+  if (!browser) {
+    return false;
+  }
+  TabStripModel* const model = browser->tab_strip_model();
+  content::WebContents* const active_contents =
+      model ? model->GetActiveWebContents() : nullptr;
+
+  switch (action) {
+    case Action::kUnknown:
+    case Action::kNone:
+      return false;
+    case Action::kBack:
+      if (!chrome::CanGoBack(browser)) {
+        return false;
+      }
+      chrome::GoBack(browser, WindowOpenDisposition::CURRENT_TAB);
+      return true;
+    case Action::kForward:
+      if (!chrome::CanGoForward(browser)) {
+        return false;
+      }
+      chrome::GoForward(browser, WindowOpenDisposition::CURRENT_TAB);
+      return true;
+    case Action::kPreviousTab:
+      chrome::SelectPreviousTab(
+          browser,
+          TabStripUserGestureDetails(TabStripUserGestureDetails::GestureType::kOther));
+      return true;
+    case Action::kNextTab:
+      chrome::SelectNextTab(
+          browser,
+          TabStripUserGestureDetails(TabStripUserGestureDetails::GestureType::kOther));
+      return true;
+    case Action::kFirstTab:
+      chrome::SelectNumberedTab(
+          browser, 0,
+          TabStripUserGestureDetails(TabStripUserGestureDetails::GestureType::kOther));
+      return true;
+    case Action::kLastTab:
+      chrome::SelectLastTab(
+          browser,
+          TabStripUserGestureDetails(TabStripUserGestureDetails::GestureType::kOther));
+      return true;
+    case Action::kCloseTabAndActivateLeft:
+      return CloseTabAndActivateAdjacent(browser, /*activate_left=*/true);
+    case Action::kCloseTabAndActivateRight:
+      return CloseTabAndActivateAdjacent(browser, /*activate_left=*/false);
+    case Action::kCloseTabAndActivateLastVisited:
+      return CloseTabAndActivateContents(
+          browser, GetMostRecentlyFocusedTab(model, model->active_index()));
+    case Action::kCloseTabAndActivateParent: {
+      if (!model || !model->ContainsIndex(model->active_index())) {
+        return false;
+      }
+      tabs::TabInterface* const opener = model->GetOpenerOfTabAt(model->active_index());
+      return CloseTabAndActivateContents(
+          browser, opener ? opener->GetContents() : nullptr);
+    }
+    case Action::kCloseCurrentTab:
+      if (!model || !model->ContainsIndex(model->active_index())) {
+        return false;
+      }
+      chrome::CloseTab(browser);
+      return true;
+    case Action::kCloseAllTabs:
+      if (!model || model->count() == 0) {
+        return false;
+      }
+      model->CloseAllTabs();
+      return true;
+    case Action::kCloseOtherTabs:
+      if (!chrome::CanCloseOtherTabs(browser)) {
+        return false;
+      }
+      chrome::CloseOtherTabs(browser);
+      return true;
+    case Action::kCloseTabsToLeft: {
+      if (!model || !model->ContainsIndex(model->active_index())) {
+        return false;
+      }
+      std::vector<int> indices;
+      for (int index = model->active_index() - 1; index >= 0; --index) {
+        indices.push_back(index);
+      }
+      return CloseTabsByDescendingIndices(model, indices);
+    }
+    case Action::kCloseTabsToRight:
+      if (!chrome::CanCloseTabsToRight(browser)) {
+        return false;
+      }
+      chrome::CloseTabsToRight(browser);
+      return true;
+    case Action::kCloseTabsOpenedByCurrent: {
+      if (!model || !active_contents || !model->ContainsIndex(model->active_index())) {
+        return false;
+      }
+      const int last_index =
+          model->GetIndexOfLastWebContentsOpenedBy(active_contents, model->active_index());
+      if (last_index == TabStripModel::kNoTab) {
+        return false;
+      }
+      std::vector<int> indices;
+      for (int index = last_index; index > model->active_index(); --index) {
+        indices.push_back(index);
+      }
+      return CloseTabsByDescendingIndices(model, indices);
+    }
+    case Action::kStopLoading:
+      if (!active_contents) {
+        return false;
+      }
+      chrome::Stop(browser);
+      return true;
+    case Action::kNewTab:
+      chrome::NewTab(browser);
+      return true;
+    case Action::kNewWindow:
+      chrome::NewWindow(browser);
+      return true;
+    case Action::kNewIncognitoWindow:
+      chrome::NewIncognitoWindow(browser->profile());
+      return true;
+    case Action::kOpenHomepage:
+      chrome::Home(browser, WindowOpenDisposition::CURRENT_TAB);
+      return true;
+    case Action::kCopyUrl:
+      if (!active_contents || !chrome::CanCopyUrl(browser)) {
+        return false;
+      }
+      chrome::CopyURL(browser, active_contents);
+      return true;
+    case Action::kOpenClipboardUrl: {
+      std::u16string clipboard_text;
+      base::RunLoop run_loop;
+      ui::Clipboard::GetForCurrentThread()->ReadText(
+          ui::ClipboardBuffer::kCopyPaste, std::nullopt,
+          base::BindOnce(
+              [](base::RunLoop* run_loop, std::u16string* out,
+                 std::u16string text) {
+                *out = std::move(text);
+                run_loop->Quit();
+              },
+              &run_loop, &clipboard_text));
+      run_loop.Run();
+
+      const std::optional<GURL> url =
+          ClassifyTextToUrl(browser->profile(), clipboard_text);
+      if (!url.has_value()) {
+        return false;
+      }
+
+      NavigateParams params(browser, *url, ui::PAGE_TRANSITION_TYPED);
+      params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+      params.window_action = NavigateParams::WindowAction::kShowWindow;
+      Navigate(&params);
+      return true;
+    }
+    case Action::kScrollPageUp:
+      return ExecuteJavaScriptOnActivePage(
+          browser, u"window.scrollBy(0, -Math.max(window.innerHeight * 0.85, "
+                   u"120));");
+    case Action::kScrollPageDown:
+      return ExecuteJavaScriptOnActivePage(
+          browser, u"window.scrollBy(0, Math.max(window.innerHeight * 0.85, "
+                   u"120));");
+    case Action::kScrollToTop:
+      return ExecuteJavaScriptOnActivePage(browser, u"window.scrollTo(0, 0);");
+    case Action::kScrollToBottom:
+      return ExecuteJavaScriptOnActivePage(
+          browser,
+          u"(() => { const e = document.scrollingElement || "
+          u"document.documentElement || document.body; if (e) "
+          u"window.scrollTo(0, e.scrollHeight); })();");
+    case Action::kReload:
+      if (!chrome::CanReload(browser)) {
+        return false;
+      }
+      chrome::Reload(browser, WindowOpenDisposition::CURRENT_TAB);
+      return true;
+    case Action::kHardReload:
+      if (!chrome::CanReload(browser)) {
+        return false;
+      }
+      chrome::ReloadBypassingCache(browser, WindowOpenDisposition::CURRENT_TAB);
+      return true;
+    case Action::kRestoreClosedTab:
+      chrome::RestoreTab(browser);
+      return true;
+    case Action::kDuplicateTab:
+      if (!chrome::CanDuplicateTab(browser)) {
+        return false;
+      }
+      chrome::DuplicateTab(browser);
+      return true;
+    case Action::kViewSource:
+      if (!chrome::CanViewSource(browser)) {
+        return false;
+      }
+      return chrome::ExecuteCommand(browser, IDC_VIEW_SOURCE);
+    case Action::kToggleFullscreen:
+      chrome::ToggleFullscreenMode(browser, /*user_initiated=*/true);
+      return true;
+    case Action::kToggleMaximize:
+      if (!browser->window()) {
+        return false;
+      }
+      if (browser->window()->IsMaximized()) {
+        browser->window()->Restore();
+      } else {
+        browser->window()->Maximize();
+      }
+      return true;
+    case Action::kMinimizeWindow:
+      if (!browser->window()) {
+        return false;
+      }
+      browser->window()->Minimize();
+      return true;
+    case Action::kBookmarkPage:
+      if (!chrome::CanBookmarkCurrentTab(browser)) {
+        return false;
+      }
+      chrome::BookmarkCurrentTab(browser);
+      return true;
+    case Action::kCloseBrowser:
+      chrome::CloseWindow(browser);
+      return true;
+    case Action::kRestartBrowser:
+      chrome::AttemptRestart();
+      return true;
+    case Action::kViewHistory:
+      return chrome::ExecuteCommand(browser, IDC_SHOW_HISTORY);
+    case Action::kViewDownloads:
+      return chrome::ExecuteCommand(browser, IDC_SHOW_DOWNLOADS);
+    case Action::kOpenExtensions:
+      return chrome::ExecuteCommand(browser, IDC_MANAGE_EXTENSIONS);
+    case Action::kZoomIn:
+      if (!active_contents || !chrome::CanZoomIn(active_contents)) {
+        return false;
+      }
+      chrome::Zoom(browser, content::PAGE_ZOOM_IN);
+      return true;
+    case Action::kZoomOut:
+      if (!active_contents || !chrome::CanZoomOut(active_contents)) {
+        return false;
+      }
+      chrome::Zoom(browser, content::PAGE_ZOOM_OUT);
+      return true;
+    case Action::kZoomReset:
+      if (!active_contents || !chrome::CanResetZoom(active_contents)) {
+        return false;
+      }
+      chrome::Zoom(browser, content::PAGE_ZOOM_RESET);
+      return true;
+    case Action::kToggleBookmarkBar:
+      chrome::ToggleBookmarkBar(browser);
+      return true;
+    case Action::kOpenBookmarkManager:
+      return chrome::ExecuteCommand(browser, IDC_SHOW_BOOKMARK_MANAGER);
+    case Action::kOpenOptions:
+      return chrome::ExecuteCommand(browser, IDC_OPTIONS);
+    case Action::kSimulateLeftKey:
+      return ExecuteJavaScriptOnActivePage(
+          browser,
+          u"(() => { const target = document.activeElement || document.body || "
+          u"document.documentElement || document; const fire = (type) => "
+          u"target.dispatchEvent(new KeyboardEvent(type, {key: 'ArrowLeft', "
+          u"code: 'ArrowLeft', keyCode: 37, which: 37, bubbles: true, "
+          u"cancelable: true})); fire('keydown'); fire('keyup'); })();");
+    case Action::kSimulateRightKey:
+      return ExecuteJavaScriptOnActivePage(
+          browser,
+          u"(() => { const target = document.activeElement || document.body || "
+          u"document.documentElement || document; const fire = (type) => "
+          u"target.dispatchEvent(new KeyboardEvent(type, {key: 'ArrowRight', "
+          u"code: 'ArrowRight', keyCode: 39, which: 39, bubbles: true, "
+          u"cancelable: true})); fire('keydown'); fire('keyup'); })();");
+  }
+  return false;
+}
