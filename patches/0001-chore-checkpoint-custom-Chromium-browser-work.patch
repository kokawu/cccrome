diff --git a/chrome/browser/proxy/cc_proxy_config_service.cc b/chrome/browser/proxy/cc_proxy_config_service.cc
new file mode 100644
index 0000000000..1da69aecec
--- /dev/null
+++ b/chrome/browser/proxy/cc_proxy_config_service.cc
@@ -0,0 +1,159 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/proxy/cc_proxy_config_service.h"
+
+#include <initializer_list>
+#include <string_view>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/values.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/proxy/cc_proxy_pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/proxy_config/proxy_config_dictionary.h"
+#include "components/proxy_config/proxy_config_pref_names.h"
+#include "components/proxy_config/proxy_prefs.h"
+
+namespace cc_proxy {
+namespace {
+
+void AddObservedPrefs(PrefChangeRegistrar& registrar,
+                      base::RepeatingClosure callback,
+                      std::initializer_list<std::string_view> pref_names) {
+  for (std::string_view pref_name : pref_names) {
+    registrar.Add(pref_name, callback);
+  }
+}
+
+base::DictValue BuildProxyConfig(const std::string& mode,
+                                 const std::string& server_rules,
+                                 const std::string& pac_url,
+                                 bool pac_mandatory,
+                                 const std::string& bypass_list) {
+  ProxyPrefs::ProxyMode proxy_mode = ProxyPrefs::MODE_SYSTEM;
+  if (!ProxyPrefs::StringToProxyMode(mode, &proxy_mode)) {
+    proxy_mode = ProxyPrefs::MODE_SYSTEM;
+  }
+
+  switch (proxy_mode) {
+    case ProxyPrefs::MODE_DIRECT:
+      return ProxyConfigDictionary::CreateDirect();
+    case ProxyPrefs::MODE_AUTO_DETECT:
+      return ProxyConfigDictionary::CreateAutoDetect();
+    case ProxyPrefs::MODE_PAC_SCRIPT:
+      return ProxyConfigDictionary::CreatePacScript(pac_url, pac_mandatory);
+    case ProxyPrefs::MODE_FIXED_SERVERS:
+      return ProxyConfigDictionary::CreateFixedServers(server_rules,
+                                                       bypass_list);
+    case ProxyPrefs::MODE_SYSTEM:
+      return ProxyConfigDictionary::CreateSystem();
+    case ProxyPrefs::kModeCount:
+      break;
+  }
+
+  return ProxyConfigDictionary::CreateSystem();
+}
+
+base::DictValue BuildProxyConfigFromPrefs(PrefService* pref_service,
+                                          std::string_view mode_pref,
+                                          std::string_view server_rules_pref,
+                                          std::string_view pac_url_pref,
+                                          std::string_view bypass_list_pref,
+                                          std::string_view pac_mandatory_pref) {
+  CHECK(pref_service);
+  return BuildProxyConfig(pref_service->GetString(mode_pref),
+                          pref_service->GetString(server_rules_pref),
+                          pref_service->GetString(pac_url_pref),
+                          pref_service->GetBoolean(pac_mandatory_pref),
+                          pref_service->GetString(bypass_list_pref));
+}
+
+bool HasMatchingUserProxyPref(PrefService* pref_service,
+                              const base::DictValue& new_value) {
+  CHECK(pref_service);
+  const base::Value* current_user_value =
+      pref_service->GetUserPrefValue(proxy_config::prefs::kProxy);
+  return current_user_value && current_user_value->is_dict() &&
+         current_user_value->GetDict() == new_value;
+}
+
+}  // namespace
+
+CcProxyConfigService::CcProxyConfigService(Profile* profile)
+    : profile_(profile),
+      profile_prefs_(profile ? profile->GetPrefs() : nullptr),
+      local_state_(g_browser_process ? g_browser_process->local_state()
+                                     : nullptr) {
+  CHECK(profile_);
+  CHECK(profile_prefs_);
+  CHECK(local_state_);
+
+  profile_pref_change_registrar_.Init(profile_prefs_);
+  AddObservedPrefs(
+      profile_pref_change_registrar_,
+      base::BindRepeating(&CcProxyConfigService::OnCustomProxyPrefChanged,
+                          base::Unretained(this)),
+      {prefs::kInstanceOverrideEnabled, prefs::kInstanceMode,
+       prefs::kInstanceServerRules, prefs::kInstancePacUrl,
+       prefs::kInstanceBypassList, prefs::kInstancePacMandatory});
+
+  local_state_pref_change_registrar_.Init(local_state_);
+  AddObservedPrefs(
+      local_state_pref_change_registrar_,
+      base::BindRepeating(&CcProxyConfigService::OnCustomProxyPrefChanged,
+                          base::Unretained(this)),
+      {prefs::kDefaultMode, prefs::kDefaultServerRules, prefs::kDefaultPacUrl,
+       prefs::kDefaultBypassList, prefs::kDefaultPacMandatory});
+
+  ApplyEffectiveProxyConfig();
+}
+
+CcProxyConfigService::~CcProxyConfigService() = default;
+
+void CcProxyConfigService::Shutdown() {
+  profile_pref_change_registrar_.RemoveAll();
+  local_state_pref_change_registrar_.RemoveAll();
+  profile_ = nullptr;
+  profile_prefs_ = nullptr;
+  local_state_ = nullptr;
+}
+
+void CcProxyConfigService::OnCustomProxyPrefChanged() {
+  ApplyEffectiveProxyConfig();
+}
+
+void CcProxyConfigService::ApplyEffectiveProxyConfig() {
+  CHECK(profile_prefs_);
+  CHECK(local_state_);
+
+  const bool use_instance_override =
+      profile_prefs_->GetBoolean(prefs::kInstanceOverrideEnabled);
+
+  base::DictValue effective_proxy = use_instance_override
+                                        ? BuildProxyConfigFromPrefs(
+                                              profile_prefs_,
+                                              prefs::kInstanceMode,
+                                              prefs::kInstanceServerRules,
+                                              prefs::kInstancePacUrl,
+                                              prefs::kInstanceBypassList,
+                                              prefs::kInstancePacMandatory)
+                                        : BuildProxyConfigFromPrefs(
+                                              local_state_, prefs::kDefaultMode,
+                                              prefs::kDefaultServerRules,
+                                              prefs::kDefaultPacUrl,
+                                              prefs::kDefaultBypassList,
+                                              prefs::kDefaultPacMandatory);
+
+  if (HasMatchingUserProxyPref(profile_prefs_, effective_proxy)) {
+    return;
+  }
+
+  profile_prefs_->SetDict(proxy_config::prefs::kProxy,
+                          std::move(effective_proxy));
+}
+
+}  // namespace cc_proxy
