+bool CloseTabAndActivateAdjacent(Browser* browser, bool activate_left) {
+  if (!browser) {
+    return false;
+  }
+
+  TabStripModel* const model = browser->tab_strip_model();
+  const int active_index = model->active_index();
+  if (!model->ContainsIndex(active_index)) {
+    return false;
+  }
+
+  content::WebContents* target_contents = nullptr;
+  const int preferred_index = activate_left ? active_index - 1 : active_index + 1;
+  if (model->ContainsIndex(preferred_index)) {
+    target_contents = model->GetWebContentsAt(preferred_index);
+  } else {
+    const int fallback_index = activate_left ? active_index + 1 : active_index - 1;
+    if (model->ContainsIndex(fallback_index)) {
+      target_contents = model->GetWebContentsAt(fallback_index);
+    }
+  }
+
+  model->CloseWebContentsAt(active_index, TabCloseTypes::CLOSE_USER_GESTURE);
+
+  if (target_contents) {
+    const int target_index = model->GetIndexOfWebContents(target_contents);
+    if (model->ContainsIndex(target_index)) {
+      model->ActivateTabAt(target_index);
+    }
+  }
+
+  return true;
+}
