+
+bool BrowserView::ExecutePendingSuperDrag(
+    const content::DropData* drop_data_override) {
+  const std::optional<SuperDragDirection> direction = GetSuperDragDirection();
+  const std::optional<SuperDragState> super_drag_state = super_drag_state_;
+  if (!direction.has_value() || !super_drag_state.has_value()) {
+    return false;
+  }
+
+  const content::DropData& effective_drop_data =
+      [&]() -> const content::DropData& {
+    if (!drop_data_override) {
+      return super_drag_state->drop_data;
+    }
+
+    const std::optional<SuperDragType> drag_type =
+        GetSuperDragType(*drop_data_override);
+    if (drag_type.has_value() && *drag_type == super_drag_state->type) {
+      return *drop_data_override;
+    }
+    return super_drag_state->drop_data;
+  }();
+
+  const std::optional<std::string> action_id =
+      GetConfiguredSuperDragActionId(super_drag_state->type, *direction);
+  if (!action_id.has_value() || *action_id == "none") {
+    return false;
+  }
+
+  if (*action_id == "copy_value") {
+    std::u16string clipboard_text;
+    switch (super_drag_state->type) {
+      case SuperDragType::kLink:
+        if (effective_drop_data.url_infos.empty() ||
+            !effective_drop_data.url_infos.front().url.is_valid()) {
+          return false;
+        }
+        clipboard_text =
+            base::UTF8ToUTF16(effective_drop_data.url_infos.front().url.spec());
+        break;
+      case SuperDragType::kText: {
+        auto search_terms = GetSuperDragSearchTerms(effective_drop_data);
+        if (!search_terms.has_value()) {
+          return false;
+        }
+        clipboard_text = *search_terms;
+        break;
+      }
+      case SuperDragType::kImage: {
+        const GURL image_url = GetSuperDragImageUrl(effective_drop_data);
+        if (!image_url.is_valid()) {
+          return false;
+        }
+        clipboard_text = base::UTF8ToUTF16(image_url.spec());
+        break;
+      }
+    }
+
+    if (clipboard_text.empty()) {
+      return false;
+    }
+    ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste)
+        .WriteText(clipboard_text);
+    return true;
+  }
+
+  GURL target_url;
+  ui::PageTransition transition = ui::PAGE_TRANSITION_LINK;
+
+  switch (super_drag_state->type) {
+    case SuperDragType::kText: {
+      if (*action_id != "search_current_tab" &&
+          *action_id != "search_new_foreground_tab" &&
+          *action_id != "search_new_background_tab") {
+        return false;
+      }
+      auto search_terms = GetSuperDragSearchTerms(effective_drop_data);
+      if (!search_terms.has_value()) {
+        return false;
+      }
+      auto* template_url_service =
+          TemplateURLServiceFactory::GetForProfile(browser_->profile());
+      if (!template_url_service) {
+        return false;
+      }
+      target_url = GetDefaultSearchURLForSearchTerms(template_url_service,
+                                                     *search_terms);
+      transition = ui::PAGE_TRANSITION_GENERATED;
+      break;
+    }
+    case SuperDragType::kImage:
+      target_url = GetSuperDragImageUrl(effective_drop_data);
+      break;
+    case SuperDragType::kLink:
+      if (*action_id != "open_current_tab" &&
+          *action_id != "open_new_foreground_tab" &&
+          *action_id != "open_new_background_tab") {
+        return false;
+      }
+      if (!effective_drop_data.url_infos.empty()) {
+        target_url = effective_drop_data.url_infos.front().url;
+      }
+      break;
+  }
+
+  if (!target_url.is_valid() || target_url.SchemeIs(url::kJavaScriptScheme)) {
+    return false;
+  }
+
+  WindowOpenDisposition disposition = WindowOpenDisposition::CURRENT_TAB;
+  if (*action_id == "open_current_tab" || *action_id == "search_current_tab") {
+    disposition = WindowOpenDisposition::CURRENT_TAB;
+  } else if (*action_id == "open_new_foreground_tab" ||
+             *action_id == "search_new_foreground_tab") {
+    disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  } else if (*action_id == "open_new_background_tab" ||
+             *action_id == "search_new_background_tab") {
+    disposition = WindowOpenDisposition::NEW_BACKGROUND_TAB;
+  } else {
+    return false;
+  }
+
+  NavigateParams params(browser_.get(), target_url, transition);
+  params.disposition = disposition;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  params.source_contents = GetActiveWebContents();
+  Navigate(&params);
+  return true;
+}
+
+bool BrowserView::FinishPendingSuperDragAtPoint(
+    const gfx::Point& point_in_screen) {
+  bool handled = false;
+  if (!super_drag_drop_handled_ && IsPointInActiveContents(point_in_screen)) {
+    handled = ExecutePendingSuperDrag(/*drop_data_override=*/nullptr);
+  }
+
+  super_drag_drop_handled_ = false;
+  ClearSuperDragState();
+  return handled;
+}
+
+bool BrowserView::IsPointInActiveContents(
+    const gfx::Point& point_in_screen) const {
+  const ContentsContainerView* const active_contents_container =
+      const_cast<BrowserView*>(this)->GetActiveContentsContainerView();
+  return active_contents_container &&
+         active_contents_container->GetBoundsInScreen().Contains(
+             point_in_screen);
+}
+
+std::optional<BrowserView::SuperDragType> BrowserView::GetSuperDragType(
+    const content::DropData& drop_data) const {
+  PrefService* const prefs = browser_->profile()->GetPrefs();
+  if (!prefs || !prefs->GetBoolean(super_drag::prefs::kEnabled) ||
+      !drop_data.did_originate_from_renderer) {
+    return std::nullopt;
+  }
+
+  if ((drop_data.file_contents_image_accessible ||
+       drop_data.file_contents_source_url.is_valid()) &&
+      (drop_data.file_contents_source_url.is_valid() ||
+       !drop_data.url_infos.empty())) {
+    return SuperDragType::kImage;
+  }
+
+  if (!drop_data.url_infos.empty() &&
+      drop_data.url_infos.front().url.is_valid()) {
+    return SuperDragType::kLink;
+  }
+
+  auto search_terms = GetSuperDragSearchTerms(drop_data);
+  if (search_terms.has_value()) {
+    return SuperDragType::kText;
+  }
+
+  return std::nullopt;
+}
+
+bool BrowserView::UpdateSuperDragState(const content::DropData& drop_data,
+                                       const gfx::PointF& point) {
+  const std::optional<SuperDragType> drag_type = GetSuperDragType(drop_data);
+  if (!drag_type.has_value()) {
+    if (!super_drag_state_.has_value()) {
+      return false;
+    }
+
+    // Keep the last valid payload alive until the drag fully exits or ends.
+    // Some drag updates can transiently lose their renderer payload even though
+    // the gesture is still in progress over page content.
+    super_drag_state_->last_point = point;
+    return true;
+  }
+
+  if (!super_drag_state_.has_value() || super_drag_state_->type != *drag_type) {
+    super_drag_state_.emplace(*drag_type, point, point, drop_data);
+    super_drag_drop_handled_ = false;
+    return true;
+  }
+
+  super_drag_state_->last_point = point;
+  super_drag_state_->drop_data = drop_data;
+  return true;
+}
+
+int BrowserView::GetSuperDragThreshold() const {
+  PrefService* const prefs = browser_->profile()->GetPrefs();
+  return prefs
+             ? std::clamp(prefs->GetInteger(super_drag::prefs::kThreshold),
+                          kSuperDragMinimumThreshold, kSuperDragMaximumThreshold)
+             : kSuperDragDefaultThreshold;
+}
+
+bool BrowserView::ShouldShowSuperDragTrail() const {
+  PrefService* const prefs = browser_->profile()->GetPrefs();
+  return prefs && prefs->GetBoolean(super_drag::prefs::kShowTrail);
+}
+
+bool BrowserView::ShouldShowSuperDragHint() const {
+  PrefService* const prefs = browser_->profile()->GetPrefs();
+  return prefs && prefs->GetBoolean(super_drag::prefs::kShowHint);
+}
+
+std::optional<BrowserView::SuperDragDirection>
+BrowserView::GetSuperDragDirection() const {
+  if (!super_drag_state_.has_value()) {
+    return std::nullopt;
+  }
+
+  const float delta_x =
+      super_drag_state_->last_point.x() - super_drag_state_->start_point.x();
+  const float delta_y =
+      super_drag_state_->last_point.y() - super_drag_state_->start_point.y();
+  const float abs_delta_x = std::abs(delta_x);
+  const float abs_delta_y = std::abs(delta_y);
+  const int threshold = GetSuperDragThreshold();
+  if (abs_delta_x < threshold && abs_delta_y < threshold) {
+    return std::nullopt;
+  }
+
+  if (abs_delta_x >= abs_delta_y) {
+    return delta_x >= 0 ? SuperDragDirection::kRight
+                        : SuperDragDirection::kLeft;
+  }
+
+  return delta_y >= 0 ? SuperDragDirection::kDown : SuperDragDirection::kUp;
+}
+
+std::optional<std::string> BrowserView::GetConfiguredSuperDragActionId(
+    SuperDragType type,
+    SuperDragDirection direction) const {
+  const auto is_supported_action = [type](std::string_view action_id) {
+    if (action_id == "none" || action_id == "copy_value") {
+      return true;
+    }
+
+    switch (type) {
+      case SuperDragType::kLink:
+      case SuperDragType::kImage:
+        return action_id == "open_current_tab" ||
+               action_id == "open_new_foreground_tab" ||
+               action_id == "open_new_background_tab";
+      case SuperDragType::kText:
+        return action_id == "search_current_tab" ||
+               action_id == "search_new_foreground_tab" ||
+               action_id == "search_new_background_tab";
+    }
+    return false;
+  };
+
+  const std::string_view direction_key = [direction]() -> std::string_view {
+    switch (direction) {
+      case SuperDragDirection::kUp:
+        return "U";
+      case SuperDragDirection::kDown:
+        return "D";
+      case SuperDragDirection::kLeft:
+        return "L";
+      case SuperDragDirection::kRight:
+        return "R";
+    }
+    return std::string_view();
+  }();
+
+  const auto get_default_action_id =
+      [type, direction_key]() -> std::string_view {
+    switch (type) {
+      case SuperDragType::kLink:
+        return super_drag::GetDefaultLinkActionIdForDirection(direction_key);
+      case SuperDragType::kText:
+        return super_drag::GetDefaultTextActionIdForDirection(direction_key);
+      case SuperDragType::kImage:
+        return super_drag::GetDefaultImageActionIdForDirection(direction_key);
+    }
+    return std::string_view();
+  };
+
+  PrefService* const prefs = browser_->profile()->GetPrefs();
+  if (prefs) {
+    const base::DictValue* action_map = nullptr;
+    switch (type) {
+      case SuperDragType::kLink:
+        action_map = &prefs->GetDict(super_drag::prefs::kLinkActions);
+        break;
+      case SuperDragType::kText:
+        action_map = &prefs->GetDict(super_drag::prefs::kTextActions);
+        break;
+      case SuperDragType::kImage:
+        action_map = &prefs->GetDict(super_drag::prefs::kImageActions);
+        break;
+    }
+
+    if (action_map) {
+      if (const std::string* configured_action =
+              action_map->FindString(direction_key);
+          configured_action && is_supported_action(*configured_action)) {
+        return *configured_action;
+      }
+    }
+  }
+
+  const std::string_view default_action = get_default_action_id();
+  if (default_action.empty() || !is_supported_action(default_action)) {
+    return std::nullopt;
+  }
+  return std::string(default_action);
+}
+
+void BrowserView::EnsureSuperDragOverlayView() {
+  if (super_drag_overlay_view_tracker_ || !contents_container_) {
+    return;
+  }
+
+  auto overlay_view =
+      std::make_unique<SuperDragOverlayView>(base::BindRepeating(
+          &BrowserView::PaintSuperDragOverlay, base::Unretained(this)));
+  overlay_view->SetVisible(false);
+  super_drag_overlay_view_tracker_.SetView(
+      contents_container_->AddChildView(std::move(overlay_view)));
+}
+
+void BrowserView::RefreshSuperDragOverlayView() {
+  EnsureSuperDragOverlayView();
+  auto* overlay_view = static_cast<SuperDragOverlayView*>(
+      super_drag_overlay_view_tracker_.view());
+  if (!overlay_view) {
+    return;
+  }
+
+  overlay_view->SyncToParentBounds();
+  const bool has_line = ShouldShowSuperDragTrail() &&
+                        super_drag_state_.has_value() &&
+                        gfx::ToRoundedPoint(super_drag_state_->start_point) !=
+                            gfx::ToRoundedPoint(super_drag_state_->last_point);
+  const bool should_show =
+      super_drag_pointer_in_contents_ &&
+      (has_line || (ShouldShowSuperDragHint() &&
+                    !GetSuperDragOverlayText().empty()));
+  overlay_view->SetVisible(should_show);
+  if (should_show) {
+    overlay_view->SchedulePaint();
+  }
+}
+
+void BrowserView::PaintSuperDragOverlay(
+    gfx::Canvas* canvas,
+    const views::View* coordinate_space_view) const {
+  if (!canvas || !coordinate_space_view || !super_drag_pointer_in_contents_ ||
+      !super_drag_state_.has_value()) {
+    return;
+  }
+
+  const ContentsContainerView* const active_contents_container =
+      const_cast<BrowserView*>(this)->GetActiveContentsContainerView();
+  if (!active_contents_container) {
+    return;
+  }
+
+  gfx::Point start = gfx::ToRoundedPoint(super_drag_state_->start_point);
+  gfx::Point end = gfx::ToRoundedPoint(super_drag_state_->last_point);
+  views::View::ConvertPointToTarget(active_contents_container,
+                                    coordinate_space_view, &start);
+  views::View::ConvertPointToTarget(active_contents_container,
+                                    coordinate_space_view, &end);
+
+  const bool draw_trail = ShouldShowSuperDragTrail() && start != end;
+  const std::u16string hint_text = GetSuperDragOverlayText();
+  const bool draw_hint = ShouldShowSuperDragHint() && !hint_text.empty();
+  if (!draw_trail && !draw_hint) {
+    return;
+  }
+
+  if (draw_trail) {
+    SkPathBuilder path;
+    path.moveTo(start.x(), start.y());
+    path.lineTo(end.x(), end.y());
+
+    cc::PaintFlags trail_flags;
+    trail_flags.setAntiAlias(true);
+    trail_flags.setStyle(cc::PaintFlags::kStroke_Style);
+    trail_flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+    trail_flags.setStrokeJoin(cc::PaintFlags::kRound_Join);
+    trail_flags.setStrokeWidth(3.f);
+    trail_flags.setColor(SkColorSetARGB(0xE0, 0x21, 0x96, 0xF3));
+    canvas->DrawPath(path.detach(), trail_flags);
+  }
+
+  if (!draw_hint) {
+    return;
+  }
+
+  constexpr int kHintPadding = 12;
+  constexpr int kHintMargin = 20;
+  constexpr int kHintHeight = 36;
+  constexpr int kHintOffsetX = 16;
+  constexpr int kHintOffsetY = 24;
+  const gfx::FontList font_list;
+  const int text_width = gfx::GetStringWidth(hint_text, font_list);
+  const int hint_width = std::min(coordinate_space_view->width() - 24,
+                                  std::max(180, text_width + kHintPadding * 2));
+  if (hint_width <= 0) {
+    return;
+  }
+
+  const int max_x = std::max(
+      kHintMargin, coordinate_space_view->width() - hint_width - kHintMargin);
+  const int max_y = std::max(
+      kHintMargin, coordinate_space_view->height() - kHintHeight - kHintMargin);
+  gfx::Point hint_origin((coordinate_space_view->width() - hint_width) / 2,
+                         kHintMargin);
+  hint_origin.set_x(std::clamp(end.x() + kHintOffsetX, kHintMargin, max_x));
+  hint_origin.set_y(
+      std::clamp(end.y() - kHintOffsetY - kHintHeight, kHintMargin, max_y));
+
+  const gfx::Rect hint_bounds(hint_origin, gfx::Size(hint_width, kHintHeight));
+  cc::PaintFlags background_flags;
+  background_flags.setAntiAlias(true);
+  background_flags.setColor(SkColorSetA(SK_ColorBLACK, 0xCC));
+  canvas->DrawRoundRect(gfx::RectF(hint_bounds), 10.f, background_flags);
+
+  constexpr int kTextFlags =
+      gfx::Canvas::TEXT_ALIGN_CENTER | gfx::Canvas::NO_SUBPIXEL_RENDERING;
+  canvas->DrawStringRectWithFlags(hint_text, font_list, SK_ColorWHITE,
+                                  hint_bounds, kTextFlags);
+}
+
+std::u16string BrowserView::GetSuperDragOverlayText() const {
+  if (!ShouldShowSuperDragHint()) {
+    return std::u16string();
+  }
+
+  const std::optional<SuperDragDirection> direction = GetSuperDragDirection();
+  if (!super_drag_state_.has_value() || !direction.has_value()) {
+    return std::u16string();
+  }
+
+  const std::optional<std::string> action_id =
+      GetConfiguredSuperDragActionId(super_drag_state_->type, *direction);
+  if (!action_id.has_value()) {
+    return std::u16string();
+  }
+
+  return GetSuperDragDirectionLabel(*direction) + u"  " +
+         GetSuperDragActionLabel(super_drag_state_->type, *action_id);
+}
+
+std::u16string BrowserView::GetSuperDragDirectionLabel(
+    SuperDragDirection direction) const {
+  switch (direction) {
+    case SuperDragDirection::kUp:
+      return u"\u5411\u4E0A";
+    case SuperDragDirection::kDown:
+      return u"\u5411\u4E0B";
+    case SuperDragDirection::kLeft:
+      return u"\u5411\u5DE6";
+    case SuperDragDirection::kRight:
+      return u"\u5411\u53F3";
+  }
+  return std::u16string();
+}
+
+std::u16string BrowserView::GetSuperDragActionLabel(
+    SuperDragType type,
+    std::string_view action_id) const {
+  if (action_id == "none") {
+    return u"\u65E0\u52A8\u4F5C";
+  }
+
+  switch (type) {
+    case SuperDragType::kLink:
+      if (action_id == "open_current_tab") {
+        return u"\u5F53\u524D\u6807\u7B7E\u6253\u5F00\u94FE\u63A5";
+      }
+      if (action_id == "open_new_foreground_tab") {
+        return u"\u65B0\u524D\u53F0\u6807\u7B7E\u6253\u5F00\u94FE\u63A5";
+      }
+      if (action_id == "open_new_background_tab") {
+        return u"\u65B0\u540E\u53F0\u6807\u7B7E\u6253\u5F00\u94FE\u63A5";
+      }
+      if (action_id == "copy_value") {
+        return u"\u590D\u5236\u94FE\u63A5\u5730\u5740";
+      }
+      return u"\u65E0\u52A8\u4F5C";
+    case SuperDragType::kText:
+      if (action_id == "search_current_tab") {
+        return u"\u5F53\u524D\u6807\u7B7E\u641C\u7D22\u6587\u672C";
+      }
+      if (action_id == "search_new_foreground_tab") {
+        return u"\u65B0\u524D\u53F0\u6807\u7B7E\u641C\u7D22\u6587\u672C";
+      }
+      if (action_id == "search_new_background_tab") {
+        return u"\u65B0\u540E\u53F0\u6807\u7B7E\u641C\u7D22\u6587\u672C";
+      }
+      if (action_id == "copy_value") {
+        return u"\u590D\u5236\u6587\u672C";
+      }
+      return u"\u65E0\u52A8\u4F5C";
+    case SuperDragType::kImage:
+      if (action_id == "open_current_tab") {
+        return u"\u5F53\u524D\u6807\u7B7E\u6253\u5F00\u56FE\u7247";
+      }
+      if (action_id == "open_new_foreground_tab") {
+        return u"\u65B0\u524D\u53F0\u6807\u7B7E\u6253\u5F00\u56FE\u7247";
+      }
+      if (action_id == "open_new_background_tab") {
+        return u"\u65B0\u540E\u53F0\u6807\u7B7E\u6253\u5F00\u56FE\u7247";
+      }
+      if (action_id == "copy_value") {
+        return u"\u590D\u5236\u56FE\u7247\u5730\u5740";
+      }
+      return u"\u65E0\u52A8\u4F5C";
+  }
+  return u"\u65E0\u52A8\u4F5C";
+}
+
+void BrowserView::ClearSuperDragState() {
+  super_drag_state_.reset();
+  super_drag_pointer_in_contents_ = false;
+  RefreshSuperDragOverlayView();
+}
