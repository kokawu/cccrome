+  root_window->GetHost()->ConvertScreenInPixelsToDIP(&root_location);
+
+  gfx::Point location = root_location;
+  if (aura::Window* target_window =
+          root_window->GetEventHandlerForPoint(root_location)) {
+    aura::Window::ConvertPointToTarget(root_window, target_window, &location);
+  }
+
+  ui::DropTargetEvent event(data, gfx::PointF(location), gfx::PointF(root_location),
+                            allowed_operations);
+  event.SetFlags(ConvertKeyStateToAuraEventFlags(key_state));
+  return event;
+}
