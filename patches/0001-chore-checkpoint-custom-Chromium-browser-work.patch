+class BrowserDaemon:
+    def __init__(self, browser_binary: Path, user_data_dir: Path, host: str,
+                 port: int, remote_debugging_port: int, token: str):
+        self.browser_binary = browser_binary
+        self.user_data_dir = user_data_dir
+        self.host = host
+        self.port = int(port)
+        self.remote_debugging_port = int(remote_debugging_port)
+        self.token = token
+        self.window_control_module = _load_browser_control_module()
+        self.session = BrowserSession(browser_binary, user_data_dir,
+                                      remote_debugging_port,
+                                      self.window_control_module)
+        self.httpd: ThreadingHTTPServer | None = None
+        self.command_lock = threading.Lock()
+        self.started_at = time.time()
+
+    def _state_dict(self) -> dict[str, Any]:
+        return {
+            'pid': os.getpid(),
+            'host': self.host,
+            'port': self.port,
+            'token': self.token,
+            'browser_pid': self.session.browser_pid,
+            'window_pid': self.session.window_pid,
+            'browser_binary': str(self.browser_binary),
+            'user_data_dir': str(self.user_data_dir),
+            'remote_debugging_port': self.remote_debugging_port,
+            'started_at': self.started_at,
+        }
+
+    def write_state(self) -> None:
+        common.save_state(self._state_dict())
+
+    def status(self) -> dict[str, Any]:
+        version = self.session.ensure_browser()
+        self.write_state()
+        return {
+            'daemon': self._state_dict(),
+            'browser_version': version,
+            'windows': self.session.list_windows(),
+            'tab_count': len(self.session.list_tabs()),
+        }
+
+    def tabs(self) -> dict[str, Any]:
+        tabs = self.session.list_tabs()
+        self.write_state()
+        return {'tabs': tabs, 'count': len(tabs)}
+
+    def windows(self) -> dict[str, Any]:
+        windows = self.session.list_windows()
+        self.write_state()
+        return {'windows': windows, 'count': len(windows)}
+
+    def open_url(self, url: str) -> dict[str, Any]:
+        result = self.session.open_url(url)
+        self.write_state()
+        return result
+
+    def snapshot(self) -> dict[str, Any]:
+        result = self.session.snapshot()
+        self.write_state()
