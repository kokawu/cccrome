+    GiveItSomeTime();
+    drag_operation = static_cast<ui::mojom::DragOperation>(
+        SimulateDragUpdate(*data, point).drag_operation);
+  }
+
+  EXPECT_EQ(ui::mojom::DragOperation::kCopy, GetCurrentDragOperation());
+  EXPECT_EQ(ui::mojom::DragOperation::kCopy, drag_operation);
+
+  const ui::mojom::DragOperation output_drag_op =
+      SimulateDrop(std::move(data), point);
+  EXPECT_EQ(ui::mojom::DragOperation::kCopy, output_drag_op);
+  delegate->FinishOnPerformingDrop();
+
+  run_loop.Run();
+
+  ASSERT_FALSE(IsDragInProgress());
+  EXPECT_TRUE(delegate->IsRendererToldToForceDefaultAction());
+  EXPECT_EQ(1, drag_dest_delegate_.GetOnDropCalledCount());
+  EXPECT_FALSE(drag_dest_delegate_.GetOnDragLeaveCalled());
+  EXPECT_GT(browser_delegate.call_count(), 0);
+  GetWebContentsImpl()->SetDelegate(nullptr);
+}
+
+IN_PROC_BROWSER_TEST_F(WebContentsViewAuraTest,
+                       SourceDragUpdateInsideContentsCallsDelegate) {
+  StartTestWithPage("about:blank");
+
+  SourceDragTrackingDelegate delegate;
+  GetWebContentsImpl()->SetDelegate(&delegate);
+
+  content::DropData drop_data;
+  drop_data.did_originate_from_renderer = true;
+  drop_data.url_infos = {
+      ui::ClipboardUrlInfo(GURL("https://example.com/superdrag"), u"drag")};
+
+  aura::Window* const content_native_view = GetWebContentsViewAura()->GetContentNativeView();
+  ASSERT_TRUE(content_native_view);
+  gfx::Point root_point = content_native_view->bounds().CenterPoint();
+  aura::Window::ConvertPointToTarget(content_native_view,
+                                     content_native_view->GetRootWindow(),
+                                     &root_point);
+
+  ui::OSExchangeData event_data;
+  ui::DropTargetEvent event(event_data, gfx::PointF(root_point),
+                            gfx::PointF(root_point),
+                            ui::DragDropTypes::DRAG_COPY);
+  RenderWidgetHostImpl* const source_rwh =
+      GetWebContentsImpl()->GetRenderViewHost()->GetWidget();
+  ASSERT_TRUE(source_rwh);
+
+  GetWebContentsViewAura()->HandleSourceDragUpdate(drop_data,
+                                                   source_rwh->GetWeakPtr(),
+                                                   event);
+
+  EXPECT_EQ(1, delegate.drag_update_count());
+  ASSERT_TRUE(delegate.last_client_pt().has_value());
+  ASSERT_TRUE(delegate.last_drop_data().has_value());
+  EXPECT_EQ(drop_data.url_infos.front().url,
+            delegate.last_drop_data()->url_infos.front().url);
+
+  GetWebContentsImpl()->SetDelegate(nullptr);
+}
+
+IN_PROC_BROWSER_TEST_F(WebContentsViewAuraTest,
+                       SourceDragUpdateOutsideContentsExitsDelegate) {
+  StartTestWithPage("about:blank");
+
+  SourceDragTrackingDelegate delegate;
+  GetWebContentsImpl()->SetDelegate(&delegate);
+
+  content::DropData drop_data;
+  drop_data.did_originate_from_renderer = true;
+  drop_data.url_infos = {
+      ui::ClipboardUrlInfo(GURL("https://example.com/superdrag"), u"drag")};
+
+  ui::OSExchangeData event_data;
+  ui::DropTargetEvent event(event_data, gfx::PointF(0, 0), gfx::PointF(0, 0),
+                            ui::DragDropTypes::DRAG_COPY);
+  RenderWidgetHostImpl* const source_rwh =
+      GetWebContentsImpl()->GetRenderViewHost()->GetWidget();
+  ASSERT_TRUE(source_rwh);
+
+  GetWebContentsViewAura()->HandleSourceDragUpdate(drop_data,
+                                                   source_rwh->GetWeakPtr(),
+                                                   event);
+
+  EXPECT_EQ(0, delegate.drag_update_count());
+  EXPECT_EQ(1, delegate.drag_exit_count());
+
+  GetWebContentsImpl()->SetDelegate(nullptr);
+}
+
 // When the user drops data onto a web page that does not handle drops and the
 // web view delegate blocks it, the renderer sees this as a "drag leave" and not
 // a "drop".
