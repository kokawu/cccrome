+
+/**
+ * @fileoverview
+ * 'settings-proxy-page' is the settings page for built-in proxy management.
+ */
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import 'chrome://resources/cr_elements/cr_shared_style.css.js';
+import '../controls/settings_dropdown_menu.js';
+import '../controls/settings_toggle_button.js';
+import '../settings_page/settings_section.js';
+import '../settings_shared.css.js';
+
+import type {PrefsMixinInterface} from '/shared/settings/prefs/prefs_mixin.js';
+import {PrefsMixin} from '/shared/settings/prefs/prefs_mixin.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import type {DropdownMenuOptionList} from '../controls/settings_dropdown_menu.js';
+import {getSearchManager} from '../search_settings.js';
+import type {SettingsPlugin} from '../settings_main/settings_plugin.js';
+
+import {getTemplate} from './proxy_page.html.js';
+
+type Constructor<T> = new (...args: any[]) => T;
+
+const PROXY_MODE_OPTIONS: DropdownMenuOptionList = [
+  {value: 'system', name: '\u8ddf\u968f\u7cfb\u7edf'},
+  {value: 'direct', name: '\u76f4\u8fde'},
+  {value: 'fixed_servers', name: '\u56fa\u5b9a\u670d\u52a1\u5668'},
+  {value: 'pac_script', name: 'PAC \u811a\u672c'},
+  {value: 'auto_detect', name: '\u81ea\u52a8\u68c0\u6d4b'},
+];
+
+const SettingsProxyPageElementBase = PrefsMixin(PolymerElement) as
+    Constructor<PrefsMixinInterface&PolymerElement>;
+
+export class SettingsProxyPageElement extends SettingsProxyPageElementBase
+    implements SettingsPlugin {
+  static get is() {
+    return 'settings-proxy-page';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      prefs: {
+        type: Object,
+        notify: true,
+      },
+
+      proxyModeOptions_: {
+        type: Array,
+        value: (): DropdownMenuOptionList => PROXY_MODE_OPTIONS,
+      },
+
+      defaultServerRules_: {
+        type: String,
+        value: '',
+      },
+
+      defaultPacUrl_: {
+        type: String,
+        value: '',
+      },
+
+      defaultBypassList_: {
+        type: String,
+        value: '',
+      },
+
+      instanceServerRules_: {
+        type: String,
+        value: '',
+      },
+
+      instancePacUrl_: {
+        type: String,
+        value: '',
+      },
+
+      instanceBypassList_: {
+        type: String,
+        value: '',
+      },
+
+      effectiveModeLabel_: {
+        type: String,
+        value: '',
+      },
+
+      effectiveConfigSummary_: {
+        type: String,
+        value: '',
+      },
+    };
+  }
+
+  static get observers() {
+    return [
+      'onDefaultServerRulesPrefChanged_(prefs.cc.proxy.default.server_rules.value)',
+      'onDefaultPacUrlPrefChanged_(prefs.cc.proxy.default.pac_url.value)',
+      'onDefaultBypassListPrefChanged_(prefs.cc.proxy.default.bypass_list.value)',
+      'onInstanceServerRulesPrefChanged_(prefs.cc.proxy.instance.server_rules.value)',
+      'onInstancePacUrlPrefChanged_(prefs.cc.proxy.instance.pac_url.value)',
+      'onInstanceBypassListPrefChanged_(prefs.cc.proxy.instance.bypass_list.value)',
+      'updateEffectiveSummary_(prefs.cc.proxy.default.mode.value, prefs.cc.proxy.default.server_rules.value, prefs.cc.proxy.default.pac_url.value, prefs.cc.proxy.default.bypass_list.value, prefs.cc.proxy.default.pac_mandatory.value, prefs.cc.proxy.instance.override_enabled.value, prefs.cc.proxy.instance.mode.value, prefs.cc.proxy.instance.server_rules.value, prefs.cc.proxy.instance.pac_url.value, prefs.cc.proxy.instance.bypass_list.value, prefs.cc.proxy.instance.pac_mandatory.value)',
+    ];
+  }
+
+  declare prefs: {[key: string]: any};
+  declare private proxyModeOptions_: DropdownMenuOptionList;
+  declare private defaultServerRules_: string;
+  declare private defaultPacUrl_: string;
+  declare private defaultBypassList_: string;
+  declare private instanceServerRules_: string;
+  declare private instancePacUrl_: string;
+  declare private instanceBypassList_: string;
+  declare private effectiveModeLabel_: string;
+  declare private effectiveConfigSummary_: string;
+
+  async searchContents(query: string) {
+    const searchRequest = await getSearchManager().search(query, this);
+    return searchRequest.getSearchResult();
+  }
+
+  private onDefaultServerRulesPrefChanged_(value: string) {
+    if (value !== undefined && value !== this.defaultServerRules_) {
+      this.defaultServerRules_ = value;
+    }
+  }
+
+  private onDefaultPacUrlPrefChanged_(value: string) {
+    if (value !== undefined && value !== this.defaultPacUrl_) {
+      this.defaultPacUrl_ = value;
+    }
+  }
+
+  private onDefaultBypassListPrefChanged_(value: string) {
+    if (value !== undefined && value !== this.defaultBypassList_) {
+      this.defaultBypassList_ = value;
+    }
+  }
+
+  private onInstanceServerRulesPrefChanged_(value: string) {
+    if (value !== undefined && value !== this.instanceServerRules_) {
+      this.instanceServerRules_ = value;
+    }
+  }
+
+  private onInstancePacUrlPrefChanged_(value: string) {
+    if (value !== undefined && value !== this.instancePacUrl_) {
+      this.instancePacUrl_ = value;
+    }
+  }
+
+  private onInstanceBypassListPrefChanged_(value: string) {
+    if (value !== undefined && value !== this.instanceBypassList_) {
+      this.instanceBypassList_ = value;
+    }
+  }
+
+  private onDefaultServerRulesChange_() {
+    this.setPrefValue(
+        'cc.proxy.default.server_rules', this.defaultServerRules_.trim());
+  }
+
+  private onDefaultPacUrlChange_() {
+    this.setPrefValue('cc.proxy.default.pac_url', this.defaultPacUrl_.trim());
+  }
+
+  private onDefaultBypassListChange_() {
+    this.setPrefValue(
+        'cc.proxy.default.bypass_list', this.defaultBypassList_.trim());
+  }
+
+  private onInstanceServerRulesChange_() {
+    this.setPrefValue(
+        'cc.proxy.instance.server_rules', this.instanceServerRules_.trim());
+  }
+
+  private onInstancePacUrlChange_() {
+    this.setPrefValue(
+        'cc.proxy.instance.pac_url', this.instancePacUrl_.trim());
+  }
+
+  private onInstanceBypassListChange_() {
+    this.setPrefValue(
+        'cc.proxy.instance.bypass_list', this.instanceBypassList_.trim());
+  }
+
+  private isMode_(value: string, expected: string): boolean {
+    return value === expected;
+  }
+
+  private isInstanceOverrideDisabled_(enabled: boolean): boolean {
+    return !enabled;
+  }
+
+  private getModeDescription_(mode: string): string {
+    switch (mode) {
+      case 'direct':
+        return '\u4e0d\u4f7f\u7528\u4ee3\u7406\uff0c\u76f4\u63a5\u8fde\u63a5\u3002';
+      case 'fixed_servers':
+        return '\u4f7f\u7528\u624b\u52a8 HTTP\u3001HTTPS \u6216 SOCKS \u4ee3\u7406\u89c4\u5219\u3002';
+      case 'pac_script':
+        return '\u901a\u8fc7 PAC \u811a\u672c\u51b3\u5b9a\u4ee3\u7406\u89c4\u5219\u3002';
+      case 'auto_detect':
+        return '\u4f7f\u7528 WPAD \u81ea\u52a8\u53d1\u73b0\u4ee3\u7406\u3002';
+      case 'system':
+      default:
+        return '\u8ddf\u968f\u64cd\u4f5c\u7cfb\u7edf\u7684\u4ee3\u7406\u8bbe\u7f6e\u3002';
+    }
+  }
+
+  private updateEffectiveSummary_(
+      defaultMode: string, defaultServerRules: string, defaultPacUrl: string,
+      defaultBypassList: string, defaultPacMandatory: boolean,
+      instanceOverrideEnabled: boolean, instanceMode: string,
+      instanceServerRules: string, instancePacUrl: string,
+      instanceBypassList: string, instancePacMandatory: boolean) {
+    const useInstanceOverride = instanceOverrideEnabled;
+    this.effectiveModeLabel_ =
+        useInstanceOverride ?
+        '\u5f53\u524d\u5b9e\u4f8b\u8986\u76d6\u5df2\u542f\u7528' :
+        '\u6d4f\u89c8\u5668\u9ed8\u8ba4\u4ee3\u7406';
+    this.effectiveConfigSummary_ = this.describeProxyConfig_(
+        useInstanceOverride ? instanceMode : defaultMode,
+        useInstanceOverride ? instanceServerRules : defaultServerRules,
+        useInstanceOverride ? instancePacUrl : defaultPacUrl,
+        useInstanceOverride ? instanceBypassList : defaultBypassList,
+        useInstanceOverride ? instancePacMandatory : defaultPacMandatory);
+  }
+
+  private describeProxyConfig_(
+      mode: string, serverRules: string, pacUrl: string, bypassList: string,
+      pacMandatory: boolean): string {
+    switch (mode) {
+      case 'direct':
+        return '\u5f53\u524d\u4e3a\u76f4\u8fde\uff0c\u4e0d\u4f7f\u7528\u4ee3\u7406\u3002';
+      case 'fixed_servers':
+        if (!serverRules) {
+          return '\u5df2\u9009\u62e9\u56fa\u5b9a\u670d\u52a1\u5668\u6a21\u5f0f\uff0c\u4f46\u5c1a\u672a\u586b\u5199\u4ee3\u7406\u89c4\u5219\u3002';
+        }
+        return `\u56fa\u5b9a\u670d\u52a1\u5668\uff1a${serverRules}${
+            bypassList ? ` | \u76f4\u8fde\u4f8b\u5916\uff1a${bypassList}` : ''}`;
+      case 'pac_script':
+        if (!pacUrl) {
+          return '\u5df2\u9009\u62e9 PAC \u811a\u672c\u6a21\u5f0f\uff0c\u4f46 PAC \u5730\u5740\u4e3a\u7a7a\u3002';
+        }
+        return `PAC\uff1a${pacUrl}${
+            pacMandatory ? ' | \u5df2\u7981\u7528\u76f4\u8fde\u56de\u9000' : ''}`;
+      case 'auto_detect':
+        return '\u5c06\u901a\u8fc7 WPAD \u81ea\u52a8\u53d1\u73b0\u4ee3\u7406\u3002';
+      case 'system':
+      default:
+        return '\u4ee3\u7406\u8ddf\u968f\u7cfb\u7edf\u914d\u7f6e\u3002';
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-proxy-page': SettingsProxyPageElement;
+  }
+}
+
+customElements.define(SettingsProxyPageElement.is, SettingsProxyPageElement);
