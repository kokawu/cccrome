+        currentRouteChanged(_newRoute: Route, _oldRoute?: Route) {
+          assertNotReached();
+        }
+      }
+      return RouteObserverMixin;
+    });
+
+export interface RouteObserverMixinInterface {
+  currentRouteChanged(newRoute: Route, oldRoute?: Route): void;
+}
