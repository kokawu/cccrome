+namespace cc_proxy {
+
+void RegisterLocalStatePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterStringPref(prefs::kDefaultMode,
+                               ProxyPrefs::kSystemProxyModeName);
+  registry->RegisterStringPref(prefs::kDefaultServerRules, std::string());
+  registry->RegisterStringPref(prefs::kDefaultPacUrl, std::string());
+  registry->RegisterStringPref(prefs::kDefaultBypassList, std::string());
+  registry->RegisterBooleanPref(prefs::kDefaultPacMandatory, false);
+}
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterBooleanPref(prefs::kInstanceOverrideEnabled, false,
+                                PrefRegistry::NO_REGISTRATION_FLAGS);
+  registry->RegisterStringPref(prefs::kInstanceMode,
+                               ProxyPrefs::kSystemProxyModeName,
+                               PrefRegistry::NO_REGISTRATION_FLAGS);
+  registry->RegisterStringPref(prefs::kInstanceServerRules, std::string(),
+                               PrefRegistry::NO_REGISTRATION_FLAGS);
+  registry->RegisterStringPref(prefs::kInstancePacUrl, std::string(),
+                               PrefRegistry::NO_REGISTRATION_FLAGS);
+  registry->RegisterStringPref(prefs::kInstanceBypassList, std::string(),
+                               PrefRegistry::NO_REGISTRATION_FLAGS);
+  registry->RegisterBooleanPref(prefs::kInstancePacMandatory, false,
+                                PrefRegistry::NO_REGISTRATION_FLAGS);
+}
+
+}  // namespace cc_proxy
