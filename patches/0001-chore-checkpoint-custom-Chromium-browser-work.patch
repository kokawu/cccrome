+#include "chrome/browser/proxy/cc_proxy_config_service.h"
+
+namespace cc_proxy {
+
+// static
+CcProxyConfigServiceFactory* CcProxyConfigServiceFactory::GetInstance() {
+  static base::NoDestructor<CcProxyConfigServiceFactory> instance;
+  return instance.get();
+}
+
+// static
+CcProxyConfigService* CcProxyConfigServiceFactory::GetForProfile(
+    Profile* profile) {
+  return static_cast<CcProxyConfigService*>(
+      GetInstance()->GetServiceForBrowserContext(profile, true));
+}
+
+CcProxyConfigServiceFactory::CcProxyConfigServiceFactory()
+    : ProfileKeyedServiceFactory(
+          "CcProxyConfigService",
+          ProfileSelections::Builder()
+              .WithRegular(ProfileSelection::kRedirectedToOriginal)
+              .WithGuest(ProfileSelection::kOwnInstance)
+              .WithAshInternals(ProfileSelection::kNone)
+              .Build()) {}
+
+CcProxyConfigServiceFactory::~CcProxyConfigServiceFactory() = default;
+
+bool CcProxyConfigServiceFactory::ServiceIsCreatedWithBrowserContext() const {
+  return true;
+}
+
+std::unique_ptr<KeyedService>
+CcProxyConfigServiceFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  return std::make_unique<CcProxyConfigService>(
+      Profile::FromBrowserContext(context));
+}
+
+}  // namespace cc_proxy
