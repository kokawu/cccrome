+void BrowserMouseGestureController::RecordPoint(const gfx::Point& point) {
+  if (trail_points_.empty() || trail_points_.back() != point) {
+    trail_points_.push_back(point);
+  }
+}
+
+void BrowserMouseGestureController::StartGesture(const gfx::Point& location) {
+  ClearActionFeedback();
+  gesture_in_progress_ = true;
+  gesture_crossed_threshold_ = false;
+  last_point_ = location;
+  gesture_path_.clear();
+  trail_points_.clear();
+  RecordPoint(location);
+  RequestRepaint();
+}
+
+void BrowserMouseGestureController::UpdateGesture(const gfx::Point& location) {
+  RecordPoint(location);
+  const gfx::Vector2d delta = location - last_point_;
+  const int threshold = GetThreshold();
+  if (std::abs(delta.x()) < threshold && std::abs(delta.y()) < threshold) {
+    RequestRepaint();
+    return;
+  }
+
+  gesture_crossed_threshold_ = true;
+  last_point_ = location;
+  if (std::abs(delta.x()) > std::abs(delta.y())) {
+    AppendDirection(delta.x() > 0 ? Direction::kRight : Direction::kLeft);
+  } else {
+    AppendDirection(delta.y() > 0 ? Direction::kDown : Direction::kUp);
+  }
+  RequestRepaint();
+}
+
+bool BrowserMouseGestureController::FinishGesture() {
+  const bool should_consume = gesture_crossed_threshold_;
+  if (!gesture_crossed_threshold_) {
+    CancelGesture();
+    return false;
+  }
+
+  const Action action = GetMappedAction(gesture_path_);
+  if (action != Action::kUnknown && action != Action::kNone) {
+    ShowActionFeedback(action);
+  }
+  CancelGesture();
+  if (action != Action::kUnknown && action != Action::kNone) {
+    ExecuteAction(action);
+  }
+  return should_consume;
+}
+
+bool BrowserMouseGestureController::HandleWheelGesture(
+    const ui::MouseWheelEvent& event) {
+  if ((event.flags() & ui::EF_RIGHT_MOUSE_BUTTON) == 0 || event.y_offset() == 0) {
+    return false;
+  }
+
+  return HandleAuxiliaryTrigger(event.y_offset() > 0 ? "wheel_up"
+                                                     : "wheel_down");
+}
+
+void BrowserMouseGestureController::CancelGesture() {
+  const bool had_visuals =
+      gesture_in_progress_ || !trail_points_.empty() || !gesture_path_.empty();
+  gesture_in_progress_ = false;
+  gesture_crossed_threshold_ = false;
+  gesture_path_.clear();
+  trail_points_.clear();
+  if (had_visuals) {
+    RequestRepaint();
+  }
+}
+
+void BrowserMouseGestureController::ShowActionFeedback(Action action) {
+  action_feedback_text_ = GetActionFeedbackText(action);
+  if (action_feedback_text_.empty()) {
+    return;
+  }
+
+  action_feedback_timer_.Start(
+      FROM_HERE, base::Milliseconds(900),
+      base::BindOnce(&BrowserMouseGestureController::ClearActionFeedback,
+                     base::Unretained(this)));
+  RequestRepaint();
+}
+
+void BrowserMouseGestureController::ClearActionFeedback() {
+  if (action_feedback_text_.empty()) {
+    return;
+  }
+
+  action_feedback_text_.clear();
+  action_feedback_timer_.Stop();
+  RequestRepaint();
+}
+
+void BrowserMouseGestureController::AppendDirection(Direction direction) {
+  const char token = [&]() {
+    switch (direction) {
+      case Direction::kUp:
+        return 'U';
+      case Direction::kDown:
+        return 'D';
+      case Direction::kLeft:
+        return 'L';
+      case Direction::kRight:
+        return 'R';
+    }
+
+    return 'U';
+  }();
+
+  if (gesture_path_.empty() || gesture_path_.back() != token) {
+    gesture_path_.push_back(token);
+  }
+}
