+
+def _load_browser_control_module() -> Any:
+    module_path = (common.REPO_ROOT / 'agents' / 'extensions' /
+                   'browser-control' / 'server.py')
+    spec = importlib.util.spec_from_file_location('browser_control_server',
+                                                  module_path)
+    if spec is None or spec.loader is None:
+        raise common.BrowserctlError(
+            f'Could not load browser-control module from {module_path}.')
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+class BrowserSession:
+    def __init__(self, browser_binary: Path, user_data_dir: Path,
+                 remote_debugging_port: int, window_control_module: Any):
+        self.browser_binary = browser_binary
+        self.user_data_dir = user_data_dir
+        self.remote_debugging_port = int(remote_debugging_port)
+        self.window_control_module = window_control_module
+        self.devtools = cdp.DevToolsClient(remote_debugging_port)
+        self.browser_process: subprocess.Popen[str] | None = None
+        self.browser_pid: int | None = None
+        self.window_pid: int | None = None
+        self.launch_timestamp: float | None = None
+
+    def _target_pid(self) -> int:
+        self._refresh_target_pids()
+        return int(self.window_pid or self.browser_pid or 0)
+
+    def ensure_browser(self) -> dict[str, Any]:
+        try:
+            version = self.version_info()
+            self._refresh_target_pids()
+            return version
+        except common.BrowserctlError:
+            pass
+        return self._launch_browser()
+
+    def _launch_browser(self) -> dict[str, Any]:
+        if not self.browser_binary.exists():
+            raise common.BrowserctlError(
+                f'Browser binary not found: {self.browser_binary}')
+
+        self.user_data_dir.mkdir(parents=True, exist_ok=True)
+        args = [
+            str(self.browser_binary),
+            f'--user-data-dir={self.user_data_dir}',
+            f'--remote-debugging-port={self.remote_debugging_port}',
+            '--remote-allow-origins='
+            f'http://127.0.0.1:{self.remote_debugging_port}',
+            '--no-first-run',
+            '--no-default-browser-check',
+            '--new-window',
+            'about:blank',
+        ]
+        self.browser_process = subprocess.Popen(
+            args,
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+            text=True,
+        )
+        self.browser_pid = int(self.browser_process.pid)
+        self.launch_timestamp = time.time()
+        version = self._wait_for_devtools_ready()
+        time.sleep(1.0)
+        self._refresh_target_pids()
+        return version
+
+    def stop_browser(self) -> None:
+        if self.browser_process and self.browser_process.poll() is None:
+            self.browser_process.terminate()
+            try:
+                self.browser_process.wait(timeout=10)
+            except subprocess.TimeoutExpired:
+                self.browser_process.kill()
+        self.browser_process = None
+        self.browser_pid = None
+        self.window_pid = None
+        self.launch_timestamp = None
+
+    def _devtools_url(self, path: str) -> str:
+        if not path.startswith('/'):
+            path = f'/{path}'
+        return f'http://127.0.0.1:{self.remote_debugging_port}{path}'
+
+    def _request_devtools_json(self,
+                               path: str,
+                               method: str = 'GET') -> Any:
+        return common.json_request(self._devtools_url(path),
+                                   method=method,
+                                   timeout=3.0)
+
+    def _wait_for_devtools_ready(self,
+                                 timeout_seconds: float = 30.0) -> dict[str,
+                                                                          Any]:
+        deadline = time.time() + timeout_seconds
+        last_error: Exception | None = None
+        while time.time() < deadline:
+            try:
+                return self.version_info()
+            except Exception as exc:
+                last_error = exc
+                time.sleep(0.25)
+        raise common.BrowserctlError(
+            f'DevTools endpoint did not become ready on port '
+            f'{self.remote_debugging_port}: {last_error}')
+
+    def version_info(self) -> dict[str, Any]:
+        return self._request_devtools_json('/json/version')
+
+    def _matching_processes_for_binary(self) -> list[dict[str, Any]]:
+        quoted_path = str(self.browser_binary).replace("'", "''")
+        script = rf"""
+$items = Get-Process chrome -ErrorAction SilentlyContinue |
+  Where-Object {{ $_.Path -eq '{quoted_path}' }} |
+  ForEach-Object {{
+    [PSCustomObject]@{{
+      Id = $_.Id
+      StartTicks = $_.StartTime.ToUniversalTime().Ticks
+      MainWindowTitle = $_.MainWindowTitle
+    }}
+  }}
+$items | ConvertTo-Json -Compress
+"""
+        result = subprocess.run(
+            ['powershell', '-NoProfile', '-Command', script],
+            check=True,
+            capture_output=True,
+            text=True,
+        )
+        stdout = result.stdout.strip()
+        if not stdout:
+            return []
+        parsed = json.loads(stdout)
+        if isinstance(parsed, dict):
+            return [parsed]
+        return parsed
+
+    def _refresh_target_pids(self) -> None:
+        visible_windows = self.window_control_module.list_browser_windows(
+            process_name='chrome.exe')
+        if not visible_windows:
+            return
+
+        visible_by_pid = {int(window['pid']): window for window in visible_windows}
+        candidate_processes = []
+        for process in self._matching_processes_for_binary():
+            pid = int(process['Id'])
+            if pid not in visible_by_pid:
+                continue
+            if (self.launch_timestamp is not None and
+                    (int(process['StartTicks']) / 10_000_000 - 62135596800) <
+                    self.launch_timestamp - 5):
+                continue
+            candidate_processes.append(process)
+
+        if not candidate_processes:
+            return
+
+        candidate_processes.sort(
+            key=lambda item: (not bool(item.get('MainWindowTitle')),
+                              -int(item['StartTicks'])))
+        selected_pid = int(candidate_processes[0]['Id'])
+        self.window_pid = selected_pid
+        self.browser_pid = selected_pid
+
+    def list_tabs(self) -> list[dict[str, Any]]:
+        self.ensure_browser()
+        tabs = self._request_devtools_json('/json/list')
+        simplified_tabs = []
+        for tab in tabs:
+            simplified_tabs.append({
+                'id': tab.get('id'),
+                'title': tab.get('title'),
+                'url': tab.get('url'),
+                'type': tab.get('type'),
+                'webSocketDebuggerUrl': tab.get('webSocketDebuggerUrl'),
+            })
+        return simplified_tabs
+
+    def list_windows(self) -> list[dict[str, Any]]:
+        self.ensure_browser()
+        all_windows = self.window_control_module.list_browser_windows(
+            process_name='chrome.exe')
+        matching_pids = {
+            int(process['Id']) for process in self._matching_processes_for_binary()
+        }
+        if self.window_pid:
+            matching_pids.add(int(self.window_pid))
+        return [
+            window for window in all_windows if int(window['pid']) in matching_pids
+        ]
+
+    def snapshot(self) -> dict[str, Any]:
+        self.ensure_browser()
+        snapshot = self.window_control_module.observe_browser(
+            process_name='chrome.exe',
+            target_pid=self._target_pid(),
+            activate=True,
