+
+  int update_count = 0;
+  int completion_count = 0;
+  drag_source->set_drag_updated_callback(
+      base::BindLambdaForTesting([&](DWORD /*key_state*/) { ++update_count; }));
+  drag_source->set_drag_completed_callback(
+      base::BindLambdaForTesting([&](DWORD /*key_state*/) {
+        ++completion_count;
+      }));
+
+  drag_source->CancelDrag();
