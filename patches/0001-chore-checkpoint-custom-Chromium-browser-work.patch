+
+bool BrowserMouseGestureController::IsCurrentDomainExcluded() const {
+  Browser* const browser = browser_view_ ? browser_view_->browser() : nullptr;
+  if (!browser) {
+    return false;
+  }
+
+  content::WebContents* const web_contents =
+      browser->tab_strip_model()->GetActiveWebContents();
+  if (!web_contents) {
+    return false;
+  }
+
+  GURL url = web_contents->GetVisibleURL();
+  if (!url.is_valid()) {
+    url = web_contents->GetLastCommittedURL();
+  }
+  if (!url.is_valid() || url.host().empty()) {
+    return false;
+  }
+
+  const std::string host = base::ToLowerASCII(url.host());
+  PrefService* const prefs = GetPrefs();
+  if (!prefs) {
+    return false;
+  }
+
+  for (const std::string& raw_pattern : base::SplitString(
+           prefs->GetString(mouse_gesture::prefs::kExcludedDomains), ",;\r\n\t ",
+           base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    const std::string pattern = NormalizeExcludedDomainPattern(raw_pattern);
+    if (HostMatchesExcludedPattern(host, pattern)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool BrowserMouseGestureController::HandleAuxiliaryTrigger(
+    std::string_view trigger) {
+  gesture_crossed_threshold_ = true;
+  suppress_next_right_release_ = true;
+  const Action action = GetMappedAuxiliaryAction(trigger);
+  if (action != Action::kUnknown && action != Action::kNone) {
+    ShowActionFeedback(action);
+  }
+  CancelGesture();
+  if (action != Action::kUnknown && action != Action::kNone) {
+    ExecuteAction(action);
+  }
+  return true;
+}
