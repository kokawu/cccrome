+  action_map.Set("L", "back");
+  action_map.Set("R", "forward");
+  action_map.Set("LU", "prev_tab");
+  action_map.Set("RU", "next_tab");
+  action_map.Set("LD", "close_tab_left");
+  action_map.Set("RD", "close_tab_right");
+  action_map.Set("UL", "new_window");
+  action_map.Set("UR", "new_tab");
+  action_map.Set("DL", "copy_url");
+  action_map.Set("DR", "open_clipboard_url");
+  action_map.Set("UD", "go_to_bottom");
+  action_map.Set("DU", "go_to_top");
+  action_map.Set("LR", "reload");
+  action_map.Set("RL", "restore_closed_tab");
+  return action_map;
+}
+
+base::DictValue CreateDefaultAuxiliaryActionMap() {
+  base::DictValue action_map;
+  action_map.Set("right_left_click", "back");
+  action_map.Set("right_middle_click", "none");
+  action_map.Set("wheel_up", "prev_tab");
+  action_map.Set("wheel_down", "next_tab");
+  return action_map;
+}
+
+std::string_view GetDefaultActionIdForGesture(std::string_view gesture) {
+  if (gesture == "U") {
+    return "page_up";
+  }
+  if (gesture == "D") {
+    return "page_down";
+  }
+  if (gesture == "L") {
+    return "back";
+  }
+  if (gesture == "R") {
+    return "forward";
+  }
+  if (gesture == "LU") {
+    return "prev_tab";
+  }
+  if (gesture == "RU") {
+    return "next_tab";
+  }
+  if (gesture == "LD") {
+    return "close_tab_left";
+  }
+  if (gesture == "RD") {
+    return "close_tab_right";
+  }
+  if (gesture == "UL") {
+    return "new_window";
+  }
+  if (gesture == "UR") {
+    return "new_tab";
+  }
+  if (gesture == "DL") {
+    return "copy_url";
+  }
+  if (gesture == "DR") {
+    return "open_clipboard_url";
+  }
+  if (gesture == "UD") {
+    return "go_to_bottom";
+  }
+  if (gesture == "DU") {
+    return "go_to_top";
+  }
+  if (gesture == "LR") {
+    return "reload";
+  }
+  if (gesture == "RL") {
+    return "restore_closed_tab";
+  }
+  return std::string_view();
+}
+
+std::string_view GetDefaultActionIdForAuxiliaryTrigger(
+    std::string_view trigger) {
+  if (trigger == "right_left_click") {
+    return "back";
+  }
+  if (trigger == "right_middle_click") {
+    return "none";
+  }
+  if (trigger == "wheel_up") {
+    return "prev_tab";
+  }
+  if (trigger == "wheel_down") {
+    return "next_tab";
+  }
+  return std::string_view();
+}
+
