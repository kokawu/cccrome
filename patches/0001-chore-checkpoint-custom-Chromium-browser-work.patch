+void WebContentsViewAura::HandleSourceDragUpdate(
+    const DropData& drop_data,
+    base::WeakPtr<RenderWidgetHostImpl> source_rwh,
+    const ui::DropTargetEvent& event) {
+  if (!source_rwh) {
+    return;
+  }
+
+  gfx::NativeView content_native_view = GetContentNativeView();
+  if (!content_native_view || !content_native_view->GetRootWindow()) {
+    HandleSourceDragExit();
+    return;
+  }
+
+  gfx::PointF screen_point = event.root_location_f();
+  if (aura::client::ScreenPositionClient* screen_position_client =
+          aura::client::GetScreenPositionClient(
+              content_native_view->GetRootWindow())) {
+    screen_position_client->ConvertPointToScreen(
+        content_native_view->GetRootWindow(), &screen_point);
+  } else if (display::Screen* screen = display::Screen::Get()) {
+    screen_point = gfx::PointF(screen->GetCursorScreenPoint());
+  }
+
+  if (!content_native_view->GetBoundsInScreen().Contains(
+          gfx::ToRoundedPoint(screen_point))) {
+    HandleSourceDragExit();
+    return;
+  }
+
+  gfx::PointF client_point = screen_point;
+  if (aura::client::ScreenPositionClient* screen_position_client =
+          aura::client::GetScreenPositionClient(
+              content_native_view->GetRootWindow())) {
+    screen_position_client->ConvertPointFromScreen(content_native_view,
+                                                   &client_point);
+  }
+
+  gfx::PointF transformed_point = client_point;
+  if (web_contents_->GetRenderWidgetHostView() && source_rwh->GetView()) {
+    static_cast<RenderWidgetHostViewBase*>(web_contents_->GetRenderWidgetHostView())
+        ->TransformPointToCoordSpaceForView(
+            client_point,
+            static_cast<RenderWidgetHostViewBase*>(source_rwh->GetView()),
+            &transformed_point);
+  }
+
+  web_contents_->PreHandleDragUpdate(drop_data, transformed_point);
+}
+
+void WebContentsViewAura::HandleSourceDragExit() {
+  web_contents_->PreHandleDragExit();
+}
