+
+    def open_url(self, url: str) -> dict[str, Any]:
+        self.ensure_browser()
+        encoded_url = urllib.parse.quote(url, safe='')
+        attempts = [
+            (f'/json/new?{encoded_url}', 'PUT'),
+            (f'/json/new?url={encoded_url}', 'PUT'),
+            (f'/json/new?{encoded_url}', 'GET'),
+            (f'/json/new?url={encoded_url}', 'GET'),
+        ]
+        created_tab: dict[str, Any] | None = None
+        for path, method in attempts:
+            try:
+                created_tab = self._request_devtools_json(path, method=method)
+                break
+            except common.BrowserctlError:
+                continue
+
+        if created_tab is None:
+            # Fall back to omnibox navigation if the DevTools helper endpoint
+            # is unavailable in this build.
+            created_tab = self.window_control_module.open_url_in_browser(
+                url=url,
+                process_name='chrome.exe',
+                target_pid=self._target_pid(),
+            )
+
+        return {
+            'opened': created_tab,
+            'tabs': self.list_tabs(),
+            'browser_pid': self.browser_pid,
+            'remote_debugging_port': self.remote_debugging_port,
+        }
+
+    def navigate_url(self, url: str) -> dict[str, Any]:
