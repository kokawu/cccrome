+#!/usr/bin/env python3
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+"""Single-track CLI for controlling a dedicated Chromium session."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+from typing import Any
+
+SCRIPT_DIR = Path(__file__).resolve().parent
+sys.path.insert(0, str(SCRIPT_DIR))
+
+import common
+import client as browserctl_client
+
+_DEFAULT_CLIENT = browserctl_client.BrowserctlClient()
+
+
+def _print_json(payload: Any) -> None:
+    print(json.dumps(payload, ensure_ascii=False, indent=2))
+
+
+def _cmd_daemon_start(args: argparse.Namespace) -> int:
+    client = browserctl_client.BrowserctlClient(
+        browser_binary=args.browser_binary,
+        user_data_dir=args.user_data_dir,
+        remote_debugging_port=args.remote_debugging_port,
+    )
+    client.start_daemon()
+    _print_json(client.status())
+    return 0
+
+
+def _cmd_daemon_stop(_args: argparse.Namespace) -> int:
+    _print_json(_DEFAULT_CLIENT.stop_daemon())
+    return 0
+
+
+def _cmd_status(_args: argparse.Namespace) -> int:
+    _print_json(_DEFAULT_CLIENT.status())
+    return 0
+
+
+def _cmd_windows(_args: argparse.Namespace) -> int:
+    _print_json(_DEFAULT_CLIENT.windows())
+    return 0
+
+
+def _cmd_tabs(_args: argparse.Namespace) -> int:
+    _print_json(_DEFAULT_CLIENT.tabs())
+    return 0
+
+
+def _cmd_open(args: argparse.Namespace) -> int:
+    _print_json(_DEFAULT_CLIENT.open(args.url))
+    return 0
+
+
+def _cmd_page(args: argparse.Namespace) -> int:
+    _print_json(_DEFAULT_CLIENT.page(limit=args.limit, tab_id=args.tab_id))
+    return 0
+
+
+def _cmd_observe(args: argparse.Namespace) -> int:
+    _print_json(_DEFAULT_CLIENT.observe(limit=args.limit, tab_id=args.tab_id))
+    return 0
+
+
+def _cmd_page_screenshot(args: argparse.Namespace) -> int:
+    _print_json(
+        _DEFAULT_CLIENT.page_screenshot(tab_id=args.tab_id,
+                                        full_page=args.full_page))
+    return 0
+
+
+def _cmd_eval(args: argparse.Namespace) -> int:
+    _print_json(_DEFAULT_CLIENT.eval(expression=args.expression,
+                                     tab_id=args.tab_id))
+    return 0
+
+
+def _cmd_activate_tab(args: argparse.Namespace) -> int:
+    _print_json(_DEFAULT_CLIENT.activate_tab(args.tab_id))
+    return 0
+
+
+def _cmd_snapshot(_args: argparse.Namespace) -> int:
+    _print_json(_DEFAULT_CLIENT.snapshot())
+    return 0
+
+
+def _cmd_screenshot(_args: argparse.Namespace) -> int:
+    _print_json(_DEFAULT_CLIENT.snapshot())
+    return 0
+
+
+def _cmd_focus(_args: argparse.Namespace) -> int:
+    _print_json(_DEFAULT_CLIENT.focus())
+    return 0
+
+
+def _cmd_window(args: argparse.Namespace) -> int:
+    _print_json(
+        _DEFAULT_CLIENT.window(left=args.left,
+                               top=args.top,
+                               width=args.width,
+                               height=args.height))
+    return 0
+
+
+def _cmd_click(args: argparse.Namespace) -> int:
+    _print_json(
+        _DEFAULT_CLIENT.click(x=args.x,
+                              y=args.y,
+                              button=args.button,
+                              clicks=args.clicks))
+    return 0
+
+
+def _cmd_click_element(args: argparse.Namespace) -> int:
+    _print_json(
+        _DEFAULT_CLIENT.click_element(selector=args.selector,
+                                      match_text=args.match_text,
+                                      index=args.index,
+                                      contains=not args.exact,
+                                      tab_id=args.tab_id))
+    return 0
+
+
+def _cmd_drag(args: argparse.Namespace) -> int:
+    _print_json(
+        _DEFAULT_CLIENT.drag(start_x=args.start_x,
+                             start_y=args.start_y,
+                             end_x=args.end_x,
+                             end_y=args.end_y,
+                             duration_ms=args.duration_ms))
+    return 0
+
+
+def _cmd_type_element(args: argparse.Namespace) -> int:
+    _print_json(
+        _DEFAULT_CLIENT.type_element(text=args.text,
+                                     selector=args.selector,
+                                     match_text=args.match_text,
+                                     index=args.index,
+                                     contains=not args.exact,
+                                     clear=args.clear,
+                                     press_enter=args.enter,
+                                     tab_id=args.tab_id))
+    return 0
+
+
+def _cmd_scroll(args: argparse.Namespace) -> int:
+    _print_json(
+        _DEFAULT_CLIENT.scroll(x=args.x,
+                               y=args.y,
+                               notches_y=args.notches_y,
+                               notches_x=args.notches_x))
+    return 0
+
+
+def _cmd_wait_selector(args: argparse.Namespace) -> int:
+    _print_json(
+        _DEFAULT_CLIENT.wait_selector(selector=args.selector,
+                                      timeout_ms=args.timeout_ms,
+                                      visible=not args.allow_hidden,
+                                      tab_id=args.tab_id))
+    return 0
+
+
+def _cmd_type(args: argparse.Namespace) -> int:
+    _print_json(_DEFAULT_CLIENT.type(text=args.text, press_enter=args.enter))
+    return 0
+
+
+def _cmd_press(args: argparse.Namespace) -> int:
+    _print_json(_DEFAULT_CLIENT.press(args.keys))
+    return 0
+
+
+def _cmd_navigate(args: argparse.Namespace) -> int:
+    _print_json(_DEFAULT_CLIENT.navigate(args.url))
+    return 0
+
+
+def _cmd_wait(args: argparse.Namespace) -> int:
+    _print_json(_DEFAULT_CLIENT.wait(args.milliseconds))
+    return 0
+
+
+def _parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    subparsers = parser.add_subparsers(dest='command', required=True)
+
+    daemon_parser = subparsers.add_parser('daemon')
+    daemon_subparsers = daemon_parser.add_subparsers(dest='daemon_command',
+                                                     required=True)
+    daemon_start = daemon_subparsers.add_parser('start')
+    daemon_start.add_argument('--browser-binary',
+                              default=str(common.DEFAULT_BROWSER_BINARY))
+    daemon_start.add_argument('--user-data-dir',
+                              default=str(common.DEFAULT_PROFILE_DIR))
+    daemon_start.add_argument('--remote-debugging-port',
+                              type=int,
+                              default=0)
+    daemon_start.set_defaults(func=_cmd_daemon_start)
+
+    daemon_stop = daemon_subparsers.add_parser('stop')
+    daemon_stop.set_defaults(func=_cmd_daemon_stop)
+
+    status_parser = subparsers.add_parser('status')
+    status_parser.set_defaults(func=_cmd_status)
+
+    windows_parser = subparsers.add_parser('windows')
+    windows_parser.set_defaults(func=_cmd_windows)
+
+    tabs_parser = subparsers.add_parser('tabs')
+    tabs_parser.set_defaults(func=_cmd_tabs)
+
+    open_parser = subparsers.add_parser('open')
+    open_parser.add_argument('url')
+    open_parser.set_defaults(func=_cmd_open)
+
+    page_parser = subparsers.add_parser('page')
+    page_parser.add_argument('--limit', type=int, default=80)
+    page_parser.add_argument('--tab-id', default='')
+    page_parser.set_defaults(func=_cmd_page)
+
+    observe_parser = subparsers.add_parser('observe')
+    observe_parser.add_argument('--limit', type=int, default=80)
+    observe_parser.add_argument('--tab-id', default='')
+    observe_parser.set_defaults(func=_cmd_observe)
+
+    page_screenshot_parser = subparsers.add_parser('page-screenshot')
+    page_screenshot_parser.add_argument('--tab-id', default='')
+    page_screenshot_parser.add_argument('--full-page', action='store_true')
+    page_screenshot_parser.set_defaults(func=_cmd_page_screenshot)
+
+    eval_parser = subparsers.add_parser('eval')
+    eval_parser.add_argument('expression')
+    eval_parser.add_argument('--tab-id', default='')
+    eval_parser.set_defaults(func=_cmd_eval)
+
+    activate_tab_parser = subparsers.add_parser('activate-tab')
+    activate_tab_parser.add_argument('tab_id')
+    activate_tab_parser.set_defaults(func=_cmd_activate_tab)
+
+    snapshot_parser = subparsers.add_parser('snapshot')
+    snapshot_parser.set_defaults(func=_cmd_snapshot)
+
+    screenshot_parser = subparsers.add_parser('screenshot')
+    screenshot_parser.set_defaults(func=_cmd_screenshot)
+
+    focus_parser = subparsers.add_parser('focus')
+    focus_parser.set_defaults(func=_cmd_focus)
+
+    window_parser = subparsers.add_parser('window')
+    window_parser.add_argument('--left', type=int, default=-1)
+    window_parser.add_argument('--top', type=int, default=-1)
+    window_parser.add_argument('--width', type=int, default=-1)
+    window_parser.add_argument('--height', type=int, default=-1)
+    window_parser.set_defaults(func=_cmd_window)
+
+    click_parser = subparsers.add_parser('click')
+    click_parser.add_argument('--x', type=int, required=True)
+    click_parser.add_argument('--y', type=int, required=True)
+    click_parser.add_argument('--button', default='left')
+    click_parser.add_argument('--clicks', type=int, default=1)
+    click_parser.set_defaults(func=_cmd_click)
+
+    click_element_parser = subparsers.add_parser('click-element')
+    click_element_parser.add_argument('--selector', default='')
+    click_element_parser.add_argument('--match-text', default='')
+    click_element_parser.add_argument('--index', type=int, default=-1)
+    click_element_parser.add_argument('--exact', action='store_true')
+    click_element_parser.add_argument('--tab-id', default='')
+    click_element_parser.set_defaults(func=_cmd_click_element)
+
+    drag_parser = subparsers.add_parser('drag')
+    drag_parser.add_argument('--start-x', dest='start_x', type=int, required=True)
+    drag_parser.add_argument('--start-y', dest='start_y', type=int, required=True)
+    drag_parser.add_argument('--end-x', dest='end_x', type=int, required=True)
+    drag_parser.add_argument('--end-y', dest='end_y', type=int, required=True)
+    drag_parser.add_argument('--duration-ms',
+                             dest='duration_ms',
+                             type=int,
+                             default=400)
+    drag_parser.set_defaults(func=_cmd_drag)
+
+    scroll_parser = subparsers.add_parser('scroll')
+    scroll_parser.add_argument('--x', type=int, required=True)
+    scroll_parser.add_argument('--y', type=int, required=True)
+    scroll_parser.add_argument('--notches-y',
+                               dest='notches_y',
+                               type=int,
+                               required=True)
+    scroll_parser.add_argument('--notches-x', dest='notches_x', type=int, default=0)
+    scroll_parser.set_defaults(func=_cmd_scroll)
+
+    type_element_parser = subparsers.add_parser('type-element')
+    type_element_parser.add_argument('text')
+    type_element_parser.add_argument('--selector', default='')
+    type_element_parser.add_argument('--match-text', default='')
+    type_element_parser.add_argument('--index', type=int, default=-1)
+    type_element_parser.add_argument('--exact', action='store_true')
+    type_element_parser.add_argument('--clear', action='store_true')
+    type_element_parser.add_argument('--enter', action='store_true')
+    type_element_parser.add_argument('--tab-id', default='')
+    type_element_parser.set_defaults(func=_cmd_type_element)
+
+    wait_selector_parser = subparsers.add_parser('wait-selector')
+    wait_selector_parser.add_argument('selector')
+    wait_selector_parser.add_argument('--timeout-ms', type=int, default=5000)
+    wait_selector_parser.add_argument('--allow-hidden', action='store_true')
+    wait_selector_parser.add_argument('--tab-id', default='')
+    wait_selector_parser.set_defaults(func=_cmd_wait_selector)
+
+    type_parser = subparsers.add_parser('type')
+    type_parser.add_argument('text')
+    type_parser.add_argument('--enter', action='store_true')
+    type_parser.set_defaults(func=_cmd_type)
+
+    press_parser = subparsers.add_parser('press')
+    press_parser.add_argument('keys')
+    press_parser.set_defaults(func=_cmd_press)
+
+    navigate_parser = subparsers.add_parser('navigate')
+    navigate_parser.add_argument('url')
+    navigate_parser.set_defaults(func=_cmd_navigate)
+
+    wait_parser = subparsers.add_parser('wait')
+    wait_parser.add_argument('milliseconds', type=int)
+    wait_parser.set_defaults(func=_cmd_wait)
+
+    return parser.parse_args()
+
+
+def main() -> int:
+    try:
+        args = _parse_args()
+        return args.func(args)
+    except common.BrowserctlError as exc:
+        print(json.dumps({'error': str(exc)}, ensure_ascii=False, indent=2),
+              file=sys.stderr)
+        return 1
+    except KeyboardInterrupt:
+        print(json.dumps({'error': 'Interrupted.'}, ensure_ascii=False, indent=2),
+              file=sys.stderr)
+        return 130
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
