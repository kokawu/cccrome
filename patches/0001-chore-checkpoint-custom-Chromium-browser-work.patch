+bool CloseTabAndActivateContents(Browser* browser,
+                                 content::WebContents* target_contents) {
+  if (!browser) {
+    return false;
+  }
+
+  TabStripModel* const model = browser->tab_strip_model();
+  const int active_index = model->active_index();
+  if (!model->ContainsIndex(active_index) || !model->IsTabClosable(active_index)) {
+    return false;
+  }
+
+  model->CloseWebContentsAt(active_index, TabCloseTypes::CLOSE_USER_GESTURE);
+
+  if (!target_contents) {
+    return true;
+  }
+
+  const int target_index = model->GetIndexOfWebContents(target_contents);
+  if (model->ContainsIndex(target_index)) {
+    model->ActivateTabAt(
+        target_index,
+        TabStripUserGestureDetails(TabStripUserGestureDetails::GestureType::kOther));
+  }
+  return true;
+}
+
+bool CloseTabsByDescendingIndices(TabStripModel* model,
+                                  const std::vector<int>& indices) {
+  if (!model) {
+    return false;
+  }
+
+  bool closed_any = false;
+  for (int index : indices) {
+    if (!model->ContainsIndex(index) || !model->IsTabClosable(index)) {
+      continue;
+    }
+    model->CloseWebContentsAt(index, TabCloseTypes::CLOSE_USER_GESTURE);
+    closed_any = true;
+  }
+  return closed_any;
+}
+
+content::WebContents* GetMostRecentlyFocusedTab(TabStripModel* model,
+                                                int ignored_index) {
+  if (!model) {
+    return nullptr;
+  }
+
+  content::WebContents* target_contents = nullptr;
+  base::Time target_last_focused;
+  for (int index = 0; index < model->count(); ++index) {
+    if (index == ignored_index || model->IsTabCollapsed(index)) {
+      continue;
+    }
+
+    content::WebContents* const contents = model->GetWebContentsAt(index);
+    if (!contents) {
+      continue;
+    }
+
+    resource_coordinator::TabLifecycleUnitExternal* const lifecycle_unit =
+        resource_coordinator::TabLifecycleUnitSource::GetTabLifecycleUnitExternal(
+            contents);
+    const base::Time last_focused =
+        lifecycle_unit ? lifecycle_unit->GetLastFocusedTime()
+                       : base::Time();
+    if (!target_contents || last_focused > target_last_focused) {
+      target_contents = contents;
+      target_last_focused = last_focused;
+    }
+  }
+
+  return target_contents;
+}
