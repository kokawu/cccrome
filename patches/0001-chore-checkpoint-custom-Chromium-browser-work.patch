+      return false;
+    }
+    const style = window.getComputedStyle(element);
+    if (!style) {
+      return true;
+    }
+    if (style.display === 'none' || style.visibility === 'hidden' ||
+        style.opacity === '0') {
+      return false;
+    }
+    return true;
+  }
+
+  function cssEscape(value) {
+    if (window.CSS && typeof window.CSS.escape === 'function') {
