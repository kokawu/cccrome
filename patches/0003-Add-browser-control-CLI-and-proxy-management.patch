+#!/usr/bin/env python3
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+"""Human-friendly one-command entrypoint for browserctl agent control."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+SCRIPT_DIR = Path(__file__).resolve().parent
+REPO_ROOT = SCRIPT_DIR.parents[1]
+WORKSPACE_ROOT = REPO_ROOT.parent
+sys.path.insert(0, str(SCRIPT_DIR))
+
+import client as browserctl_client
+import common
+
+_SERVER_PATH = REPO_ROOT / 'agents' / 'extensions' / 'browserctl' / 'server.py'
+_INSTALL_PATH = REPO_ROOT / 'agents' / 'extensions' / 'install.py'
+
+
+def _print_json(payload: Any) -> None:
+    print(json.dumps(payload, ensure_ascii=False, indent=2))
+
+
+def _find_vpython3() -> str:
+    candidates = [
+        shutil.which('vpython3'),
+        shutil.which('vpython3.bat'),
+        str(WORKSPACE_ROOT / 'depot_tools' / 'vpython3'),
+        str(WORKSPACE_ROOT / 'depot_tools' / 'vpython3.bat'),
+    ]
+    for candidate in candidates:
+        if candidate and Path(candidate).exists():
+            return candidate
+    raise common.BrowserctlError(
+        'Could not find vpython3. Expected it on PATH or under depot_tools.')
+
+
+def _make_client(args: argparse.Namespace) -> browserctl_client.BrowserctlClient:
+    return browserctl_client.BrowserctlClient(
+        browser_binary=args.browser_binary,
+        user_data_dir=args.user_data_dir,
+        remote_debugging_port=args.remote_debugging_port,
+    )
+
+
+def _ensure_session(client: browserctl_client.BrowserctlClient,
+                    args: argparse.Namespace) -> dict[str, Any]:
+    client.start_daemon()
+    setup: dict[str, Any] = {}
+    if getattr(args, 'normalize_window', True):
+        setup['window'] = client.window(left=args.left,
+                                        top=args.top,
+                                        width=args.width,
+                                        height=args.height)
+        setup['focus'] = client.focus()
+    if getattr(args, 'url', ''):
+        setup['navigate'] = client.navigate(args.url)
+    return {
+        'status': client.status(),
+        'setup': setup,
+    }
+
+
+def _server_command(args: argparse.Namespace) -> list[str]:
+    command = [_find_vpython3(), str(_SERVER_PATH)]
+    if args.browser_binary:
+        command.extend(['--browser-binary', args.browser_binary])
+    if args.user_data_dir:
+        command.extend(['--user-data-dir', args.user_data_dir])
+    if args.remote_debugging_port:
+        command.extend(['--remote-debugging-port',
+                        str(args.remote_debugging_port)])
+    return command
+
+
+def _cmd_up(args: argparse.Namespace) -> int:
+    _print_json(_ensure_session(_make_client(args), args))
+    return 0
+
+
+def _cmd_status(args: argparse.Namespace) -> int:
+    _print_json(_make_client(args).status())
+    return 0
+
+
+def _cmd_observe(args: argparse.Namespace) -> int:
+    _print_json(_make_client(args).observe(limit=args.limit, tab_id=args.tab_id))
+    return 0
+
+
+def _cmd_open(args: argparse.Namespace) -> int:
+    _print_json(_make_client(args).open(args.url))
+    return 0
+
+
+def _cmd_navigate(args: argparse.Namespace) -> int:
+    _print_json(_make_client(args).navigate(args.url))
+    return 0
+
+
+def _cmd_stop(args: argparse.Namespace) -> int:
+    _print_json(_make_client(args).stop_daemon())
+    return 0
+
+
+def _apply_proxy_config(proxy: dict[str, str]) -> dict[str, Any]:
+    state = common.load_state()
+    was_running = browserctl_client.daemon_is_healthy(state)
+    config = common.load_config()
+    config['proxy'] = common.normalize_proxy_config(proxy)
+    common.save_config(config)
+
+    restarted = False
+    if was_running:
+        browser_binary = str(state.get('browser_binary') or
+                             common.DEFAULT_BROWSER_BINARY)
+        user_data_dir = str(state.get('user_data_dir') or
+                            common.DEFAULT_PROFILE_DIR)
+        remote_debugging_port = int(
+            state.get('remote_debugging_port') or 0)
+        browserctl_client.stop_daemon()
+        browserctl_client.start_daemon(browser_binary, user_data_dir,
+                                       remote_debugging_port)
+        restarted = True
+    return {
+        'ok': True,
+        'proxy': config['proxy'],
+        'browser_restarted': restarted,
+        'config_file': str(common.CONFIG_FILE),
+    }
+
+
+def _cmd_proxy_show(_args: argparse.Namespace) -> int:
+    _print_json({
+        'proxy': common.load_config()['proxy'],
+        'config_file': str(common.CONFIG_FILE),
+    })
+    return 0
+
+
+def _cmd_proxy_set(args: argparse.Namespace) -> int:
+    server = args.server.strip()
+    if not server:
+        raise common.BrowserctlError('Proxy server cannot be empty.')
+    if '@' in server:
+        raise common.BrowserctlError(
+            'Proxy URLs with embedded credentials are not supported.')
+    _print_json(
+        _apply_proxy_config({
+            'mode': 'fixed',
+            'server': server,
+            'bypass_list': args.bypass,
+        }))
+    return 0
+
+
+def _cmd_proxy_pac(args: argparse.Namespace) -> int:
+    pac_url = args.url.strip()
+    if not pac_url:
+        raise common.BrowserctlError('PAC URL cannot be empty.')
+    _print_json(
+        _apply_proxy_config({
+            'mode': 'pac',
+            'pac_url': pac_url,
+            'bypass_list': args.bypass,
+        }))
+    return 0
+
+
+def _cmd_proxy_system(_args: argparse.Namespace) -> int:
+    _print_json(_apply_proxy_config({'mode': 'system'}))
+    return 0
+
+
+def _cmd_proxy_off(_args: argparse.Namespace) -> int:
+    _print_json(_apply_proxy_config({'mode': 'direct'}))
+    return 0
+
+
+def _cmd_doctor(args: argparse.Namespace) -> int:
+    command = _server_command(args) + ['--self-test']
+    completed = subprocess.run(command, cwd=str(REPO_ROOT), check=False)
+    return int(completed.returncode)
+
+
+def _cmd_install(_args: argparse.Namespace) -> int:
+    command = [_find_vpython3(), str(_INSTALL_PATH), 'add', 'browserctl']
+    completed = subprocess.run(command, cwd=str(REPO_ROOT), check=False)
+    return int(completed.returncode)
+
+
+def _cmd_mcp(args: argparse.Namespace) -> int:
+    client = _make_client(args)
+    if not args.skip_up:
+        _ensure_session(client, args)
+    command = _server_command(args)
+    completed = subprocess.run(command, cwd=str(REPO_ROOT), check=False)
+    return int(completed.returncode)
+
+
+def _add_shared_client_args(parser: argparse.ArgumentParser) -> None:
+    parser.add_argument('--browser-binary',
+                        default=str(common.DEFAULT_BROWSER_BINARY))
+    parser.add_argument('--user-data-dir',
+                        default=str(common.DEFAULT_PROFILE_DIR))
+    parser.add_argument('--remote-debugging-port', type=int, default=0)
+
+
+def _add_window_args(parser: argparse.ArgumentParser) -> None:
+    parser.add_argument('--left', type=int, default=80)
+    parser.add_argument('--top', type=int, default=40)
+    parser.add_argument('--width', type=int, default=1280)
+    parser.add_argument('--height', type=int, default=960)
+    parser.add_argument('--no-normalize-window',
+                        dest='normalize_window',
+                        action='store_false')
+    parser.set_defaults(normalize_window=True)
+
+
+def _parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    subparsers = parser.add_subparsers(dest='command', required=True)
+
+    up_parser = subparsers.add_parser(
+        'up',
+        help='Start or reuse the managed browser session and normalize window.')
+    up_parser.add_argument('url', nargs='?', default='')
+    _add_window_args(up_parser)
+    _add_shared_client_args(up_parser)
+    up_parser.set_defaults(func=_cmd_up)
+
+    status_parser = subparsers.add_parser('status',
+                                          help='Show managed session status.')
+    _add_shared_client_args(status_parser)
+    status_parser.set_defaults(func=_cmd_status)
+
+    observe_parser = subparsers.add_parser(
+        'observe',
+        help='Return one combined window screenshot plus DOM summary.')
+    observe_parser.add_argument('--limit', type=int, default=40)
+    observe_parser.add_argument('--tab-id', default='')
+    _add_shared_client_args(observe_parser)
+    observe_parser.set_defaults(func=_cmd_observe)
+
+    open_parser = subparsers.add_parser('open', help='Open a new tab URL.')
+    open_parser.add_argument('url')
+    _add_shared_client_args(open_parser)
+    open_parser.set_defaults(func=_cmd_open)
+
+    navigate_parser = subparsers.add_parser(
+        'go', help='Navigate current tab with the omnibox-like path.')
+    navigate_parser.add_argument('url')
+    _add_shared_client_args(navigate_parser)
+    navigate_parser.set_defaults(func=_cmd_navigate)
+
+    stop_parser = subparsers.add_parser('stop',
+                                        help='Stop the managed browser session.')
+    _add_shared_client_args(stop_parser)
+    stop_parser.set_defaults(func=_cmd_stop)
+
+    proxy_parser = subparsers.add_parser(
+        'proxy', help='Show or change the persistent proxy configuration.')
+    proxy_subparsers = proxy_parser.add_subparsers(dest='proxy_command',
+                                                   required=True)
+
+    proxy_show_parser = proxy_subparsers.add_parser(
+        'show', help='Show the current proxy configuration.')
+    proxy_show_parser.set_defaults(func=_cmd_proxy_show)
+
+    proxy_set_parser = proxy_subparsers.add_parser(
+        'set', help='Use a fixed HTTP, HTTPS, SOCKS, or proxy mapping.')
+    proxy_set_parser.add_argument('server')
+    proxy_set_parser.add_argument('--bypass', default='')
+    proxy_set_parser.set_defaults(func=_cmd_proxy_set)
+
+    proxy_pac_parser = proxy_subparsers.add_parser(
+        'pac', help='Use a PAC URL.')
+    proxy_pac_parser.add_argument('url')
+    proxy_pac_parser.add_argument('--bypass', default='')
+    proxy_pac_parser.set_defaults(func=_cmd_proxy_pac)
+
+    proxy_system_parser = proxy_subparsers.add_parser(
+        'system', help='Use the operating system proxy configuration.')
+    proxy_system_parser.set_defaults(func=_cmd_proxy_system)
+
+    proxy_off_parser = proxy_subparsers.add_parser(
+        'off', help='Force direct connections without a proxy.')
+    proxy_off_parser.set_defaults(func=_cmd_proxy_off)
+
+    doctor_parser = subparsers.add_parser(
+        'doctor',
+        help='Run a real self-test against the MCP wrapper and managed browser.')
+    _add_shared_client_args(doctor_parser)
+    doctor_parser.set_defaults(func=_cmd_doctor)
+
+    install_parser = subparsers.add_parser(
+        'install',
+        help='Install the browserctl MCP extension into Gemini CLI.')
+    install_parser.set_defaults(func=_cmd_install)
+
+    mcp_parser = subparsers.add_parser(
+        'mcp',
+        help='Start the MCP server. This is the main agent-facing entrypoint.')
+    mcp_parser.add_argument('url', nargs='?', default='')
+    mcp_parser.add_argument('--skip-up', action='store_true')
+    _add_window_args(mcp_parser)
+    _add_shared_client_args(mcp_parser)
+    mcp_parser.set_defaults(func=_cmd_mcp)
+
+    return parser.parse_args()
+
+
+def main() -> int:
+    try:
+        args = _parse_args()
+        return int(args.func(args))
+    except common.BrowserctlError as exc:
+        _print_json({'error': str(exc)})
+        return 1
+    except KeyboardInterrupt:
+        _print_json({'error': 'Interrupted.'})
+        return 130
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
