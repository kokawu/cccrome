+        self.ensure_browser()
+        all_windows = self.window_control_module.list_browser_windows(
+            process_name='chrome.exe')
+        matching_pids = {
+            int(process['Id']) for process in self._matching_processes_for_binary()
+        }
+        if self.window_pid:
+            matching_pids.add(int(self.window_pid))
+        return [
+            window for window in all_windows if int(window['pid']) in matching_pids
+        ]
