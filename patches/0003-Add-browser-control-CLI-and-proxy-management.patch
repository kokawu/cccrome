+        self.write_state()
+        return result
+
+    def click(self, payload: dict[str, Any]) -> dict[str, Any]:
+        result = self.session.click(
+            x=int(payload['x']),
+            y=int(payload['y']),
+            button=str(payload.get('button', 'left')),
+            clicks=int(payload.get('clicks', 1)),
+        )
+        self.write_state()
+        return result
+
+    def drag(self, payload: dict[str, Any]) -> dict[str, Any]:
+        result = self.session.drag(
+            start_x=int(payload['start_x']),
+            start_y=int(payload['start_y']),
+            end_x=int(payload['end_x']),
+            end_y=int(payload['end_y']),
+            duration_ms=int(payload.get('duration_ms', 400)),
+        )
+        self.write_state()
+        return result
+
+    def scroll(self, payload: dict[str, Any]) -> dict[str, Any]:
+        result = self.session.scroll(
+            x=int(payload['x']),
+            y=int(payload['y']),
+            notches_y=int(payload['notches_y']),
+            notches_x=int(payload.get('notches_x', 0)),
+        )
+        self.write_state()
+        return result
+
+    def type_text(self, payload: dict[str, Any]) -> dict[str, Any]:
+        result = self.session.type_text(
+            text=str(payload['text']),
+            press_enter=bool(payload.get('press_enter', False)),
+        )
+        self.write_state()
+        return result
+
+    def press(self, payload: dict[str, Any]) -> dict[str, Any]:
+        result = self.session.press_keys(str(payload['keys']))
+        self.write_state()
+        return result
+
+    def navigate(self, payload: dict[str, Any]) -> dict[str, Any]:
+        result = self.session.navigate_url(str(payload['url']))
+        self.write_state()
+        return result
+
+    def wait(self, payload: dict[str, Any]) -> dict[str, Any]:
+        result = self.session.wait(int(payload.get('milliseconds', 500)))
+        self.write_state()
+        return result
+
+    def inspect_page(self, payload: dict[str, Any]) -> dict[str, Any]:
+        result = self.session.inspect_page(limit=int(payload.get('limit', 80)),
+                                           tab_id=str(payload.get('tab_id', '')))
+        self.write_state()
+        return result
+
+    def observe(self, payload: dict[str, Any]) -> dict[str, Any]:
+        result = self.session.observe(limit=int(payload.get('limit', 80)),
+                                      tab_id=str(payload.get('tab_id', '')))
+        self.write_state()
+        return result
+
+    def capture_page_screenshot(self, payload: dict[str, Any]) -> dict[str, Any]:
+        result = self.session.capture_page_screenshot(
+            tab_id=str(payload.get('tab_id', '')),
+            full_page=bool(payload.get('full_page', False)))
+        self.write_state()
+        return result
+
+    def evaluate(self, payload: dict[str, Any]) -> dict[str, Any]:
+        result = self.session.evaluate(expression=str(payload['expression']),
+                                       tab_id=str(payload.get('tab_id', '')))
+        self.write_state()
+        return result
+
+    def activate_tab(self, payload: dict[str, Any]) -> dict[str, Any]:
+        result = self.session.activate_tab(str(payload['tab_id']))
+        self.write_state()
+        return result
+
+    def click_element(self, payload: dict[str, Any]) -> dict[str, Any]:
+        result = self.session.click_element(
+            selector=str(payload.get('selector', '')),
+            match_text=str(payload.get('match_text', '')),
+            index=int(payload.get('index', -1)),
+            contains=bool(payload.get('contains', True)),
+            tab_id=str(payload.get('tab_id', '')),
+        )
+        self.write_state()
+        return result
+
+    def type_element(self, payload: dict[str, Any]) -> dict[str, Any]:
+        result = self.session.type_element(
+            text=str(payload['text']),
+            selector=str(payload.get('selector', '')),
+            match_text=str(payload.get('match_text', '')),
+            index=int(payload.get('index', -1)),
+            contains=bool(payload.get('contains', True)),
+            clear=bool(payload.get('clear', False)),
+            press_enter=bool(payload.get('press_enter', False)),
+            tab_id=str(payload.get('tab_id', '')),
+        )
+        self.write_state()
+        return result
+
+    def wait_for_selector(self, payload: dict[str, Any]) -> dict[str, Any]:
+        result = self.session.wait_for_selector(
+            selector=str(payload['selector']),
+            timeout_ms=int(payload.get('timeout_ms', 5000)),
+            visible=bool(payload.get('visible', True)),
+            tab_id=str(payload.get('tab_id', '')),
+        )
+        self.write_state()
+        return result
+
+    def request_shutdown(self) -> None:
+        def _shutdown() -> None:
+            time.sleep(0.1)
+            if self.httpd:
+                self.httpd.shutdown()
+
+        threading.Thread(target=_shutdown, daemon=True).start()
+
+    def serve_forever(self) -> None:
+        self.session.ensure_browser()
+        self.write_state()
+        self.httpd = ThreadingHTTPServer((self.host, self.port),
+                                         BrowserRequestHandler)
+        self.httpd.controller = self
+        try:
+            self.httpd.serve_forever()
+        finally:
+            self.session.stop_browser()
+            common.clear_state()
+
+
+class BrowserRequestHandler(BaseHTTPRequestHandler):
+    server_version = 'browserd/0.1'
+
+    def log_message(self, format: str, *args: Any) -> None:
+        return
+
+    @property
+    def controller(self) -> BrowserDaemon:
+        return self.server.controller
+
+    def _authenticate(self) -> bool:
+        token = self.headers.get('X-Browserctl-Token', '')
+        if token != self.controller.token:
+            self._send_json(403, {'error': 'Forbidden'})
+            return False
+        return True
+
+    def _read_json_body(self) -> dict[str, Any]:
+        content_length = int(self.headers.get('Content-Length', '0'))
+        if content_length <= 0:
+            return {}
+        raw_body = self.rfile.read(content_length)
+        return json.loads(raw_body.decode('utf-8'))
+
+    def _send_json(self, status_code: int, payload: dict[str, Any]) -> None:
+        encoded = json.dumps(payload, ensure_ascii=False).encode('utf-8')
+        self.send_response(status_code)
+        self.send_header('Content-Type', 'application/json; charset=utf-8')
+        self.send_header('Content-Length', str(len(encoded)))
+        self.end_headers()
+        self.wfile.write(encoded)
+
+    def do_GET(self) -> None:
+        if not self._authenticate():
+            return
+        try:
+            if self.path == '/ping':
+                payload = {'ok': True, 'pid': os.getpid()}
+            else:
+                with self.controller.command_lock:
+                    if self.path == '/status':
+                        payload = self.controller.status()
+                    elif self.path == '/focus':
+                        payload = self.controller.focus()
+                    elif self.path == '/tabs':
+                        payload = self.controller.tabs()
+                    elif self.path == '/windows':
+                        payload = self.controller.windows()
+                    elif self.path in ('/snapshot', '/screenshot'):
+                        payload = self.controller.snapshot()
+                    else:
+                        self._send_json(404,
+                                        {'error': f'Unknown path: {self.path}'})
+                        return
+            self._send_json(200, payload)
+        except Exception as exc:
+            self._send_json(500, {'error': str(exc)})
+
+    def do_POST(self) -> None:
+        if not self._authenticate():
+            return
+        try:
+            payload = self._read_json_body()
+            with self.controller.command_lock:
+                if self.path == '/open':
+                    response = self.controller.open_url(str(payload['url']))
+                elif self.path == '/navigate':
+                    response = self.controller.navigate(payload)
+                elif self.path == '/page':
+                    response = self.controller.inspect_page(payload)
+                elif self.path == '/observe':
+                    response = self.controller.observe(payload)
+                elif self.path == '/page-screenshot':
+                    response = self.controller.capture_page_screenshot(payload)
+                elif self.path == '/eval':
+                    response = self.controller.evaluate(payload)
+                elif self.path == '/activate-tab':
+                    response = self.controller.activate_tab(payload)
+                elif self.path == '/click-element':
+                    response = self.controller.click_element(payload)
+                elif self.path == '/type-element':
+                    response = self.controller.type_element(payload)
+                elif self.path == '/wait-selector':
+                    response = self.controller.wait_for_selector(payload)
+                elif self.path == '/window':
+                    response = self.controller.set_window_bounds(payload)
+                elif self.path == '/click':
+                    response = self.controller.click(payload)
+                elif self.path == '/drag':
+                    response = self.controller.drag(payload)
+                elif self.path == '/scroll':
+                    response = self.controller.scroll(payload)
+                elif self.path == '/type':
+                    response = self.controller.type_text(payload)
+                elif self.path == '/press':
+                    response = self.controller.press(payload)
+                elif self.path == '/wait':
+                    response = self.controller.wait(payload)
+                elif self.path == '/shutdown':
+                    response = {'ok': True}
+                    self.controller.request_shutdown()
+                else:
+                    self._send_json(404,
+                                    {'error': f'Unknown path: {self.path}'})
+                    return
+            self._send_json(200, response)
+        except Exception as exc:
+            self._send_json(500, {'error': str(exc)})
+
+
+def _parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    subparsers = parser.add_subparsers(dest='command', required=True)
+
+    serve_parser = subparsers.add_parser('serve')
+    serve_parser.add_argument('--browser-binary',
+                              default=str(common.DEFAULT_BROWSER_BINARY))
+    serve_parser.add_argument('--user-data-dir',
+                              default=str(common.DEFAULT_PROFILE_DIR))
+    serve_parser.add_argument('--host', default=common.DAEMON_HOST)
+    serve_parser.add_argument('--port', type=int, default=common.find_free_port())
+    serve_parser.add_argument('--remote-debugging-port',
+                              type=int,
+                              default=common.find_free_port())
+    serve_parser.add_argument('--token', default='')
+    return parser.parse_args()
+
+
+def main() -> int:
+    args = _parse_args()
+    common.ensure_runtime_dir()
+    token = args.token or secrets.token_urlsafe(32)
+    daemon = BrowserDaemon(
+        browser_binary=Path(args.browser_binary),
+        user_data_dir=Path(args.user_data_dir),
+        host=args.host,
+        port=int(args.port),
+        remote_debugging_port=int(args.remote_debugging_port),
+        token=token,
+    )
+    daemon.serve_forever()
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
