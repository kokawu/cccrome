+#!/usr/bin/env python3
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+from __future__ import annotations
+
+import sys
+import unittest
+from pathlib import Path
+
+SCRIPT_DIR = Path(__file__).resolve().parent
+sys.path.insert(0, str(SCRIPT_DIR))
+
+import common
+
+
+class ProxyConfigTest(unittest.TestCase):
+    def test_system_proxy_has_no_command_line_arguments(self) -> None:
+        self.assertEqual([], common.proxy_command_line_args({'mode': 'system'}))
+
+    def test_direct_proxy_disables_proxy_server(self) -> None:
+        self.assertEqual(['--no-proxy-server'],
+                         common.proxy_command_line_args({'mode': 'direct'}))
+
+    def test_fixed_proxy_includes_server_and_bypass_list(self) -> None:
+        self.assertEqual(
+            [
+                '--proxy-server=socks5://127.0.0.1:1080',
+                '--proxy-bypass-list=localhost;127.0.0.1',
+            ],
+            common.proxy_command_line_args({
+                'mode': 'fixed',
+                'server': 'socks5://127.0.0.1:1080',
+                'bypass_list': 'localhost;127.0.0.1',
+            }))
+
+    def test_pac_proxy_includes_pac_url(self) -> None:
+        self.assertEqual(
+            ['--proxy-pac-url=http://127.0.0.1:8080/proxy.pac'],
+            common.proxy_command_line_args({
+                'mode': 'pac',
+                'pac_url': 'http://127.0.0.1:8080/proxy.pac',
+            }))
+
+    def test_fixed_proxy_requires_server(self) -> None:
+        with self.assertRaises(common.BrowserctlError):
+            common.proxy_command_line_args({'mode': 'fixed'})
+
+    def test_invalid_mode_falls_back_to_system(self) -> None:
+        self.assertEqual('system',
+                         common.normalize_proxy_config({'mode': 'bad'})['mode'])
+
+
+if __name__ == '__main__':
+    unittest.main()
