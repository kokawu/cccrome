+#!/usr/bin/env python3
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+"""Shared helpers for browserctl and browserd."""
+
+from __future__ import annotations
+
+import json
+import os
+import socket
+import urllib.error
+import urllib.request
+from pathlib import Path
+from typing import Any
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+RUNTIME_DIR = REPO_ROOT / 'out' / 'browserctl'
+STATE_FILE = RUNTIME_DIR / 'daemon_state.json'
+LOG_FILE = RUNTIME_DIR / 'browserd.log'
+CONFIG_FILE = RUNTIME_DIR / 'config.json'
+DEFAULT_PROFILE_DIR = RUNTIME_DIR / 'profile'
+DEFAULT_BROWSER_BINARY = REPO_ROOT / 'out' / 'UpstreamFastDev' / 'chrome.exe'
+DAEMON_HOST = '127.0.0.1'
+DEFAULT_REQUEST_TIMEOUT = 10.0
+
+_DEFAULT_PROXY_CONFIG = {
+    'mode': 'system',
+    'server': '',
+    'pac_url': '',
+    'bypass_list': '',
+}
+
+
+class BrowserctlError(RuntimeError):
+    """Raised when browserctl or browserd cannot complete a request."""
+
+
+def ensure_runtime_dir() -> None:
+    RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
+
+
+def load_state() -> dict[str, Any] | None:
+    if not STATE_FILE.exists():
+        return None
+    try:
+        return json.loads(STATE_FILE.read_text(encoding='utf-8'))
+    except (FileNotFoundError, OSError, json.JSONDecodeError):
+        return None
+
+
+def save_state(data: dict[str, Any]) -> None:
+    ensure_runtime_dir()
+    STATE_FILE.write_text(
+        json.dumps(data, ensure_ascii=False, indent=2), encoding='utf-8')
+
+
+def clear_state() -> None:
+    if STATE_FILE.exists():
+        STATE_FILE.unlink()
+
+
+def normalize_proxy_config(value: Any) -> dict[str, str]:
+    proxy = dict(_DEFAULT_PROXY_CONFIG)
+    if isinstance(value, dict):
+        for key in proxy:
+            if key in value:
+                proxy[key] = str(value[key]).strip()
+
+    if proxy['mode'] not in ('system', 'direct', 'fixed', 'pac'):
+        proxy['mode'] = 'system'
+    if proxy['mode'] != 'fixed':
+        proxy['server'] = ''
+    if proxy['mode'] != 'pac':
+        proxy['pac_url'] = ''
+    return proxy
+
+
+def load_config() -> dict[str, Any]:
+    config: dict[str, Any] = {'proxy': normalize_proxy_config(None)}
+    if not CONFIG_FILE.exists():
+        return config
+    try:
+        loaded = json.loads(CONFIG_FILE.read_text(encoding='utf-8'))
+    except (OSError, json.JSONDecodeError):
+        return config
+    if isinstance(loaded, dict):
+        config.update(loaded)
+    config['proxy'] = normalize_proxy_config(config.get('proxy'))
+    return config
+
+
+def save_config(config: dict[str, Any]) -> None:
+    ensure_runtime_dir()
+    normalized = dict(config)
+    normalized['proxy'] = normalize_proxy_config(config.get('proxy'))
+    CONFIG_FILE.write_text(
+        json.dumps(normalized, ensure_ascii=False, indent=2),
+        encoding='utf-8')
+
+
+def proxy_command_line_args(proxy: dict[str, Any] | None = None) -> list[str]:
+    normalized = normalize_proxy_config(proxy)
+    mode = normalized['mode']
+    args: list[str] = []
+    if mode == 'direct':
+        args.append('--no-proxy-server')
+    elif mode == 'fixed':
+        if not normalized['server']:
+            raise BrowserctlError('Fixed proxy mode requires a proxy server.')
+        args.append(f"--proxy-server={normalized['server']}")
+    elif mode == 'pac':
+        if not normalized['pac_url']:
+            raise BrowserctlError('PAC proxy mode requires a PAC URL.')
+        args.append(f"--proxy-pac-url={normalized['pac_url']}")
+
+    if normalized['bypass_list'] and mode in ('fixed', 'pac'):
+        args.append(f"--proxy-bypass-list={normalized['bypass_list']}")
+    return args
+
+
+def is_pid_running(pid: int | None) -> bool:
+    if not pid:
+        return False
+    try:
+        os.kill(int(pid), 0)
+    except OSError:
+        return False
+    return True
+
+
+def find_free_port(host: str = DAEMON_HOST) -> int:
+    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
+        sock.bind((host, 0))
+        return int(sock.getsockname()[1])
+
+
+def daemon_url(state: dict[str, Any], path: str) -> str:
+    if not path.startswith('/'):
+        path = f'/{path}'
+    return f"http://{state['host']}:{state['port']}{path}"
+
+
+def json_request(url: str,
+                 method: str = 'GET',
+                 body: dict[str, Any] | None = None,
+                 headers: dict[str, str] | None = None,
+                 timeout: float = DEFAULT_REQUEST_TIMEOUT) -> Any:
+    request_headers = dict(headers or {})
+    data = None
+    if body is not None:
+        request_headers.setdefault('Content-Type', 'application/json')
+        data = json.dumps(body, ensure_ascii=False).encode('utf-8')
+
+    request = urllib.request.Request(url, data=data, method=method)
+    for key, value in request_headers.items():
+        request.add_header(key, value)
+
+    try:
+        with urllib.request.urlopen(request, timeout=timeout) as response:
+            payload = response.read()
+    except urllib.error.HTTPError as exc:
+        payload = exc.read()
+        detail = payload.decode('utf-8', errors='replace').strip()
+        raise BrowserctlError(
+            f'{method} {url} failed with HTTP {exc.code}: {detail}') from exc
+    except urllib.error.URLError as exc:
+        raise BrowserctlError(f'{method} {url} failed: {exc.reason}') from exc
+    except OSError as exc:
+        raise BrowserctlError(f'{method} {url} failed: {exc}') from exc
+
+    if not payload:
+        return None
+
+    decoded = payload.decode('utf-8')
+    try:
+        return json.loads(decoded)
+    except json.JSONDecodeError:
+        return decoded
