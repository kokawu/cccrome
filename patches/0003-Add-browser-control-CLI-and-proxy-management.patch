+
+    def type_element(self,
+                     text: str,
+                     selector: str = '',
+                     match_text: str = '',
+                     index: int = -1,
+                     contains: bool = True,
+                     clear: bool = False,
+                     press_enter: bool = False,
+                     tab_id: str = '') -> dict[str, Any]:
+        self.ensure_browser()
+        result = self.devtools.type_element(text=text,
+                                            selector=selector,
+                                            match_text=match_text,
+                                            index=index,
+                                            contains=contains,
+                                            clear=clear,
+                                            press_enter=press_enter,
+                                            tab_id=tab_id)
+        result['browser_pid'] = self.browser_pid
+        result['remote_debugging_port'] = self.remote_debugging_port
+        return result
+
+    def wait_for_selector(self,
+                          selector: str,
+                          timeout_ms: int = 5000,
+                          visible: bool = True,
+                          tab_id: str = '') -> dict[str, Any]:
+        self.ensure_browser()
