+
+    def evaluate(self, expression: str, tab_id: str = '') -> dict[str, Any]:
+        self.ensure_browser()
+        result = self.devtools.evaluate(expression, tab_id=tab_id)
+        result['browser_pid'] = self.browser_pid
+        result['remote_debugging_port'] = self.remote_debugging_port
+        return result
+
+    def activate_tab(self, tab_id: str) -> dict[str, Any]:
+        self.ensure_browser()
+        activated_tab = self.devtools.activate_tab(tab_id)
+        result = {
+            'tab': activated_tab,
+            'browser_pid': self.browser_pid,
+            'remote_debugging_port': self.remote_debugging_port,
+        }
