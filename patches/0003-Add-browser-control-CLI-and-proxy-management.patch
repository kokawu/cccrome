+#!/usr/bin/env python3
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+"""Unified CCCrome CLI entrypoint for humans and local agents."""
+
+from __future__ import annotations
+
+import sys
+
+import browserctl
+import launcher
+
+_LAUNCHER_COMMANDS = {
+    'up',
+    'status',
+    'observe',
+    'open',
+    'go',
+    'stop',
+    'proxy',
+    'doctor',
+    'install',
+    'mcp',
+}
+
+
+def _print_help() -> None:
+    print(
+        """usage: ccchrome <command> [options]
+
+Session commands:
+  up [url]             Start or reuse the managed CCCrome session
+  status               Show browser and daemon status as JSON
+  stop                 Stop the managed session
+  open <url>           Open a URL in a new tab
+  go <url>             Navigate the current visible tab
+  windows              List managed browser windows
+  tabs                 List tabs and DevTools targets
+
+Page commands:
+  observe              Return screenshot metadata and a DOM summary
+  page                 Return a DOM-oriented page summary
+  eval <javascript>    Evaluate JavaScript in the current page
+  click-element        Click by selector or visible text
+  type-element         Type into an element
+  wait-selector        Wait for an element
+  snapshot             Capture the visible browser window
+  page-screenshot      Capture the current web page
+
+Proxy commands:
+  proxy show
+  proxy set <server> [--bypass <list>]
+  proxy pac <url> [--bypass <list>]
+  proxy system
+  proxy off
+
+Agent commands:
+  doctor               Run a browser control self-test
+  mcp                  Start the MCP server over stdio
+
+Run `ccchrome <command> --help` for command-specific options. All normal
+command results are emitted as JSON.
+""")
+
+
+def main() -> int:
+    if len(sys.argv) < 2 or sys.argv[1] in ('-h', '--help', 'help'):
+        _print_help()
+        return 0
+    if sys.argv[1] in _LAUNCHER_COMMANDS:
+        return launcher.main()
+    return browserctl.main()
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
