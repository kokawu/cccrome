+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+from pathlib import Path
+from typing import Any
+
+try:
+    from mcp.server import fastmcp
+except ModuleNotFoundError:
+    class _FallbackMCP:
+        def __init__(self, _name: str):
+            self._name = _name
+
+        def tool(self, name: str):
+            def decorator(func):
+                return func
+
+            return decorator
+
+        def run(self) -> None:
+            raise RuntimeError(
+                'Run this server with vpython3, or install the mcp package.')
+
+    class _FallbackFastMCP:
+        @staticmethod
+        def FastMCP(name: str) -> _FallbackMCP:
+            return _FallbackMCP(name)
+
+    fastmcp = _FallbackFastMCP()
+
+_REPO_ROOT = Path(__file__).resolve().parents[3]
+_TOOLS_BROWSERCTL_DIR = _REPO_ROOT / 'tools' / 'browserctl'
+sys.path.insert(0, str(_TOOLS_BROWSERCTL_DIR))
+
+import client as browserctl_client
+import common as browserctl_common
+
+mcp = fastmcp.FastMCP('browserctl')
+
+
+def _env_port(name: str) -> int:
+    value = os.environ.get(name, '').strip()
+    if not value:
+        return 0
+    return int(value)
+
+
+def _new_client(browser_binary: str = '',
+                user_data_dir: str = '',
+                remote_debugging_port: int = 0
+                ) -> browserctl_client.BrowserctlClient:
+    resolved_browser_binary = (
+        browser_binary.strip() or os.environ.get('BROWSERCTL_BROWSER_BINARY', '')
+        or str(browserctl_common.DEFAULT_BROWSER_BINARY))
+    resolved_user_data_dir = (
+        user_data_dir.strip() or os.environ.get('BROWSERCTL_USER_DATA_DIR', '')
+        or str(browserctl_common.DEFAULT_PROFILE_DIR))
+    resolved_remote_debugging_port = (
+        int(remote_debugging_port) if remote_debugging_port else
+        _env_port('BROWSERCTL_REMOTE_DEBUGGING_PORT'))
+    return browserctl_client.BrowserctlClient(
+        browser_binary=resolved_browser_binary,
+        user_data_dir=resolved_user_data_dir,
+        remote_debugging_port=resolved_remote_debugging_port,
+    )
+
+
+def _json_print(payload: Any) -> None:
+    print(json.dumps(payload, ensure_ascii=False, indent=2))
+
+
+def _apply_cli_defaults(args: argparse.Namespace) -> None:
+    if args.browser_binary:
+        os.environ['BROWSERCTL_BROWSER_BINARY'] = args.browser_binary
+    if args.user_data_dir:
+        os.environ['BROWSERCTL_USER_DATA_DIR'] = args.user_data_dir
+    if args.remote_debugging_port:
+        os.environ['BROWSERCTL_REMOTE_DEBUGGING_PORT'] = str(
+            args.remote_debugging_port)
+
+
+@mcp.tool(name='ensure_browserctl_session')
+def ensure_browserctl_session(
+        url: str = '',
+        normalize_window: bool = True,
+        left: int = 80,
+        top: int = 40,
+        width: int = 1280,
+        height: int = 960,
+        browser_binary: str = '',
+        user_data_dir: str = '',
+        remote_debugging_port: int = 0) -> dict[str, Any]:
+    """Starts or reuses the dedicated browserctl session, optionally normalizes
+    the window bounds, and can navigate to a starting URL."""
+    client = _new_client(browser_binary, user_data_dir, remote_debugging_port)
+    client.start_daemon()
+    setup: dict[str, Any] = {}
+    if normalize_window:
+        setup['window'] = client.window(left=left,
+                                        top=top,
+                                        width=width,
+                                        height=height)
+        setup['focus'] = client.focus()
+    if url:
+        setup['navigate'] = client.navigate(url)
+    return {
+        'status': client.status(),
+        'setup': setup,
+    }
+
+
+@mcp.tool(name='stop_browserctl_session')
+def stop_browserctl_session() -> dict[str, Any]:
+    """Stops the dedicated browserctl daemon and managed browser session."""
+    return _new_client().stop_daemon()
+
+
+@mcp.tool(name='browserctl_status')
+def browserctl_status() -> dict[str, Any]:
+    """Returns daemon, browser, and window status for the managed session."""
+    return _new_client().status()
+
+
+@mcp.tool(name='browserctl_windows')
+def browserctl_windows() -> dict[str, Any]:
+    """Lists visible managed browser windows."""
+    return _new_client().windows()
+
+
+@mcp.tool(name='browserctl_tabs')
+def browserctl_tabs() -> dict[str, Any]:
+    """Lists tabs in the managed browser session."""
+    return _new_client().tabs()
+
+
+@mcp.tool(name='browserctl_observe')
+def browserctl_observe(limit: int = 80, tab_id: str = '') -> dict[str, Any]:
+    """Returns one combined observation: visible-window snapshot plus DOM/page
+    summary for the active tab."""
+    return _new_client().observe(limit=limit, tab_id=tab_id)
+
+
+@mcp.tool(name='browserctl_page')
+def browserctl_page(limit: int = 80, tab_id: str = '') -> dict[str, Any]:
+    """Returns a DOM-oriented summary of the current tab."""
+    return _new_client().page(limit=limit, tab_id=tab_id)
+
+
+@mcp.tool(name='browserctl_page_screenshot')
+def browserctl_page_screenshot(tab_id: str = '',
+                               full_page: bool = False) -> dict[str, Any]:
+    """Captures a clean page screenshot through CDP."""
+    return _new_client().page_screenshot(tab_id=tab_id, full_page=full_page)
+
+
+@mcp.tool(name='browserctl_eval')
+def browserctl_eval(expression: str, tab_id: str = '') -> dict[str, Any]:
+    """Evaluates JavaScript in the current tab."""
+    return _new_client().eval(expression=expression, tab_id=tab_id)
+
+
+@mcp.tool(name='browserctl_activate_tab')
+def browserctl_activate_tab(tab_id: str) -> dict[str, Any]:
+    """Activates a tab by DevTools tab id."""
+    return _new_client().activate_tab(tab_id)
+
+
+@mcp.tool(name='browserctl_open')
+def browserctl_open(url: str) -> dict[str, Any]:
+    """Opens a URL in a new managed tab when supported by this build."""
+    return _new_client().open(url)
+
+
+@mcp.tool(name='browserctl_navigate')
+def browserctl_navigate(url: str) -> dict[str, Any]:
+    """Navigates the current visible tab like a user using the omnibox."""
+    return _new_client().navigate(url)
+
+
+@mcp.tool(name='browserctl_click')
+def browserctl_click(x: int,
+                     y: int,
+                     button: str = 'left',
+                     clicks: int = 1) -> dict[str, Any]:
+    """Clicks a point in window-relative pixels from the latest observation."""
+    return _new_client().click(x=x, y=y, button=button, clicks=clicks)
+
+
+@mcp.tool(name='browserctl_click_element')
+def browserctl_click_element(selector: str = '',
+                             match_text: str = '',
+                             index: int = -1,
+                             exact: bool = False,
+                             tab_id: str = '') -> dict[str, Any]:
+    """Clicks a page element by selector or visible text."""
+    return _new_client().click_element(selector=selector,
+                                       match_text=match_text,
+                                       index=index,
+                                       contains=not exact,
+                                       tab_id=tab_id)
+
+
+@mcp.tool(name='browserctl_drag')
+def browserctl_drag(start_x: int,
+                    start_y: int,
+                    end_x: int,
+                    end_y: int,
+                    duration_ms: int = 400) -> dict[str, Any]:
+    """Performs a visible-window drag using window-relative coordinates."""
+    return _new_client().drag(start_x=start_x,
+                              start_y=start_y,
+                              end_x=end_x,
+                              end_y=end_y,
+                              duration_ms=duration_ms)
+
+
+@mcp.tool(name='browserctl_scroll')
+def browserctl_scroll(x: int,
+                      y: int,
+                      notches_y: int,
+                      notches_x: int = 0) -> dict[str, Any]:
+    """Scrolls the visible window at a specific point."""
+    return _new_client().scroll(x=x,
+                                y=y,
+                                notches_y=notches_y,
+                                notches_x=notches_x)
+
+
+@mcp.tool(name='browserctl_type')
+def browserctl_type(text: str, press_enter: bool = False) -> dict[str, Any]:
+    """Types text into the currently focused visible browser control."""
+    return _new_client().type(text=text, press_enter=press_enter)
+
+
+@mcp.tool(name='browserctl_type_element')
+def browserctl_type_element(text: str,
+                            selector: str = '',
+                            match_text: str = '',
+                            index: int = -1,
+                            exact: bool = False,
+                            clear: bool = False,
+                            press_enter: bool = False,
+                            tab_id: str = '') -> dict[str, Any]:
+    """Types into an editable page element resolved by selector or label/text."""
+    return _new_client().type_element(text=text,
+                                      selector=selector,
+                                      match_text=match_text,
+                                      index=index,
+                                      contains=not exact,
+                                      clear=clear,
+                                      press_enter=press_enter,
+                                      tab_id=tab_id)
+
+
+@mcp.tool(name='browserctl_wait_selector')
+def browserctl_wait_selector(selector: str,
+                             timeout_ms: int = 5000,
+                             allow_hidden: bool = False,
+                             tab_id: str = '') -> dict[str, Any]:
+    """Waits until a selector exists and is visible, unless hidden elements are
+    allowed."""
+    return _new_client().wait_selector(selector=selector,
+                                       timeout_ms=timeout_ms,
+                                       visible=not allow_hidden,
+                                       tab_id=tab_id)
+
+
+@mcp.tool(name='browserctl_press')
+def browserctl_press(keys: str) -> dict[str, Any]:
+    """Presses a key or key combination such as ctrl+l or alt+left."""
+    return _new_client().press(keys)
+
+
+@mcp.tool(name='browserctl_wait')
+def browserctl_wait(milliseconds: int = 500) -> dict[str, Any]:
+    """Sleeps briefly between actions in the serialized browser session."""
+    return _new_client().wait(milliseconds)
+
+
+def _run_status(args: argparse.Namespace) -> int:
+    try:
+        _json_print(
+            _new_client(args.browser_binary, args.user_data_dir,
+                        args.remote_debugging_port).status())
+        return 0
+    except Exception as exc:  # pragma: no cover - local debugging aid
+        _json_print({'error': str(exc)})
+        return 1
+
+
+def _run_self_test(args: argparse.Namespace) -> int:
+    try:
+        client = _new_client(args.browser_binary, args.user_data_dir,
+                             args.remote_debugging_port)
+        result = ensure_browserctl_session(
+            normalize_window=True,
+            left=80,
+            top=40,
+            width=1280,
+            height=960,
+            browser_binary=args.browser_binary,
+            user_data_dir=args.user_data_dir,
+            remote_debugging_port=args.remote_debugging_port,
+        )
+        result['observe'] = client.observe(limit=8)
+        _json_print(result)
+        return 0
+    except Exception as exc:  # pragma: no cover - local debugging aid
+        _json_print({'error': str(exc)})
+        return 1
+
+
+def _run_stop(_args: argparse.Namespace) -> int:
+    try:
+        _json_print(_new_client().stop_daemon())
+        return 0
+    except Exception as exc:  # pragma: no cover - local debugging aid
+        _json_print({'error': str(exc)})
+        return 1
+
+
+def _main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--status',
+                        action='store_true',
+                        help='Print session status as JSON and exit.')
+    parser.add_argument('--self-test',
+                        action='store_true',
+                        help='Start the session and run one observe step.')
+    parser.add_argument('--stop-session',
+                        action='store_true',
+                        help='Stop the managed browserctl session and exit.')
+    parser.add_argument('--browser-binary', default='')
+    parser.add_argument('--user-data-dir', default='')
+    parser.add_argument('--remote-debugging-port', type=int, default=0)
+    args = parser.parse_args()
+
+    if args.status:
+        return _run_status(args)
+    if args.self_test:
+        return _run_self_test(args)
+    if args.stop_session:
+        return _run_stop(args)
+
+    _apply_cli_defaults(args)
+    mcp.run()
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(_main())
