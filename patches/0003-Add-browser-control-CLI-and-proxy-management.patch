+                                tab_id: str = '',
+                                full_page: bool = False) -> dict[str, Any]:
+        self.ensure_browser()
+        result = self.devtools.capture_page_screenshot(tab_id=tab_id,
+                                                       full_page=full_page)
+        result['browser_pid'] = self.browser_pid
+        result['remote_debugging_port'] = self.remote_debugging_port
