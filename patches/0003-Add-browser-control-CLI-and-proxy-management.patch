+
+    def click_element(self,
+                      selector: str = '',
+                      match_text: str = '',
+                      index: int = -1,
+                      contains: bool = True,
+                      tab_id: str = '') -> dict[str, Any]:
+        self.ensure_browser()
+        result = self.devtools.click_element(selector=selector,
+                                             match_text=match_text,
+                                             index=index,
+                                             contains=contains,
+                                             tab_id=tab_id)
+        result['browser_pid'] = self.browser_pid
+        result['remote_debugging_port'] = self.remote_debugging_port
