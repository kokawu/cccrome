+#!/usr/bin/env python3
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+"""Chrome DevTools Protocol helpers for browserctl."""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import os
+import socket
+import time
+import urllib.parse
+from pathlib import Path
+from typing import Any
+
+try:
+    import websocket as _websocket
+except ModuleNotFoundError:
+    _websocket = None
+
+import common
+
+_PAGE_SCREENSHOT_DIR = common.RUNTIME_DIR / 'page_screenshots'
+_WEBSOCKET_GUID = '258EAFA5-E914-47DA-95CA-C5AB0DC85B11'
+
+_DOM_HELPERS = r"""
+const browserctl = (() => {
+  function normalizeText(value) {
+    return String(value ?? '').replace(/\s+/g, ' ').trim();
+  }
+
+  function clip(value, maxLength = 160) {
+    const text = normalizeText(value);
+    if (text.length <= maxLength) {
+      return text;
+    }
+    return text.slice(0, Math.max(0, maxLength - 1)) + '\u2026';
+  }
+
+  function visible(element) {
+    if (!(element instanceof Element)) {
+      return false;
+    }
+    const rect = element.getBoundingClientRect();
+    if (rect.width <= 0 || rect.height <= 0) {
+      return false;
+    }
+    const style = window.getComputedStyle(element);
+    if (!style) {
+      return true;
+    }
+    if (style.display === 'none' || style.visibility === 'hidden' ||
+        style.opacity === '0') {
+      return false;
+    }
+    return true;
+  }
+
+  function cssEscape(value) {
+    if (window.CSS && typeof window.CSS.escape === 'function') {
+      return window.CSS.escape(value);
+    }
+    return String(value).replace(/[^a-zA-Z0-9_\-]/g, '\\$&');
+  }
+
+  function selector(element) {
+    if (!(element instanceof Element)) {
+      return '';
+    }
+    if (element.id) {
+      return '#' + cssEscape(element.id);
+    }
+
+    const parts = [];
+    let current = element;
+    while (current && current.nodeType === Node.ELEMENT_NODE &&
+           current !== document.documentElement) {
+      let part = current.localName || current.tagName.toLowerCase();
+      if (!part) {
+        break;
+      }
+      if (current.parentElement) {
+        const siblings = Array.from(current.parentElement.children)
+            .filter((candidate) => candidate.localName === current.localName);
+        if (siblings.length > 1) {
+          part += `:nth-of-type(${siblings.indexOf(current) + 1})`;
+        }
+      }
+      parts.unshift(part);
+      const currentSelector = parts.join(' > ');
+      try {
+        if (document.querySelectorAll(currentSelector).length === 1) {
+          return currentSelector;
+        }
+      } catch (error) {
+      }
+      current = current.parentElement;
+    }
+
+    return parts.join(' > ');
+  }
+
+  function rect(element) {
+    const bounds = element.getBoundingClientRect();
+    return {
+      left: Math.round(bounds.left),
+      top: Math.round(bounds.top),
+      width: Math.round(bounds.width),
+      height: Math.round(bounds.height),
+    };
+  }
+
+  function textValue(element) {
+    if (!(element instanceof Element)) {
+      return '';
+    }
+    if (element instanceof HTMLInputElement ||
+        element instanceof HTMLTextAreaElement) {
+      if (element.value) {
+        return element.value;
+      }
+    }
+    if (element.isContentEditable) {
+      return element.innerText || element.textContent || '';
+    }
+    return element.innerText || element.textContent || '';
+  }
+
+  function editable(element) {
+    return element instanceof HTMLInputElement ||
+        element instanceof HTMLTextAreaElement ||
+        element.isContentEditable;
+  }
+
+  function labelText(element) {
+    if (!(element instanceof Element) || !element.labels) {
+      return '';
+    }
+    return normalizeText(Array.from(element.labels)
+        .map((label) => label.innerText || label.textContent || '')
+        .join(' '));
+  }
+
+  function interactiveCandidates() {
+    const selectorText = [
+      'a',
+      'button',
+      'input',
+      'textarea',
+      'select',
+      'option',
+      'label',
+      'summary',
+      '[role="button"]',
+      '[role="link"]',
+      '[role="tab"]',
+      '[role="menuitem"]',
+      '[role="checkbox"]',
+      '[role="radio"]',
+      '[contenteditable=""]',
+      '[contenteditable="true"]',
+      '[tabindex]',
+    ].join(',');
+    const seen = new Set();
+    const elements = [];
+    for (const element of document.querySelectorAll(selectorText)) {
+      if (!(element instanceof Element)) {
+        continue;
+      }
+      if (seen.has(element) || !visible(element)) {
+        continue;
+      }
+      seen.add(element);
+      elements.push(element);
+    }
+    return elements;
+  }
+
+  function summary(element, index) {
+    if (!(element instanceof Element)) {
+      return null;
+    }
+    return {
+      index,
+      tag: element.tagName.toLowerCase(),
+      selector: selector(element),
+      text: clip(textValue(element)),
+      value: clip(element instanceof HTMLInputElement ||
+                  element instanceof HTMLTextAreaElement ? element.value : ''),
+      type: element.getAttribute('type') || '',
+      inputType: element instanceof HTMLInputElement ? element.type : '',
+      role: element.getAttribute('role') || '',
+      id: element.id || '',
+      name: element.getAttribute('name') || '',
+      href: element.getAttribute('href') || '',
+      placeholder: element.getAttribute('placeholder') || '',
+      title: element.getAttribute('title') || '',
+      ariaLabel: element.getAttribute('aria-label') || '',
+      labels: labelText(element),
+      disabled: Boolean(element.disabled ||
+                        element.getAttribute('aria-disabled') === 'true'),
+      editable: editable(element),
+      visible: visible(element),
+      rect: rect(element),
+    };
+  }
+
+  function searchText(element) {
+    return normalizeText([
+      textValue(element),
+      labelText(element),
+      element.getAttribute('aria-label') || '',
+      element.getAttribute('title') || '',
+      element.getAttribute('placeholder') || '',
+      element.getAttribute('alt') || '',
+      element.getAttribute('value') || '',
+    ].join(' '));
+  }
+
+  function resolveElement(options) {
+    const selectorText = String(options.selector || '').trim();
+    const matchText = normalizeText(options.matchText || '');
+    const contains = options.contains !== false;
+    const requestedIndex = Number.isFinite(options.index) ? Number(options.index) : -1;
+    const editableOnly = options.editableOnly === true;
+    let matches = [];
+    let strategy = '';
+
+    if (selectorText) {
+      try {
+        matches = Array.from(document.querySelectorAll(selectorText));
+      } catch (error) {
+        throw new Error(`Invalid selector: ${selectorText}`);
+      }
+      strategy = 'selector';
+    } else if (matchText) {
+      matches = interactiveCandidates().filter((element) => {
+        const haystack = searchText(element);
+        return contains ? haystack.includes(matchText) : haystack === matchText;
+      });
+      strategy = contains ? 'text-contains' : 'text-exact';
+    } else {
+      matches = interactiveCandidates();
+      strategy = 'index';
+    }
+
+    if (editableOnly) {
+      matches = matches.filter((element) => editable(element));
+    }
+
+    if (!matches.length) {
+      return {
+        element: null,
+        strategy,
+        index: requestedIndex >= 0 ? requestedIndex : 0,
+        matchCount: 0,
+      };
+    }
+
+    const resolvedIndex = requestedIndex >= 0 ? requestedIndex : 0;
+    const element = matches[resolvedIndex] || null;
+    return {
+      element,
+      strategy,
+      index: resolvedIndex,
+      matchCount: matches.length,
+    };
+  }
+
+  function clearEditableValue(element) {
+    if (element instanceof HTMLTextAreaElement) {
+      const descriptor = Object.getOwnPropertyDescriptor(
+          HTMLTextAreaElement.prototype, 'value');
+      if (descriptor && descriptor.set) {
+        descriptor.set.call(element, '');
+      } else {
+        element.value = '';
+      }
+      element.dispatchEvent(new Event('input', {bubbles: true}));
+      element.dispatchEvent(new Event('change', {bubbles: true}));
+      return;
+    }
+
+    if (element instanceof HTMLInputElement) {
+      const descriptor = Object.getOwnPropertyDescriptor(
+          HTMLInputElement.prototype, 'value');
+      if (descriptor && descriptor.set) {
+        descriptor.set.call(element, '');
+      } else {
+        element.value = '';
+      }
+      element.dispatchEvent(new Event('input', {bubbles: true}));
+      element.dispatchEvent(new Event('change', {bubbles: true}));
+      return;
+    }
+
+    if (element.isContentEditable) {
+      element.textContent = '';
+      element.dispatchEvent(new InputEvent('input', {
+        bubbles: true,
+        inputType: 'deleteContentBackward',
+        data: '',
+      }));
+    }
+  }
+
+  return {
+    clip,
+    editable,
+    interactiveCandidates,
+    normalizeText,
+    rect,
+    resolveElement,
+    selector,
+    searchText,
+    summary,
+    textValue,
+    labelText,
+    visible,
+    clearEditableValue,
+  };
+})();
+"""
+
+
+def _tab_summary(tab: dict[str, Any]) -> dict[str, Any]:
+    return {
+        'id': tab.get('id'),
+        'title': tab.get('title'),
+        'url': tab.get('url'),
+        'type': tab.get('type'),
+    }
+
+
+class _FallbackWebSocket:
+    def __init__(self, sock: socket.socket, initial_buffer: bytes = b''):
+        self._sock = sock
+        self._buffer = bytearray(initial_buffer)
+
+    def settimeout(self, timeout: float | None) -> None:
+        self._sock.settimeout(timeout)
+
+    def _recv_exact(self, size: int) -> bytes:
+        while len(self._buffer) < size:
+            chunk = self._sock.recv(4096)
+            if not chunk:
+                raise common.BrowserctlError(
+                    'WebSocket connection closed unexpectedly.')
+            self._buffer.extend(chunk)
+        data = bytes(self._buffer[:size])
+        del self._buffer[:size]
+        return data
+
+    def send(self, payload: str) -> None:
+        encoded = payload.encode('utf-8')
+        mask = os.urandom(4)
+        header = bytearray([0x81])
+        payload_length = len(encoded)
+        if payload_length < 126:
+            header.append(0x80 | payload_length)
+        elif payload_length < (1 << 16):
+            header.append(0x80 | 126)
+            header.extend(payload_length.to_bytes(2, 'big'))
+        else:
+            header.append(0x80 | 127)
+            header.extend(payload_length.to_bytes(8, 'big'))
+        header.extend(mask)
+        masked_payload = bytes(
+            byte ^ mask[index % 4] for index, byte in enumerate(encoded))
+        self._sock.sendall(bytes(header) + masked_payload)
+
+    def recv(self) -> str:
+        while True:
+            first_two = self._recv_exact(2)
+            first_byte, second_byte = first_two[0], first_two[1]
+            opcode = first_byte & 0x0F
+            masked = bool(second_byte & 0x80)
+            payload_length = second_byte & 0x7F
+            if payload_length == 126:
+                payload_length = int.from_bytes(self._recv_exact(2), 'big')
+            elif payload_length == 127:
+                payload_length = int.from_bytes(self._recv_exact(8), 'big')
+            mask = self._recv_exact(4) if masked else b''
+            payload = bytearray(self._recv_exact(payload_length))
+            if masked:
+                for index in range(len(payload)):
+                    payload[index] ^= mask[index % 4]
+            if opcode == 0x1:
+                return payload.decode('utf-8')
+            if opcode == 0x8:
+                raise common.BrowserctlError('WebSocket connection closed.')
+            if opcode == 0x9:
+                self._send_control_frame(0xA, bytes(payload))
+                continue
+            if opcode == 0xA:
+                continue
+            raise common.BrowserctlError(
+                f'Unsupported WebSocket opcode: {opcode}')
+
+    def _send_control_frame(self, opcode: int, payload: bytes = b'') -> None:
+        mask = os.urandom(4)
+        header = bytearray([0x80 | (opcode & 0x0F), 0x80 | len(payload)])
+        header.extend(mask)
+        masked_payload = bytes(
+            byte ^ mask[index % 4] for index, byte in enumerate(payload))
+        self._sock.sendall(bytes(header) + masked_payload)
+
+    def close(self) -> None:
+        try:
+            self._send_control_frame(0x8)
+        except Exception:
+            pass
+        self._sock.close()
+
+
+def _create_ws_connection(websocket_url: str, timeout: float,
+                          origin: str) -> Any:
+    if _websocket is not None:
+        kwargs: dict[str, Any] = {'timeout': timeout}
+        if origin:
+            kwargs['origin'] = origin
+        return _websocket.create_connection(websocket_url, **kwargs)
+
+    parsed = urllib.parse.urlparse(websocket_url)
+    if parsed.scheme != 'ws':
+        raise common.BrowserctlError(
+            f'Fallback WebSocket only supports ws:// URLs, got {websocket_url}')
+    host = parsed.hostname or '127.0.0.1'
+    port = parsed.port or 80
+    path = parsed.path or '/'
+    if parsed.query:
+        path += f'?{parsed.query}'
+
+    sock = socket.create_connection((host, port), timeout=timeout)
+    sock.settimeout(timeout)
+    key = base64.b64encode(os.urandom(16)).decode('ascii')
+    request_lines = [
+        f'GET {path} HTTP/1.1',
+        f'Host: {host}:{port}',
+        'Upgrade: websocket',
+        'Connection: Upgrade',
+        f'Sec-WebSocket-Key: {key}',
+        'Sec-WebSocket-Version: 13',
+    ]
+    if origin:
+        request_lines.append(f'Origin: {origin}')
+    request_lines.extend(['', ''])
+    sock.sendall('\r\n'.join(request_lines).encode('ascii'))
+
+    response = bytearray()
+    while b'\r\n\r\n' not in response:
+        chunk = sock.recv(4096)
+        if not chunk:
+            sock.close()
+            raise common.BrowserctlError(
+                'WebSocket handshake failed: no response from browser.')
+        response.extend(chunk)
+    header_bytes, remainder = bytes(response).split(b'\r\n\r\n', 1)
+    header_lines = header_bytes.decode('utf-8', errors='replace').split('\r\n')
+    status_line = header_lines[0]
+    if ' 101 ' not in f' {status_line} ':
+        sock.close()
+        raise common.BrowserctlError(
+            f'WebSocket handshake failed: {status_line}')
+    headers: dict[str, str] = {}
+    for line in header_lines[1:]:
+        if ':' not in line:
+            continue
+        key_text, value = line.split(':', 1)
+        headers[key_text.strip().lower()] = value.strip()
+    expected_accept = base64.b64encode(
+        hashlib.sha1((key + _WEBSOCKET_GUID).encode('ascii')).digest()).decode(
+            'ascii')
+    if headers.get('sec-websocket-accept', '') != expected_accept:
+        sock.close()
+        raise common.BrowserctlError(
+            'WebSocket handshake failed: invalid Sec-WebSocket-Accept.')
+    return _FallbackWebSocket(sock, initial_buffer=remainder)
+
+
+class _CdpConnection:
+    def __init__(self,
+                 websocket_url: str,
+                 timeout: float = 10.0,
+                 origin: str = ''):
+        self.websocket_url = websocket_url
+        self.timeout = timeout
+        self.origin = origin
+        self._next_id = 0
+        self._ws: Any = None
+
+    def __enter__(self) -> '_CdpConnection':
+        self._ws = _create_ws_connection(self.websocket_url,
+                                         timeout=self.timeout,
+                                         origin=self.origin)
+        return self
+
+    def __exit__(self, exc_type: Any, exc: Any, exc_tb: Any) -> None:
+        if self._ws is not None:
+            self._ws.close()
+            self._ws = None
+
+    def call(self,
+             method: str,
+             params: dict[str, Any] | None = None,
+             timeout: float | None = None) -> dict[str, Any]:
+        if self._ws is None:
+            raise common.BrowserctlError('CDP socket is not connected.')
+        self._next_id += 1
+        request_id = self._next_id
+        self._ws.settimeout(timeout or self.timeout)
+        self._ws.send(
+            json.dumps({
+                'id': request_id,
+                'method': method,
+                'params': params or {},
+            },
+                       ensure_ascii=False))
+        while True:
+            raw_message = self._ws.recv()
+            if isinstance(raw_message, bytes):
+                raw_message = raw_message.decode('utf-8')
+            message = json.loads(raw_message)
+            if message.get('id') != request_id:
+                continue
+            if 'error' in message:
+                error = message['error']
+                raise common.BrowserctlError(
+                    f'CDP {method} failed: {error.get("message", error)}')
+            return message.get('result', {})
+
+
+class DevToolsClient:
+    def __init__(self, remote_debugging_port: int):
+        self.remote_debugging_port = int(remote_debugging_port)
+        self.origin = f'http://127.0.0.1:{self.remote_debugging_port}'
+
+    def _devtools_url(self, path: str) -> str:
+        if not path.startswith('/'):
+            path = f'/{path}'
+        return f'http://127.0.0.1:{self.remote_debugging_port}{path}'
+
+    def _request_json(self, path: str, method: str = 'GET') -> Any:
+        return common.json_request(self._devtools_url(path),
+                                   method=method,
+                                   timeout=5.0)
+
+    def version_info(self) -> dict[str, Any]:
+        return self._request_json('/json/version')
+
+    def list_tabs(self) -> list[dict[str, Any]]:
+        tabs = self._request_json('/json/list')
+        if isinstance(tabs, list):
+            return tabs
+        return []
+
+    def _page_tabs(self) -> list[dict[str, Any]]:
+        return [
+            tab for tab in self.list_tabs()
+            if tab.get('type') == 'page' and tab.get('webSocketDebuggerUrl')
+        ]
+
+    def _evaluate_visibility(self, tab: dict[str, Any]) -> dict[str, Any]:
+        return self._evaluate_expression(
+            tab,
+            """(() => ({
+                visible: document.visibilityState === 'visible',
+                focused: document.hasFocus(),
+                readyState: document.readyState,
+                title: document.title,
+                url: location.href,
+            }))()""",
+            await_promise=False,
+            return_by_value=True,
+            user_gesture=False)
+
+    def get_tab(self, tab_id: str = '') -> dict[str, Any]:
+        tabs = self._page_tabs()
+        if not tabs:
+            raise common.BrowserctlError(
+                'No page tabs are available in the managed browser.')
+        if tab_id:
+            for tab in tabs:
+                if tab.get('id') == tab_id:
+                    return tab
+            raise common.BrowserctlError(f'No tab matched id {tab_id}.')
+
+        preferred_tab: dict[str, Any] | None = None
+        for tab in tabs:
+            try:
+                state = self._evaluate_visibility(tab)
+            except common.BrowserctlError:
+                continue
+            if state.get('visible') or state.get('focused'):
+                preferred_tab = tab
+                break
+        return preferred_tab or tabs[0]
+
+    def activate_tab(self, tab_id: str) -> dict[str, Any]:
+        encoded_tab_id = urllib.parse.quote(tab_id, safe='')
+        attempts = [
+            (f'/json/activate/{encoded_tab_id}', 'GET'),
+            (f'/json/activate/{encoded_tab_id}', 'PUT'),
+        ]
+        for path, method in attempts:
+            try:
+                self._request_json(path, method=method)
+                return self.get_tab(tab_id)
+            except common.BrowserctlError:
+                continue
+        raise common.BrowserctlError(f'Could not activate tab {tab_id}.')
+
+    def _evaluate_expression(self,
+                             tab: dict[str, Any],
+                             expression: str,
+                             *,
+                             await_promise: bool,
+                             return_by_value: bool,
+                             user_gesture: bool) -> Any:
+        websocket_url = tab.get('webSocketDebuggerUrl')
+        if not websocket_url:
+            raise common.BrowserctlError(
+                f'Tab {tab.get("id")} does not expose a websocket debugger URL.')
+        with _CdpConnection(str(websocket_url),
+                            timeout=10.0,
+                            origin=self.origin) as connection:
+            result = connection.call(
+                'Runtime.evaluate',
+                {
+                    'expression': expression,
+                    'awaitPromise': await_promise,
+                    'returnByValue': return_by_value,
+                    'userGesture': user_gesture,
+                },
+            )
+        if 'exceptionDetails' in result:
+            details = result['exceptionDetails']
+            description = details.get('text') or 'Runtime.evaluate threw.'
+            exception = details.get('exception') or {}
+            if exception.get('description'):
+                description = exception['description']
+            raise common.BrowserctlError(description)
+        details = result.get('result', {})
+        if details.get('subtype') == 'error':
+            raise common.BrowserctlError(
+                f'Runtime.evaluate failed: {details.get("description", details)}')
+        if return_by_value:
+            return details.get('value')
+        return details
+
+    def evaluate(self, expression: str, tab_id: str = '') -> dict[str, Any]:
+        tab = self.get_tab(tab_id)
+        return {
+            'tab': _tab_summary(tab),
+            'result': self._evaluate_expression(tab,
+                                                expression,
+                                                await_promise=True,
+                                                return_by_value=True,
+                                                user_gesture=True),
+        }
+
+    def inspect_page(self, limit: int = 80, tab_id: str = '') -> dict[str, Any]:
+        tab = self.get_tab(tab_id)
+        limit = max(1, min(int(limit), 200))
+        expression = f"""(() => {{
+{_DOM_HELPERS}
+  const nodes = browserctl.interactiveCandidates().slice(0, {limit});
+  const focused = document.activeElement && document.activeElement !== document.body
+      ? browserctl.summary(document.activeElement, -1)
+      : null;
+  return {{
+    title: document.title,
+    url: location.href,
+    readyState: document.readyState,
+    visibilityState: document.visibilityState,
+    viewport: {{
+      width: window.innerWidth,
+      height: window.innerHeight,
+      devicePixelRatio: window.devicePixelRatio,
+      scrollX: Math.round(window.scrollX),
+      scrollY: Math.round(window.scrollY),
+    }},
+    focused,
+    elementCount: nodes.length,
+    elements: nodes.map((element, index) => browserctl.summary(element, index)),
+  }};
+}})()"""
+        return {
+            'tab': _tab_summary(tab),
+            'page': self._evaluate_expression(tab,
+                                              expression,
+                                              await_promise=False,
+                                              return_by_value=True,
+                                              user_gesture=False),
+        }
+
+    def capture_page_screenshot(self,
+                                tab_id: str = '',
+                                full_page: bool = False) -> dict[str, Any]:
+        tab = self.get_tab(tab_id)
+        websocket_url = tab.get('webSocketDebuggerUrl')
+        if not websocket_url:
+            raise common.BrowserctlError(
+                f'Tab {tab.get("id")} does not expose a websocket debugger URL.')
+        _PAGE_SCREENSHOT_DIR.mkdir(parents=True, exist_ok=True)
+        output_path = (_PAGE_SCREENSHOT_DIR /
+                       f'page_{tab.get("id")}_{int(time.time() * 1000)}.png')
+        with _CdpConnection(str(websocket_url),
+                            timeout=15.0,
+                            origin=self.origin) as connection:
+            connection.call('Page.enable')
+            result = connection.call(
+                'Page.captureScreenshot',
+                {
+                    'format': 'png',
+                    'fromSurface': True,
+                    'captureBeyondViewport': bool(full_page),
+                },
+                timeout=30.0,
+            )
+        output_path.write_bytes(base64.b64decode(result['data']))
+        return {
+            'tab': _tab_summary(tab),
+            'screenshot_path': str(output_path),
+            'full_page': bool(full_page),
+        }
+
+    def click_element(self,
+                      selector: str = '',
+                      match_text: str = '',
+                      index: int = -1,
+                      contains: bool = True,
+                      tab_id: str = '') -> dict[str, Any]:
+        tab = self.get_tab(tab_id)
+        options = {
+            'selector': selector,
+            'matchText': match_text,
+            'index': index,
+            'contains': contains,
+            'editableOnly': False,
+        }
+        expression = f"""(async () => {{
+{_DOM_HELPERS}
+  const match = browserctl.resolveElement({json.dumps(options, ensure_ascii=False)});
+  if (!match.element) {{
+    throw new Error('No element matched the requested selector/text/index.');
+  }}
+  const element = match.element;
+  element.scrollIntoView({{block: 'center', inline: 'center'}});
+  await new Promise((resolve) => window.setTimeout(resolve, 60));
+  if (typeof element.focus === 'function') {{
+    element.focus({{preventScroll: true}});
+  }}
+  await new Promise((resolve) => window.setTimeout(resolve, 20));
+  if (typeof element.click === 'function') {{
+    element.click();
+  }} else {{
+    element.dispatchEvent(new MouseEvent('click', {{
+      bubbles: true,
+      cancelable: true,
+      composed: true,
+      view: window,
+    }}));
+  }}
+  return {{
+    ok: true,
+    strategy: match.strategy,
+    index: match.index,
+    matchCount: match.matchCount,
+    element: browserctl.summary(element, match.index),
+  }};
+}})()"""
+        return {
+            'tab': _tab_summary(tab),
+            'action': self._evaluate_expression(tab,
+                                                expression,
+                                                await_promise=True,
+                                                return_by_value=True,
+                                                user_gesture=True),
+        }
+
+    def _dispatch_enter(self, websocket_url: str) -> None:
+        with _CdpConnection(websocket_url,
+                            timeout=10.0,
+                            origin=self.origin) as connection:
+            connection.call(
+                'Input.dispatchKeyEvent',
+                {
+                    'type': 'keyDown',
+                    'windowsVirtualKeyCode': 13,
+                    'nativeVirtualKeyCode': 13,
+                    'key': 'Enter',
+                    'code': 'Enter',
+                })
+            connection.call(
+                'Input.dispatchKeyEvent',
+                {
+                    'type': 'keyUp',
+                    'windowsVirtualKeyCode': 13,
+                    'nativeVirtualKeyCode': 13,
+                    'key': 'Enter',
+                    'code': 'Enter',
+                })
+
+    def type_element(self,
+                     text: str,
+                     selector: str = '',
+                     match_text: str = '',
+                     index: int = -1,
+                     contains: bool = True,
+                     clear: bool = False,
+                     press_enter: bool = False,
+                     tab_id: str = '') -> dict[str, Any]:
+        tab = self.get_tab(tab_id)
+        websocket_url = tab.get('webSocketDebuggerUrl')
+        if not websocket_url:
+            raise common.BrowserctlError(
+                f'Tab {tab.get("id")} does not expose a websocket debugger URL.')
+        options = {
+            'selector': selector,
+            'matchText': match_text,
+            'index': index,
+            'contains': contains,
+            'clear': clear,
+            'editableOnly': True,
+        }
+        prepare_expression = f"""(async () => {{
+{_DOM_HELPERS}
+  const options = {json.dumps(options, ensure_ascii=False)};
+  const match = browserctl.resolveElement(options);
+  if (!match.element) {{
+    throw new Error('No element matched the requested selector/text/index.');
+  }}
+  const element = match.element;
+  if (!browserctl.editable(element)) {{
+    throw new Error('Matched element is not editable.');
+  }}
+  element.scrollIntoView({{block: 'center', inline: 'center'}});
+  await new Promise((resolve) => window.setTimeout(resolve, 60));
+  if (typeof element.focus === 'function') {{
+    element.focus({{preventScroll: true}});
+  }}
+  if (options.clear) {{
+    browserctl.clearEditableValue(element);
+  }}
+  return {{
+    ok: true,
+    strategy: match.strategy,
+    index: match.index,
+    matchCount: match.matchCount,
+    element: browserctl.summary(element, match.index),
+    beforeValue: browserctl.clip(browserctl.textValue(element), 400),
+  }};
+}})()"""
+        prepared = self._evaluate_expression(tab,
+                                             prepare_expression,
+                                             await_promise=True,
+                                             return_by_value=True,
+                                             user_gesture=True)
+        if not prepared or not prepared.get('ok'):
+            raise common.BrowserctlError(
+                f'Could not prepare editable element for typing: {prepared}')
+        with _CdpConnection(str(websocket_url),
+                            timeout=10.0,
+                            origin=self.origin) as connection:
+            if text:
+                connection.call('Input.insertText', {'text': text})
+            if press_enter:
+                connection.call(
+                    'Input.dispatchKeyEvent',
+                    {
+                        'type': 'keyDown',
+                        'windowsVirtualKeyCode': 13,
+                        'nativeVirtualKeyCode': 13,
+                        'key': 'Enter',
+                        'code': 'Enter',
+                    })
+                connection.call(
+                    'Input.dispatchKeyEvent',
+                    {
+                        'type': 'keyUp',
+                        'windowsVirtualKeyCode': 13,
+                        'nativeVirtualKeyCode': 13,
+                        'key': 'Enter',
+                        'code': 'Enter',
+                    })
+        finalize_expression = f"""(() => {{
+{_DOM_HELPERS}
+  const element = document.activeElement;
+  return {{
+    focused: browserctl.summary(element, -1),
+    value: browserctl.clip(browserctl.textValue(element), 400),
+  }};
+}})()"""
+        finalized = self._evaluate_expression(tab,
+                                              finalize_expression,
+                                              await_promise=False,
+                                              return_by_value=True,
+                                              user_gesture=False)
+        return {
+            'tab': _tab_summary(tab),
+            'action': {
+                **prepared,
+                'typedTextLength': len(text),
+                'pressEnter': bool(press_enter),
+                'after': finalized,
+            },
+        }
+
+    def wait_for_selector(self,
+                          selector: str,
+                          timeout_ms: int = 5000,
+                          visible: bool = True,
+                          tab_id: str = '') -> dict[str, Any]:
+        tab = self.get_tab(tab_id)
+        timeout_ms = max(100, int(timeout_ms))
+        started_at = time.time()
+        deadline = time.time() + timeout_ms / 1000.0
+        last_state: dict[str, Any] | None = None
+        expression = f"""(() => {{
+{_DOM_HELPERS}
+  const selectorText = {json.dumps(selector, ensure_ascii=False)};
+  const element = document.querySelector(selectorText);
+  return {{
+    found: Boolean(element),
+    visible: Boolean(element && browserctl.visible(element)),
+    element: element ? browserctl.summary(element, 0) : null,
+  }};
+}})()"""
+        while time.time() < deadline:
+            last_state = self._evaluate_expression(tab,
+                                                   expression,
+                                                   await_promise=False,
+                                                   return_by_value=True,
+                                                   user_gesture=False)
+            if last_state.get('found') and (not visible or
+                                            last_state.get('visible')):
+                return {
+                    'tab': _tab_summary(tab),
+                    'waited_ms': int((time.time() - started_at) * 1000),
+                    'state': last_state,
+                }
+            time.sleep(0.2)
+        raise common.BrowserctlError(
+            f'Selector {selector!r} was not ready within {timeout_ms}ms. '
+            f'Last state: {last_state}')
