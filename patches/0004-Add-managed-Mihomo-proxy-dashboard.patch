+        self.assertEqual(17890, profile['mixed-port'])
+        self.assertFalse(profile['allow-lan'])
+        self.assertEqual('127.0.0.1', profile['bind-address'])
+        self.assertFalse(profile['tun']['enable'])
+        self.assertEqual('mixed', profile['tun']['stack'])
+        self.assertNotIn('port', profile)
+        self.assertNotIn('socks-port', profile)
+        self.assertNotIn('external-controller', profile)
+        self.assertNotIn('secret', profile)
+        self.assertNotIn('authentication', profile)
+        self.assertEqual('sample', profile['proxies'][0]['name'])
+
+    def test_non_mapping_subscription_is_rejected(self) -> None:
