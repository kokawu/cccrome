+                'mixed-port': 4567,
+                'allow-lan': True,
+                'bind-address': '*',
+                'external-controller': '0.0.0.0:9999',
+                'secret': 'remote-secret',
+                'authentication': ['user:password'],
+                'tun': {
+                    'enable': True,
+                    'stack': 'mixed',
+                },
+                'proxies': [{
+                    'name': 'sample',
+                    'type': 'socks5',
+                    'server': '127.0.0.1',
+                    'port': 1080,
+                }],
+                'rules': ['MATCH,DIRECT'],
+            },
+            mihomo.normalize_settings({
+                'mixed_port': 17890,
+                'controller_port': 19090,
