+
+SCRIPT_DIR = Path(__file__).resolve().parent
+sys.path.insert(0, str(SCRIPT_DIR))
+sys.path.insert(0, str(SCRIPT_DIR.parents[1] / 'third_party'))
+
+import common
+import pyyaml as yaml
+
+MIHOMO_HOME = common.RUNTIME_DIR / 'mihomo'
+MIHOMO_BINARY = MIHOMO_HOME / 'mihomo.exe'
+MIHOMO_BACKUP_BINARY = MIHOMO_HOME / 'mihomo.previous.exe'
+MIHOMO_STATE_FILE = MIHOMO_HOME / 'cccrome-manager-state.json'
+MIHOMO_LOG_FILE = MIHOMO_HOME / 'mihomo.log'
+MIHOMO_PROFILE_FILE = MIHOMO_HOME / 'active.yaml'
+MIHOMO_LAST_GOOD_PROFILE = MIHOMO_HOME / 'active.last-good.yaml'
+MIHOMO_SUBSCRIPTION_FILE = MIHOMO_HOME / 'subscription.yaml'
+MIHOMO_UI_DIR = MIHOMO_HOME / 'ui'
+MIHOMO_LOCK_FILE = MIHOMO_HOME / 'maintenance.lock'
+
+MIHOMO_RELEASE_API = (
+    'https://api.github.com/repos/MetaCubeX/mihomo/releases/latest')
+DASHBOARD_RELEASE_API = (
+    'https://api.github.com/repos/MetaCubeX/metacubexd/releases/latest')
+DEFAULT_MIXED_PORT = 7890
+DEFAULT_CONTROLLER_PORT = 9090
+DEFAULT_UPDATE_INTERVAL_HOURS = 24
+MAX_PROFILE_BYTES = 16 * 1024 * 1024
+USER_AGENT = 'CCCrome/1.0 clash.meta'
+
+_DEFAULT_SETTINGS: dict[str, Any] = {
+    'mixed_port': DEFAULT_MIXED_PORT,
+    'controller_port': DEFAULT_CONTROLLER_PORT,
+    'secret': '',
+    'auto_update': True,
+    'update_interval_hours': DEFAULT_UPDATE_INTERVAL_HOURS,
+    'subscription_update_interval_hours': DEFAULT_UPDATE_INTERVAL_HOURS,
+    'subscription_source': '',
+    'subscription_kind': '',
+    'core_version': '',
+    'dashboard_version': '',
+    'last_core_update_check': '',
+    'last_dashboard_update_check': '',
+    'last_subscription_update': '',
+}
+
+
+def _utc_now() -> str:
+    return datetime.datetime.now(datetime.timezone.utc).isoformat()
+
+
+def _parse_timestamp(value: str) -> datetime.datetime | None:
+    if not value:
+        return None
+    try:
+        parsed = datetime.datetime.fromisoformat(value)
+    except ValueError:
+        return None
+    if parsed.tzinfo is None:
+        parsed = parsed.replace(tzinfo=datetime.timezone.utc)
+    return parsed
+
+
+def _is_due(value: str, interval_hours: int) -> bool:
+    parsed = _parse_timestamp(value)
+    if parsed is None:
+        return True
+    elapsed = datetime.datetime.now(datetime.timezone.utc) - parsed
+    return elapsed >= datetime.timedelta(hours=max(1, interval_hours))
+
+
+def ensure_home() -> None:
+    common.ensure_runtime_dir()
+    MIHOMO_HOME.mkdir(parents=True, exist_ok=True)
+
+
+def normalize_settings(value: Any) -> dict[str, Any]:
+    settings = dict(_DEFAULT_SETTINGS)
+    if isinstance(value, dict):
+        for key in settings:
+            if key in value:
+                settings[key] = value[key]
+
+    for key, default in (
+            ('mixed_port', DEFAULT_MIXED_PORT),
+            ('controller_port', DEFAULT_CONTROLLER_PORT),
+            ('update_interval_hours', DEFAULT_UPDATE_INTERVAL_HOURS),
+            ('subscription_update_interval_hours',
+             DEFAULT_UPDATE_INTERVAL_HOURS)):
+        try:
+            settings[key] = int(settings[key])
+        except (TypeError, ValueError):
+            settings[key] = default
+
+    settings['mixed_port'] = min(max(settings['mixed_port'], 1), 65535)
+    settings['controller_port'] = min(
+        max(settings['controller_port'], 1), 65535)
+    settings['update_interval_hours'] = max(
+        settings['update_interval_hours'], 1)
+    settings['subscription_update_interval_hours'] = max(
+        settings['subscription_update_interval_hours'], 1)
+    settings['auto_update'] = bool(settings['auto_update'])
+    for key in settings:
+        if key not in {
+                'mixed_port', 'controller_port', 'update_interval_hours',
+                'subscription_update_interval_hours', 'auto_update'
+        }:
+            settings[key] = str(settings[key] or '').strip()
+    return settings
+
+
+def load_settings() -> dict[str, Any]:
+    return normalize_settings(common.load_config().get('mihomo'))
+
+
+def save_settings(settings: dict[str, Any]) -> dict[str, Any]:
+    config = common.load_config()
+    normalized = normalize_settings(settings)
+    config['mihomo'] = normalized
+    common.save_config(config)
+    return normalized
+
+
+def update_settings(**changes: Any) -> dict[str, Any]:
+    settings = load_settings()
+    settings.update(changes)
+    return save_settings(settings)
+
+
+def _request(url: str,
+             method: str = 'GET',
+             body: dict[str, Any] | None = None,
+             headers: dict[str, str] | None = None,
+             timeout: float = 30.0) -> tuple[bytes, dict[str, str]]:
+    request_headers = {'User-Agent': USER_AGENT}
+    request_headers.update(headers or {})
+    data = None
+    if body is not None:
+        request_headers.setdefault('Content-Type', 'application/json')
+        data = json.dumps(body, ensure_ascii=False).encode('utf-8')
+    request = urllib.request.Request(url, data=data, method=method)
+    for key, value in request_headers.items():
+        request.add_header(key, value)
+
+    try:
+        with urllib.request.urlopen(request, timeout=timeout) as response:
+            length = response.headers.get('Content-Length')
+            if length and int(length) > MAX_PROFILE_BYTES * 4:
+                raise common.BrowserctlError(
+                    f'Download is unexpectedly large: {length} bytes.')
+            payload = response.read(MAX_PROFILE_BYTES * 4 + 1)
+            if len(payload) > MAX_PROFILE_BYTES * 4:
+                raise common.BrowserctlError('Download exceeds the size limit.')
+            response_headers = dict(response.headers.items())
+            return payload, response_headers
+    except urllib.error.HTTPError as exc:
+        detail = exc.read(2048).decode('utf-8', errors='replace').strip()
+        raise common.BrowserctlError(
+            f'{method} {url} failed with HTTP {exc.code}: {detail}') from exc
+    except urllib.error.URLError as exc:
+        raise common.BrowserctlError(
+            f'{method} {url} failed: {exc.reason}') from exc
+    except OSError as exc:
+        raise common.BrowserctlError(f'{method} {url} failed: {exc}') from exc
+
+
+def _request_json(url: str, timeout: float = 30.0) -> dict[str, Any]:
+    payload, _ = _request(
+        url, headers={'Accept': 'application/vnd.github+json'},
+        timeout=timeout)
+    try:
+        parsed = json.loads(payload.decode('utf-8'))
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise common.BrowserctlError(
+            f'Invalid JSON response from {url}.') from exc
+    if not isinstance(parsed, dict):
+        raise common.BrowserctlError(f'Unexpected JSON response from {url}.')
+    return parsed
+
+
+def _download_asset(asset: dict[str, Any], target: Path) -> None:
+    url = str(asset.get('browser_download_url') or '')
+    if not url:
+        raise common.BrowserctlError('Release asset has no download URL.')
+    payload, _ = _request(url, timeout=180.0)
+    digest = str(asset.get('digest') or '')
+    if digest.startswith('sha256:'):
+        actual = hashlib.sha256(payload).hexdigest()
+        expected = digest.partition(':')[2].lower()
+        if actual.lower() != expected:
+            raise common.BrowserctlError(
+                f'Checksum mismatch for {asset.get("name", "asset")}')
+    target.write_bytes(payload)
+
+
+def _release_asset(release: dict[str, Any],
+                   predicate: Any) -> dict[str, Any]:
+    assets = release.get('assets')
+    if not isinstance(assets, list):
+        raise common.BrowserctlError('Release does not contain assets.')
+    for asset in assets:
+        if isinstance(asset, dict) and predicate(str(asset.get('name') or '')):
+            return asset
+    raise common.BrowserctlError('No compatible release asset was found.')
+
+
+def _mihomo_asset(release: dict[str, Any]) -> dict[str, Any]:
+    tag = re.escape(str(release.get('tag_name') or ''))
+    machine = platform.machine().lower()
+    if sys.platform == 'win32' and machine in ('amd64', 'x86_64'):
+        pattern = re.compile(
+            rf'^mihomo-windows-amd64-compatible-{tag}\.zip$')
+    elif sys.platform == 'win32' and machine in ('arm64', 'aarch64'):
+        pattern = re.compile(rf'^mihomo-windows-arm64-{tag}\.zip$')
+    else:
+        raise common.BrowserctlError(
+            f'Unsupported platform for automatic Mihomo install: '
+            f'{sys.platform}/{machine}')
+    return _release_asset(release, lambda name: bool(pattern.match(name)))
+
+
+def _dashboard_asset(release: dict[str, Any]) -> dict[str, Any]:
+    return _release_asset(release, lambda name: name == 'compressed-dist.tgz')
+
+
+def _binary_version(binary: Path = MIHOMO_BINARY) -> str:
+    if not binary.exists():
+        return ''
+    completed = subprocess.run(
+        [str(binary), '-v'],
+        cwd=str(MIHOMO_HOME),
+        check=False,
+        capture_output=True,
+        text=True,
+        timeout=30,
+    )
+    output = f'{completed.stdout}\n{completed.stderr}'.strip()
+    if completed.returncode != 0:
+        raise common.BrowserctlError(
+            f'Mihomo version check failed: {output}')
+    match = re.search(r'Mihomo Meta\s+(\S+)', output)
+    version_text = match.group(1) if match else output.splitlines()[0]
+    return version_text.lstrip('vV')
+
+
+def _extract_mihomo(archive: Path, target: Path) -> None:
+    with zipfile.ZipFile(archive) as bundle:
+        candidates = [
+            info for info in bundle.infolist()
+            if not info.is_dir() and info.filename.lower().endswith('.exe')
+        ]
+        if len(candidates) != 1:
+            raise common.BrowserctlError(
+                'Mihomo archive did not contain exactly one executable.')
+        with bundle.open(candidates[0]) as source, open(target, 'wb') as output:
+            shutil.copyfileobj(source, output)
+
+
+def _safe_extract_dashboard(archive: Path, destination: Path) -> None:
+    destination_resolved = destination.resolve()
+    with tarfile.open(archive, mode='r:gz') as bundle:
+        for member in bundle.getmembers():
+            if member.issym() or member.islnk():
+                raise common.BrowserctlError(
+                    'Dashboard archive contains an unsupported link.')
+            target = (destination / member.name).resolve()
+            if (target != destination_resolved and
+                    destination_resolved not in target.parents):
+                raise common.BrowserctlError(
+                    'Dashboard archive contains an unsafe path.')
+        bundle.extractall(destination)
+
+
+def _default_profile(settings: dict[str, Any]) -> dict[str, Any]:
+    return {
+        'mixed-port': settings['mixed_port'],
+        'allow-lan': False,
+        'bind-address': '127.0.0.1',
+        'mode': 'rule',
+        'log-level': 'info',
+        'ipv6': True,
+        'tun': {
+            'enable': False,
+        },
+        'proxies': [],
+        'proxy-groups': [{
+            'name': 'PROXY',
+            'type': 'select',
+            'proxies': ['DIRECT'],
+        }],
+        'rules': ['MATCH,DIRECT'],
+    }
+
+
+def _managed_profile(data: Any,
+                     settings: dict[str, Any]) -> dict[str, Any]:
+    if data is None:
+        data = _default_profile(settings)
+    if not isinstance(data, dict):
+        raise common.BrowserctlError(
+            'Subscription is not a Clash/Mihomo YAML configuration.')
+
+    profile = dict(data)
+    for key in (
+            'port', 'socks-port', 'redir-port', 'tproxy-port',
+            'external-controller', 'external-controller-tls',
+            'external-controller-unix', 'external-controller-pipe',
+            'external-ui', 'external-ui-url', 'secret', 'authentication'):
+        profile.pop(key, None)
+    profile['mixed-port'] = settings['mixed_port']
+    profile['allow-lan'] = False
+    profile['bind-address'] = '127.0.0.1'
+    profile.setdefault('mode', 'rule')
+    profile.setdefault('log-level', 'info')
+
+    tun = profile.get('tun')
+    if isinstance(tun, dict):
+        tun = dict(tun)
+        tun['enable'] = False
+    else:
+        tun = {'enable': False}
+    profile['tun'] = tun
+    return profile
+
+
+def _read_profile_source(source: str) -> tuple[bytes, str]:
+    parsed = urllib.parse.urlparse(source)
+    if parsed.scheme in ('http', 'https'):
+        payload, _ = _request(
+            source,
+            headers={
+                'Accept': 'application/yaml,text/yaml,text/plain,*/*',
+                'User-Agent': 'clash.meta',
+            },
+            timeout=90.0)
+        kind = 'url'
+    else:
+        path = Path(source).expanduser().resolve()
+        if not path.is_file():
+            raise common.BrowserctlError(
+                f'Subscription file not found: {path}')
+        if path.stat().st_size > MAX_PROFILE_BYTES:
+            raise common.BrowserctlError('Subscription file is too large.')
+        payload = path.read_bytes()
+        kind = 'file'
+    if len(payload) > MAX_PROFILE_BYTES:
+        raise common.BrowserctlError('Subscription exceeds the size limit.')
+    return payload, kind
+
+
+def _parse_profile(payload: bytes) -> Any:
+    try:
+        text = payload.decode('utf-8-sig')
+    except UnicodeDecodeError as exc:
+        raise common.BrowserctlError(
+            'Subscription is not valid UTF-8 YAML.') from exc
+    try:
+        return yaml.safe_load(text)
+    except yaml.YAMLError as exc:
+        raise common.BrowserctlError(
+            f'Subscription YAML cannot be parsed: {exc}') from exc
+
+
+def _write_yaml(path: Path, data: dict[str, Any]) -> None:
+    path.write_text(
+        yaml.safe_dump(
+            data,
+            allow_unicode=True,
+            default_flow_style=False,
+            sort_keys=False,
+        ),
+        encoding='utf-8',
+    )
+
+
+def ensure_profile() -> None:
+    ensure_home()
+    if MIHOMO_PROFILE_FILE.exists():
+        return
+    _write_yaml(MIHOMO_PROFILE_FILE, _default_profile(load_settings()))
+
+
+def validate_profile(path: Path,
+                     binary: Path = MIHOMO_BINARY) -> dict[str, Any]:
+    if not binary.exists():
+        raise common.BrowserctlError(
+            'Mihomo is not installed. Run `ccchrome proxy setup` first.')
+    completed = subprocess.run(
+        [str(binary), '-t', '-d', str(MIHOMO_HOME), '-f', str(path)],
+        cwd=str(MIHOMO_HOME),
+        check=False,
+        capture_output=True,
+        text=True,
+        timeout=180,
+    )
+    output = f'{completed.stdout}\n{completed.stderr}'.strip()
+    if completed.returncode != 0:
+        raise common.BrowserctlError(
+            f'Mihomo rejected the configuration: {output}')
+    return {'ok': True, 'output': output}
+
+
+def _load_state() -> dict[str, Any] | None:
+    if not MIHOMO_STATE_FILE.exists():
+        return None
+    try:
+        value = json.loads(MIHOMO_STATE_FILE.read_text(encoding='utf-8'))
+    except (OSError, json.JSONDecodeError):
+        return None
+    return value if isinstance(value, dict) else None
+
+
+def _save_state(state: dict[str, Any]) -> None:
+    ensure_home()
+    MIHOMO_STATE_FILE.write_text(
+        json.dumps(state, ensure_ascii=False, indent=2), encoding='utf-8')
+
+
+def _clear_state() -> None:
+    try:
+        MIHOMO_STATE_FILE.unlink()
+    except FileNotFoundError:
+        pass
+
+
+def _api_url(path: str, settings: dict[str, Any] | None = None) -> str:
+    current = settings or load_settings()
+    if not path.startswith('/'):
+        path = f'/{path}'
+    return f'http://127.0.0.1:{current["controller_port"]}{path}'
+
+
+def api_request(path: str,
+                method: str = 'GET',
+                body: dict[str, Any] | None = None,
+                timeout: float = 10.0) -> Any:
+    settings = load_settings()
+    headers: dict[str, str] = {'User-Agent': USER_AGENT}
+    if settings['secret']:
+        headers['Authorization'] = f'Bearer {settings["secret"]}'
+    payload, _ = _request(
+        _api_url(path, settings),
+        method=method,
+        body=body,
+        headers=headers,
+        timeout=timeout,
+    )
+    if not payload:
+        return None
+    try:
+        return json.loads(payload.decode('utf-8'))
+    except (UnicodeDecodeError, json.JSONDecodeError):
+        return payload.decode('utf-8', errors='replace')
+
+
+def _controller_healthy() -> bool:
+    try:
+        result = api_request('/version', timeout=1.5)
+        return isinstance(result, dict) and bool(result.get('version'))
+    except Exception:
+        return False
+
+
+def _find_managed_pid() -> int:
+    if sys.platform != 'win32' or not MIHOMO_BINARY.exists():
+        return 0
+    expected = str(MIHOMO_BINARY.resolve()).replace("'", "''")
+    script = rf"""
+$process = Get-Process mihomo -ErrorAction SilentlyContinue |
+  Where-Object {{ $_.Path -eq '{expected}' }} |
+  Select-Object -First 1
+if ($process) {{ $process.Id }}
+"""
+    completed = subprocess.run(
+        ['powershell', '-NoProfile', '-Command', script],
+        check=False,
+        capture_output=True,
+        text=True,
+        timeout=10,
+    )
+    try:
+        return int(completed.stdout.strip())
+    except ValueError:
+        return 0
+
+
+def is_running() -> bool:
+    state = _load_state()
+    if (state and common.is_pid_running(state.get('pid')) and
+            _controller_healthy()):
+        return True
+    if not _controller_healthy():
+        return False
+    pid = _find_managed_pid()
+    if not pid:
+        return False
+    settings = load_settings()
+    _save_state({
+        'pid': pid,
+        'started_at': '',
+        'mixed_port': settings['mixed_port'],
+        'controller_port': settings['controller_port'],
+        'binary': str(MIHOMO_BINARY),
+        'adopted': True,
+    })
+    return True
+
+
+def _port_is_open(port: int) -> bool:
+    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
+        sock.settimeout(0.25)
+        return sock.connect_ex(('127.0.0.1', int(port))) == 0
+
+
+def _log_tail(max_lines: int = 20) -> str:
+    if not MIHOMO_LOG_FILE.exists():
+        return ''
+    try:
+        lines = MIHOMO_LOG_FILE.read_text(
+            encoding='utf-8', errors='replace').splitlines()
+    except OSError:
+        return ''
+    return '\n'.join(lines[-max_lines:])
+
+
+def _process_path(pid: int) -> str:
+    if sys.platform != 'win32':
+        return ''
+    script = (
+        f"(Get-Process -Id {int(pid)} -ErrorAction SilentlyContinue).Path")
+    completed = subprocess.run(
+        ['powershell', '-NoProfile', '-Command', script],
+        check=False,
+        capture_output=True,
+        text=True,
+        timeout=10,
+    )
+    return completed.stdout.strip()
+
+
+def stop() -> dict[str, Any]:
+    state = _load_state()
+    if not state and is_running():
+        state = _load_state()
+    if not state:
+        return {'ok': True, 'running': False}
+    pid = int(state.get('pid') or 0)
+    if not common.is_pid_running(pid):
+        _clear_state()
+        return {'ok': True, 'running': False}
+
+    healthy = _controller_healthy()
+    actual_path = _process_path(pid)
+    expected_path = str(MIHOMO_BINARY.resolve())
+    if not healthy and actual_path:
+        if str(Path(actual_path).resolve()).lower() != expected_path.lower():
+            _clear_state()
+            raise common.BrowserctlError(
+                'Refusing to stop a process that is not the managed Mihomo.')
+
+    try:
+        os.kill(pid, signal.SIGTERM)
+    except (OSError, PermissionError) as exc:
+        raise common.BrowserctlError(
+            f'Could not stop Mihomo process {pid}: {exc}') from exc
+
+    deadline = time.time() + 10.0
+    while time.time() < deadline and common.is_pid_running(pid):
+        time.sleep(0.2)
+    if common.is_pid_running(pid):
+        completed = subprocess.run(
+            ['taskkill', '/PID', str(pid), '/T', '/F'],
+            check=False,
+            capture_output=True,
+            text=True,
+            timeout=15,
+        )
+        if completed.returncode != 0 and common.is_pid_running(pid):
+            raise common.BrowserctlError(
+                f'Mihomo process {pid} did not stop: {completed.stderr}')
+    _clear_state()
+    return {'ok': True, 'running': False, 'pid': pid}
+
+
+def _start_command(settings: dict[str, Any]) -> list[str]:
+    command = [
+        str(MIHOMO_BINARY),
+        '-d',
+        str(MIHOMO_HOME),
+        '-f',
+        str(MIHOMO_PROFILE_FILE),
+        '-ext-ctl',
+        f'127.0.0.1:{settings["controller_port"]}',
+        '-secret',
+        settings['secret'],
+    ]
+    if (MIHOMO_UI_DIR / 'index.html').exists():
+        command.extend(['-ext-ui', str(MIHOMO_UI_DIR)])
+    return command
+
+
+def start(schedule_updates: bool = True) -> dict[str, Any]:
+    if is_running():
+        result = status()
+        if schedule_updates:
+            schedule_maintenance()
+        return result
+    if not MIHOMO_BINARY.exists():
+        raise common.BrowserctlError(
+            'Mihomo is not installed. Run `ccchrome proxy setup` first.')
+
+    ensure_profile()
+    validate_profile(MIHOMO_PROFILE_FILE)
+    settings = load_settings()
+    _clear_state()
+    for label, port in (
+            ('mixed proxy', settings['mixed_port']),
+            ('controller', settings['controller_port'])):
+        if _port_is_open(port):
+            raise common.BrowserctlError(
+                f'Mihomo {label} port {port} is already in use.')
+
+    creationflags = 0
+    if sys.platform == 'win32':
+        creationflags |= getattr(subprocess, 'CREATE_NEW_PROCESS_GROUP', 0)
+        creationflags |= getattr(subprocess, 'CREATE_NO_WINDOW', 0)
+    ensure_home()
+    with open(MIHOMO_LOG_FILE, 'ab') as log_file:
+        process = subprocess.Popen(
+            _start_command(settings),
+            cwd=str(MIHOMO_HOME),
+            stdout=log_file,
+            stderr=log_file,
+            creationflags=creationflags,
+        )
+    state = {
+        'pid': int(process.pid),
+        'started_at': _utc_now(),
+        'mixed_port': settings['mixed_port'],
+        'controller_port': settings['controller_port'],
+        'binary': str(MIHOMO_BINARY),
+    }
+    _save_state(state)
+
+    deadline = time.time() + 60.0
+    while time.time() < deadline:
+        if process.poll() is not None:
+            _clear_state()
+            raise common.BrowserctlError(
+                f'Mihomo exited during startup.\n{_log_tail()}')
+        if _controller_healthy():
+            result = status()
+            if schedule_updates:
+                schedule_maintenance()
+            return result
+        time.sleep(0.25)
+
+    stop()
+    raise common.BrowserctlError(
+        f'Mihomo did not become ready.\n{_log_tail()}')
+
+
+def ensure_running() -> dict[str, Any]:
+    return start(schedule_updates=True)
+
+
+def dashboard_url() -> str:
+    settings = load_settings()
+    return f'http://127.0.0.1:{settings["controller_port"]}/ui/'
+
+
+def _redact_source(source: str) -> str:
+    if not source:
+        return ''
+    parsed = urllib.parse.urlsplit(source)
+    if parsed.scheme not in ('http', 'https'):
+        return str(Path(source).name)
+    host = parsed.hostname or ''
+    port = f':{parsed.port}' if parsed.port else ''
+    return urllib.parse.urlunsplit(
+        (parsed.scheme, f'{host}{port}', parsed.path, '', ''))
+
+
+def status() -> dict[str, Any]:
+    settings = load_settings()
+    running = is_running()
+    state = _load_state()
+    api_version: Any = None
+    runtime_mode = ''
+    if running:
+        try:
+            api_version = api_request('/version', timeout=2.0)
+            runtime_config = api_request('/configs', timeout=2.0)
+            if isinstance(runtime_config, dict):
+                runtime_mode = str(runtime_config.get('mode') or '').lower()
+        except common.BrowserctlError:
+            api_version = None
+    return {
+        'installed': MIHOMO_BINARY.exists(),
+        'running': running,
+        'pid': state.get('pid') if running and state else None,
+        'version': settings['core_version'] or _binary_version(),
+        'api_version': api_version,
+        'mode': runtime_mode,
+        'mixed_port': settings['mixed_port'],
+        'controller_port': settings['controller_port'],
+        'dashboard_installed': (MIHOMO_UI_DIR / 'index.html').exists(),
+        'dashboard_version': settings['dashboard_version'],
+        'dashboard_url': dashboard_url(),
+        'auto_update': settings['auto_update'],
+        'update_interval_hours': settings['update_interval_hours'],
+        'subscription': {
+            'configured': bool(settings['subscription_source']),
+            'source': _redact_source(settings['subscription_source']),
+            'kind': settings['subscription_kind'],
+            'last_update': settings['last_subscription_update'],
+        },
+        'runtime_dir': str(MIHOMO_HOME),
+    }
+
+
+def update_core(force: bool = False) -> dict[str, Any]:
+    ensure_home()
+    release = _request_json(MIHOMO_RELEASE_API, timeout=30.0)
+    tag = str(release.get('tag_name') or '').lstrip('v')
+    if not tag:
+        raise common.BrowserctlError('Latest Mihomo release has no version.')
+    settings = update_settings(last_core_update_check=_utc_now())
+    current = _binary_version() if MIHOMO_BINARY.exists() else ''
+    if current == tag and not force:
+        if settings['core_version'] != tag:
+            update_settings(core_version=tag)
+        return {
+            'ok': True,
+            'updated': False,
+            'version': tag,
+            'message': 'Mihomo is already current.',
+        }
+
+    asset = _mihomo_asset(release)
+    was_running = is_running()
+    with tempfile.TemporaryDirectory(dir=str(MIHOMO_HOME)) as temp_dir_text:
+        temp_dir = Path(temp_dir_text)
+        archive = temp_dir / str(asset['name'])
+        candidate = temp_dir / 'mihomo.exe'
+        _download_asset(asset, archive)
+        _extract_mihomo(archive, candidate)
+        candidate_version = _binary_version(candidate)
+        if candidate_version != tag:
+            raise common.BrowserctlError(
+                f'Downloaded Mihomo version {candidate_version} != {tag}.')
+        if MIHOMO_PROFILE_FILE.exists():
+            validate_profile(MIHOMO_PROFILE_FILE, candidate)
+
+        if was_running:
+            stop()
+        try:
+            if MIHOMO_BACKUP_BINARY.exists():
+                MIHOMO_BACKUP_BINARY.unlink()
+            if MIHOMO_BINARY.exists():
+                MIHOMO_BINARY.replace(MIHOMO_BACKUP_BINARY)
+            candidate.replace(MIHOMO_BINARY)
+            if was_running:
+                start(schedule_updates=False)
+        except Exception as exc:
+            try:
+                if MIHOMO_BINARY.exists():
+                    MIHOMO_BINARY.unlink()
+                if MIHOMO_BACKUP_BINARY.exists():
+                    MIHOMO_BACKUP_BINARY.replace(MIHOMO_BINARY)
+                if was_running and MIHOMO_BINARY.exists():
+                    start(schedule_updates=False)
+            except Exception:
+                pass
+            raise common.BrowserctlError(
+                f'Mihomo update failed and was rolled back: {exc}') from exc
+
+    update_settings(core_version=tag)
+    return {
+        'ok': True,
+        'updated': True,
+        'previous_version': current,
+        'version': tag,
+        'asset': str(asset.get('name') or ''),
+        'restarted': was_running,
+    }
+
+
+def update_dashboard(force: bool = False) -> dict[str, Any]:
+    ensure_home()
+    release = _request_json(DASHBOARD_RELEASE_API, timeout=30.0)
+    tag = str(release.get('tag_name') or '').lstrip('v')
+    if not tag:
+        raise common.BrowserctlError('Latest dashboard release has no version.')
+    settings = update_settings(last_dashboard_update_check=_utc_now())
+    installed = (MIHOMO_UI_DIR / 'index.html').exists()
+    if installed and settings['dashboard_version'] == tag and not force:
+        return {
+            'ok': True,
+            'updated': False,
+            'version': tag,
+            'message': 'MetaCubeXD is already current.',
+        }
+
+    asset = _dashboard_asset(release)
+    with tempfile.TemporaryDirectory(dir=str(MIHOMO_HOME)) as temp_dir_text:
+        temp_dir = Path(temp_dir_text)
+        archive = temp_dir / 'dashboard.tgz'
+        extracted = temp_dir / 'ui'
+        extracted.mkdir()
+        _download_asset(asset, archive)
+        _safe_extract_dashboard(archive, extracted)
+        index_candidates = list(extracted.rglob('index.html'))
+        if len(index_candidates) != 1:
+            raise common.BrowserctlError(
+                'Dashboard archive did not contain one index.html.')
+        dashboard_root = index_candidates[0].parent
+        replacement = MIHOMO_HOME / 'ui.new'
+        if replacement.exists():
+            shutil.rmtree(replacement)
+        shutil.copytree(dashboard_root, replacement)
+        if MIHOMO_UI_DIR.exists():
+            shutil.rmtree(MIHOMO_UI_DIR)
+        replacement.replace(MIHOMO_UI_DIR)
+
+    update_settings(dashboard_version=tag)
+    return {
+        'ok': True,
+        'updated': True,
+        'version': tag,
+        'asset': str(asset.get('name') or ''),
+    }
+
+
+def set_subscription(source: str) -> dict[str, Any]:
+    ensure_home()
+    payload, kind = _read_profile_source(source)
+    parsed = _parse_profile(payload)
+    settings = load_settings()
+    profile = _managed_profile(parsed, settings)
+
+    with tempfile.TemporaryDirectory(dir=str(MIHOMO_HOME)) as temp_dir_text:
+        temp_dir = Path(temp_dir_text)
+        candidate = temp_dir / 'active.yaml'
+        _write_yaml(candidate, profile)
+        validate_profile(candidate)
+        was_running = is_running()
+        if was_running:
+            stop()
+        if MIHOMO_PROFILE_FILE.exists():
+            shutil.copy2(MIHOMO_PROFILE_FILE, MIHOMO_LAST_GOOD_PROFILE)
+        try:
+            MIHOMO_SUBSCRIPTION_FILE.write_bytes(payload)
+            shutil.copy2(candidate, MIHOMO_PROFILE_FILE)
+            if was_running:
+                start(schedule_updates=False)
+        except Exception as exc:
+            if MIHOMO_LAST_GOOD_PROFILE.exists():
+                shutil.copy2(MIHOMO_LAST_GOOD_PROFILE, MIHOMO_PROFILE_FILE)
+            if was_running:
+                try:
+                    start(schedule_updates=False)
+                except Exception:
+                    pass
+            raise common.BrowserctlError(
+                f'Subscription could not be applied and was rolled back: '
+                f'{exc}') from exc
+
+    update_settings(
+        subscription_source=source,
+        subscription_kind=kind,
+        last_subscription_update=_utc_now(),
+    )
+    return {
+        'ok': True,
+        'source': _redact_source(source),
+        'kind': kind,
+        'restarted': was_running,
+        'profile': str(MIHOMO_PROFILE_FILE),
+    }
+
+
+def refresh_subscription() -> dict[str, Any]:
+    settings = load_settings()
+    source = settings['subscription_source']
+    if not source:
+        raise common.BrowserctlError('No subscription has been configured.')
+    if settings['subscription_kind'] != 'url':
+        raise common.BrowserctlError(
+            'The active profile came from a local file and cannot auto-update.')
+    return set_subscription(source)
+
+
+def clear_subscription() -> dict[str, Any]:
+    ensure_home()
+    was_running = is_running()
+    if was_running:
+        stop()
+    settings = update_settings(
+        subscription_source='',
+        subscription_kind='',
+        last_subscription_update='',
+    )
+    if MIHOMO_PROFILE_FILE.exists():
+        shutil.copy2(MIHOMO_PROFILE_FILE, MIHOMO_LAST_GOOD_PROFILE)
+    _write_yaml(MIHOMO_PROFILE_FILE, _default_profile(settings))
+    try:
+        MIHOMO_SUBSCRIPTION_FILE.unlink()
+    except FileNotFoundError:
+        pass
+    validate_profile(MIHOMO_PROFILE_FILE)
+    if was_running:
+        start(schedule_updates=False)
+    return {
+        'ok': True,
+        'configured': False,
+        'restarted': was_running,
+    }
+
+
+def set_ports(mixed_port: int, controller_port: int) -> dict[str, Any]:
+    candidate_settings = load_settings()
+    candidate_settings.update({
+        'mixed_port': mixed_port,
+        'controller_port': controller_port,
+    })
+    candidate_settings = normalize_settings(candidate_settings)
+    if (candidate_settings['mixed_port'] ==
+            candidate_settings['controller_port']):
+        raise common.BrowserctlError(
+            'Mixed proxy and controller ports must be different.')
+    was_running = is_running()
+    if was_running:
+        stop()
+    settings = save_settings(candidate_settings)
+    if MIHOMO_SUBSCRIPTION_FILE.exists():
+        parsed = _parse_profile(MIHOMO_SUBSCRIPTION_FILE.read_bytes())
+        _write_yaml(MIHOMO_PROFILE_FILE,
+                    _managed_profile(parsed, settings))
+    else:
+        _write_yaml(MIHOMO_PROFILE_FILE, _default_profile(settings))
+    validate_profile(MIHOMO_PROFILE_FILE)
+    if was_running:
+        start(schedule_updates=False)
+    return {
+        'ok': True,
+        'mixed_port': settings['mixed_port'],
+        'controller_port': settings['controller_port'],
+        'restarted': was_running,
+    }
+
+
+def set_auto_update(enabled: bool,
+                    interval_hours: int | None = None) -> dict[str, Any]:
+    changes: dict[str, Any] = {'auto_update': enabled}
+    if interval_hours is not None:
+        changes['update_interval_hours'] = interval_hours
+        changes['subscription_update_interval_hours'] = interval_hours
+    settings = update_settings(**changes)
+    return {
+        'ok': True,
+        'auto_update': settings['auto_update'],
+        'interval_hours': settings['update_interval_hours'],
+    }
+
+
+def set_mode(mode: str) -> dict[str, Any]:
+    normalized = mode.lower()
+    if normalized not in ('rule', 'global', 'direct'):
+        raise common.BrowserctlError('Mode must be rule, global, or direct.')
+    ensure_running()
+    api_request('/configs', method='PATCH', body={'mode': normalized})
+    return {'ok': True, 'mode': normalized}
+
+
+def list_proxies() -> dict[str, Any]:
+    ensure_running()
+    payload = api_request('/proxies')
+    proxies = payload.get('proxies', {}) if isinstance(payload, dict) else {}
+    groups = []
+    for name, value in proxies.items():
+        if not isinstance(value, dict) or not isinstance(value.get('all'), list):
+            continue
+        groups.append({
+            'name': name,
+            'type': value.get('type'),
+            'now': value.get('now'),
+            'all': value.get('all'),
+        })
+    return {'groups': groups, 'count': len(groups)}
+
+
+def select_proxy(group: str, name: str) -> dict[str, Any]:
+    ensure_running()
+    path = f'/proxies/{urllib.parse.quote(group, safe="")}'
+    api_request(path, method='PUT', body={'name': name})
+    return {'ok': True, 'group': group, 'selected': name}
+
+
+def test_proxy(name: str,
+               test_url: str = 'https://www.gstatic.com/generate_204',
+               timeout_ms: int = 5000) -> dict[str, Any]:
+    ensure_running()
+    query = urllib.parse.urlencode({
+        'url': test_url,
+        'timeout': max(1000, int(timeout_ms)),
+    })
+    path = f'/proxies/{urllib.parse.quote(name, safe="")}/delay?{query}'
+    result = api_request(path, timeout=max(10.0, timeout_ms / 1000 + 5))
+    return {'name': name, 'result': result}
+
+
+def setup(source: str = '') -> dict[str, Any]:
+    core = update_core()
+    dashboard = update_dashboard()
+    if source:
+        subscription = set_subscription(source)
+    else:
+        ensure_profile()
+        validate_profile(MIHOMO_PROFILE_FILE)
+        subscription = {
+            'ok': True,
+            'configured': bool(load_settings()['subscription_source']),
+        }
+    runtime = start(schedule_updates=False)
+    return {
+        'ok': True,
+        'core': core,
+        'dashboard': dashboard,
+        'subscription': subscription,
+        'runtime': runtime,
+    }
+
+
+class _MaintenanceLock:
+    def __enter__(self) -> '_MaintenanceLock':
+        ensure_home()
+        if MIHOMO_LOCK_FILE.exists():
+            age = time.time() - MIHOMO_LOCK_FILE.stat().st_mtime
+            if age < 30 * 60:
+                raise common.BrowserctlError('Maintenance is already running.')
+            MIHOMO_LOCK_FILE.unlink()
+        try:
+            descriptor = os.open(
+                MIHOMO_LOCK_FILE,
+                os.O_CREAT | os.O_EXCL | os.O_WRONLY,
+            )
+        except FileExistsError as exc:
+            raise common.BrowserctlError(
+                'Maintenance is already running.') from exc
+        with os.fdopen(descriptor, 'w', encoding='utf-8') as lock_file:
+            lock_file.write(f'{os.getpid()}\n{_utc_now()}\n')
+        return self
+
+    def __exit__(self, exc_type: Any, exc: Any, traceback: Any) -> None:
+        try:
+            MIHOMO_LOCK_FILE.unlink()
+        except FileNotFoundError:
+            pass
+
+
+def maintain() -> dict[str, Any]:
+    results: dict[str, Any] = {'ok': True}
+    with _MaintenanceLock():
+        settings = load_settings()
+        if not settings['auto_update']:
+            return {'ok': True, 'skipped': 'auto update is disabled'}
+        if (settings['subscription_source'] and
+                settings['subscription_kind'] == 'url' and
+                _is_due(
+                    settings['last_subscription_update'],
+                    settings['subscription_update_interval_hours'])):
+            results['subscription'] = refresh_subscription()
+        settings = load_settings()
+        if _is_due(settings['last_core_update_check'],
+                   settings['update_interval_hours']):
+            results['core'] = update_core()
+        settings = load_settings()
+        if _is_due(settings['last_dashboard_update_check'],
+                   settings['update_interval_hours']):
+            results['dashboard'] = update_dashboard()
+    return results
+
+
+def schedule_maintenance() -> None:
+    settings = load_settings()
+    if not settings['auto_update']:
+        return
+    due = _is_due(settings['last_core_update_check'],
+                  settings['update_interval_hours'])
+    due = due or _is_due(settings['last_dashboard_update_check'],
+                        settings['update_interval_hours'])
+    if (settings['subscription_source'] and
+            settings['subscription_kind'] == 'url'):
+        due = due or _is_due(
+            settings['last_subscription_update'],
+            settings['subscription_update_interval_hours'])
+    if not due or MIHOMO_LOCK_FILE.exists():
+        return
+    creationflags = 0
+    if sys.platform == 'win32':
+        creationflags |= getattr(subprocess, 'CREATE_NO_WINDOW', 0)
+        creationflags |= getattr(subprocess, 'CREATE_NEW_PROCESS_GROUP', 0)
+    with open(MIHOMO_LOG_FILE, 'ab') as log_file:
+        subprocess.Popen(
+            [sys.executable, str(Path(__file__).resolve()), 'maintain'],
+            cwd=str(common.REPO_ROOT),
+            stdout=log_file,
+            stderr=log_file,
+            creationflags=creationflags,
+        )
+
+
+def _main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('command', choices=('maintain',))
+    args = parser.parse_args()
+    try:
+        if args.command == 'maintain':
+            print(json.dumps(maintain(), ensure_ascii=False))
+        return 0
+    except common.BrowserctlError as exc:
+        print(json.dumps({'error': str(exc)}, ensure_ascii=False))
+        return 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(_main())
