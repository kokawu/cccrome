+  <script>
+    'use strict';
+
+    const token = new URLSearchParams(location.search).get('token') || '';
+    const state = { status: null, groups: [] };
+    let toastTimer = 0;
+
+    const elements = {
+      statusDot: document.querySelector('#statusDot'),
+      statusText: document.querySelector('#statusText'),
+      coreVersion: document.querySelector('#coreVersion'),
+      dashboardVersion: document.querySelector('#dashboardVersion'),
+      mixedPort: document.querySelector('#mixedPort'),
+      controllerPort: document.querySelector('#controllerPort'),
+      advancedLink: document.querySelector('#advancedLink'),
+      subscriptionForm: document.querySelector('#subscriptionForm'),
+      subscriptionSource: document.querySelector('#subscriptionSource'),
+      subscriptionState: document.querySelector('#subscriptionState'),
+      subscriptionUpdated: document.querySelector('#subscriptionUpdated'),
+      importButton: document.querySelector('#importButton'),
+      refreshButton: document.querySelector('#refreshButton'),
+      clearButton: document.querySelector('#clearButton'),
+      updateCoreButton: document.querySelector('#updateCoreButton'),
+      intervalHours: document.querySelector('#intervalHours'),
+      autoUpdate: document.querySelector('#autoUpdate'),
+      modeControl: document.querySelector('#modeControl'),
+      groups: document.querySelector('#groups'),
+      reloadNodesButton: document.querySelector('#reloadNodesButton'),
+      toast: document.querySelector('#toast'),
+    };
+
+    async function api(path, options = {}) {
+      const response = await fetch(`/proxy/api/${path}`, {
+        ...options,
+        headers: {
+          'Content-Type': 'application/json',
+          'X-Browserctl-Token': token,
+          ...(options.headers || {}),
+        },
+      });
+      const payload = await response.json();
+      if (!response.ok || payload.error) {
+        throw new Error(payload.error || `请求失败：${response.status}`);
+      }
+      return payload;
+    }
+
+    function notify(message, isError = false) {
+      window.clearTimeout(toastTimer);
+      elements.toast.textContent = message;
+      elements.toast.classList.toggle('error', isError);
+      elements.toast.classList.add('show');
+      toastTimer = window.setTimeout(() => {
+        elements.toast.classList.remove('show');
+      }, 4200);
+    }
+
+    async function busy(button, label, task) {
+      const previous = button.textContent;
+      button.disabled = true;
+      button.textContent = label;
+      try {
+        return await task();
+      } finally {
+        button.disabled = false;
+        button.textContent = previous;
+      }
+    }
+
+    function formatTime(value) {
+      if (!value) return '';
+      const date = new Date(value);
+      if (Number.isNaN(date.getTime())) return value;
+      return date.toLocaleString('zh-CN', { hour12: false });
+    }
+
+    function renderStatus(status) {
+      state.status = status;
+      elements.statusDot.classList.toggle('running', Boolean(status.running));
+      elements.statusText.textContent = status.running ? '内核运行中' : '内核已停止';
+      elements.coreVersion.textContent = status.version || '未安装';
+      elements.dashboardVersion.textContent = status.dashboard_version || '未安装';
+      elements.mixedPort.textContent = String(status.mixed_port || '-');
+      elements.controllerPort.textContent = String(status.controller_port || '-');
+      elements.advancedLink.href = status.dashboard_url || '#';
+      elements.autoUpdate.checked = Boolean(status.auto_update);
+      elements.intervalHours.value = String(status.update_interval_hours || 24);
+
+      const subscription = status.subscription || {};
+      elements.subscriptionState.textContent = subscription.configured
+        ? subscription.source || '已导入'
+        : '未导入';
+      elements.subscriptionUpdated.textContent = subscription.last_update
+        ? `更新于 ${formatTime(subscription.last_update)}`
+        : '';
+      elements.refreshButton.disabled = subscription.kind !== 'url';
+      elements.clearButton.disabled = !subscription.configured;
+
+      for (const button of elements.modeControl.querySelectorAll('button')) {
+        button.classList.toggle('active', button.dataset.mode === status.mode);
+      }
+    }
+
+    function nodeOption(name, selected) {
+      const option = document.createElement('option');
+      option.value = name;
+      option.textContent = name;
+      option.selected = name === selected;
+      return option;
+    }
+
+    function renderGroups(payload) {
+      state.groups = payload.groups || [];
+      elements.groups.replaceChildren();
+      if (!state.groups.length) {
+        const empty = document.createElement('div');
+        empty.className = 'empty';
+        empty.textContent = '没有可选择的代理组';
+        elements.groups.append(empty);
+        return;
+      }
+
+      for (const group of state.groups) {
+        const container = document.createElement('article');
+        container.className = 'group';
+
+        const head = document.createElement('div');
+        head.className = 'group-head';
+        const name = document.createElement('span');
+        name.className = 'group-name';
+        name.textContent = group.name;
+        name.title = group.name;
+        const type = document.createElement('span');
+        type.className = 'group-type';
+        type.textContent = group.type || '';
+        head.append(name, type);
+
+        const controls = document.createElement('div');
+        controls.className = 'group-controls';
+        const select = document.createElement('select');
+        select.setAttribute('aria-label', `${group.name} 节点`);
+        for (const item of group.all || []) {
+          select.append(nodeOption(item, group.now));
+        }
+        const apply = document.createElement('button');
+        apply.type = 'button';
+        apply.textContent = '选择';
+        apply.disabled = String(group.type || '').toLowerCase() !== 'selector';
+        const test = document.createElement('button');
+        test.type = 'button';
+        test.textContent = '测速';
+        controls.append(select, apply, test);
+
+        const result = document.createElement('div');
+        result.className = 'group-result';
+        result.textContent = group.now ? `当前：${group.now}` : '';
+
+        apply.addEventListener('click', async () => {
+          await busy(apply, '应用中', async () => {
+            try {
+              await api('select', {
+                method: 'POST',
+                body: JSON.stringify({ group: group.name, node: select.value }),
+              });
+              result.textContent = `当前：${select.value}`;
+              notify(`已切换到 ${select.value}`);
+            } catch (error) {
+              notify(error.message, true);
+            }
+          });
+        });
+
+        test.addEventListener('click', async () => {
+          await busy(test, '测速中', async () => {
+            try {
+              const response = await api('test', {
+                method: 'POST',
+                body: JSON.stringify({ node: select.value, timeout: 5000 }),
+              });
+              const delay = response.result && response.result.delay;
+              result.textContent = Number.isFinite(delay)
+                ? `${select.value}：${delay} ms`
+                : `${select.value}：无响应`;
+            } catch (error) {
+              result.textContent = `${select.value}：测速失败`;
+              notify(error.message, true);
+            }
+          });
+        });
+
+        container.append(head, controls, result);
+        elements.groups.append(container);
+      }
+    }
+
+    async function reload() {
+      try {
+        const [status, groups] = await Promise.all([
+          api('status'),
+          api('nodes'),
+        ]);
+        renderStatus(status);
+        renderGroups(groups);
+      } catch (error) {
+        notify(error.message, true);
+      }
+    }
+
+    elements.subscriptionForm.addEventListener('submit', async event => {
+      event.preventDefault();
+      const source = elements.subscriptionSource.value.trim();
+      if (!source) {
+        notify('请输入订阅链接或 YAML 路径', true);
+        return;
+      }
+      await busy(elements.importButton, '导入中', async () => {
+        try {
+          await api('subscription/set', {
+            method: 'POST',
+            body: JSON.stringify({ source }),
+          });
+          elements.subscriptionSource.value = '';
+          notify('订阅已导入');
+          await reload();
+        } catch (error) {
+          notify(error.message, true);
+        }
+      });
+    });
+
+    elements.refreshButton.addEventListener('click', async () => {
+      await busy(elements.refreshButton, '更新中', async () => {
+        try {
+          await api('subscription/update', { method: 'POST', body: '{}' });
+          notify('订阅已更新');
+          await reload();
+        } catch (error) {
+          notify(error.message, true);
+        }
+      });
+    });
+
+    elements.clearButton.addEventListener('click', async () => {
+      await busy(elements.clearButton, '清除中', async () => {
+        try {
+          await api('subscription/clear', { method: 'POST', body: '{}' });
+          notify('订阅已清除');
+          await reload();
+        } catch (error) {
+          notify(error.message, true);
+        }
+      });
+    });
+
+    elements.updateCoreButton.addEventListener('click', async () => {
+      await busy(elements.updateCoreButton, '检查中', async () => {
+        try {
+          const result = await api('core/update', {
+            method: 'POST',
+            body: '{}',
+          });
+          const changed = result.core.updated || result.dashboard.updated;
+          notify(changed ? '内核和面板已更新' : '已经是最新版本');
+          await reload();
+        } catch (error) {
+          notify(error.message, true);
+        }
+      });
+    });
+
+    elements.autoUpdate.addEventListener('change', async () => {
+      try {
+        const interval = Math.max(1, Number(elements.intervalHours.value) || 24);
+        await api('auto-update', {
+          method: 'POST',
+          body: JSON.stringify({
+            enabled: elements.autoUpdate.checked,
+            interval_hours: interval,
+          }),
+        });
+        notify(elements.autoUpdate.checked ? '自动更新已开启' : '自动更新已关闭');
+      } catch (error) {
+        elements.autoUpdate.checked = !elements.autoUpdate.checked;
+        notify(error.message, true);
+      }
+    });
+
+    elements.intervalHours.addEventListener('change', async () => {
+      const interval = Math.max(1, Number(elements.intervalHours.value) || 24);
+      elements.intervalHours.value = String(interval);
+      try {
+        await api('auto-update', {
+          method: 'POST',
+          body: JSON.stringify({
+            enabled: elements.autoUpdate.checked,
+            interval_hours: interval,
+          }),
+        });
+        notify('检查间隔已保存');
+      } catch (error) {
+        notify(error.message, true);
+      }
+    });
+
+    elements.modeControl.addEventListener('click', async event => {
+      const button = event.target.closest('button[data-mode]');
+      if (!button) return;
+      await busy(button, '切换中', async () => {
+        try {
+          await api('mode', {
+            method: 'POST',
+            body: JSON.stringify({ mode: button.dataset.mode }),
+          });
+          for (const item of elements.modeControl.querySelectorAll('button')) {
+            item.classList.toggle('active', item === button);
+          }
+          notify(`已切换到${button.textContent}模式`);
+        } catch (error) {
+          notify(error.message, true);
+        }
+      });
+    });
+
+    elements.reloadNodesButton.addEventListener('click', async () => {
+      await busy(elements.reloadNodesButton, '刷新中', async () => {
+        try {
+          renderGroups(await api('nodes'));
+        } catch (error) {
+          notify(error.message, true);
+        }
+      });
+    });
+
+    reload();
+  </script>
+</body>
+</html>
