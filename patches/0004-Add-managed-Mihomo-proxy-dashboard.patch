+
+from __future__ import annotations
+
+import os
+import sys
+import unittest
+from pathlib import Path
+from unittest import mock
+
+SCRIPT_DIR = Path(__file__).resolve().parent
+sys.path.insert(0, str(SCRIPT_DIR))
+
+import common
+import mihomo
+
+
+class MihomoSettingsTest(unittest.TestCase):
+    def test_normalize_settings_repairs_invalid_values(self) -> None:
+        settings = mihomo.normalize_settings({
+            'mixed_port': 'bad',
+            'controller_port': 70000,
+            'update_interval_hours': 0,
